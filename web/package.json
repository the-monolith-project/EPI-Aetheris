{
  "name": "aetheris-web",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint \"src/**/*.{astro,js,ts}\" \"tests/**/*.{js,ts}\" \"*.{js,mjs,ts}\"",
    "format": "prettier --write \"src/**/*.{astro,js,ts,css}\" \"tests/**/*.{js,ts}\" \"*.{js,mjs,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,js,ts,css}\" \"tests/**/*.{js,ts}\" \"*.{js,mjs,ts,json}\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@observablehq/plot": "^0.6.17",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.0",
    "chroma-js": "^3.2.0",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/chroma-js": "^3.1.2",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.68.0"
  }
}
