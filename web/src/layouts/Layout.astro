---
import '../styles/global.css';

interface Props {
  title?: string;
  descripcion?: string;
}

const {
  title = 'EPI-Aetheris',
  descripcion = 'Vigilancia epidemiológica descriptiva de dengue e IRA en El Salvador -- datos públicos, software libre y reproducible. No es un diagnóstico ni un pronóstico.',
} = Astro.props;

// API pública real -- FastAPI genera /docs (Swagger UI) gratis a partir de
// los mismos endpoints que consume este frontend. Enlazarlo desde el
// footer refuerza "aporte de ingeniería reproducible" sin escribir nada
// nuevo en el backend.
const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';

const ruta = Astro.url.pathname;
const NAV = [
  { href: '/', etiqueta: 'Inicio' },
  { href: '/panel', etiqueta: 'Dengue' },
  // Sección aparte del panel de dengue: otro evento (ADR 0011, aceptado
  // 2026-08-22), ya cargado, pero sin capas Camino Ancho (Iv/anomalía/
  // presión) -- esas fórmulas siguen cerradas solo para dengue.
  { href: '/ira', etiqueta: 'IRA' },
  // Selección curada de docs/ y docs/adr/ del repo, renderizada a HTML --
  // ver web/src/content.config.ts para qué documentos entran y por qué.
  { href: '/biblioteca', etiqueta: 'Biblioteca' },
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:site_name" content="EPI-Aetheris" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={descripcion} />
  </head>
  <body class="min-h-screen bg-bg text-ink">
    <header
      class="sticky top-0 z-40 bg-accent shadow-[0_1px_0_rgba(255,255,255,0.06)]"
    >
      <div
        class="mx-auto flex max-w-[1600px] items-center justify-between gap-4 px-4 py-3 sm:px-8 lg:px-12"
      >
        <a href="/" class="flex items-center gap-3">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-secondary font-sans text-sm font-bold text-secondary-ink"
          >
            EA
          </span>
          <div class="leading-tight">
            <p class="font-sans text-sm font-semibold tracking-wide text-white">
              EPI-Aetheris
            </p>
            <p class="font-sans text-xs text-white/60">
              Vigilancia de dengue &middot; El Salvador
            </p>
          </div>
        </a>

        <nav
          class="flex items-center gap-1 font-sans text-sm"
          aria-label="Navegación principal"
        >
          {
            NAV.map((item) => {
              const activo =
                item.href === '/' ? ruta === '/' : ruta.startsWith(item.href);
              return (
                <a
                  href={item.href}
                  aria-current={activo ? 'page' : undefined}
                  class:list={[
                    'rounded-full px-3.5 py-1.5 font-medium transition-colors',
                    activo
                      ? 'bg-white/15 text-white'
                      : 'text-white/70 hover:bg-white/10 hover:text-white',
                  ]}
                >
                  {item.etiqueta}
                </a>
              );
            })
          }
        </nav>

        <span
          class="hidden shrink-0 rounded-full border border-white/15 bg-white/5 px-3 py-1 font-sans text-[11px] font-medium uppercase tracking-wide text-white/80 lg:inline-block"
        >
          Camino Ancho &middot; descriptivo, no predictivo
        </span>
      </div>
    </header>

    <slot />

    <footer class="mt-12 bg-deep">
      <div class="mx-auto max-w-[1600px] px-4 py-6 sm:px-8 lg:px-12">
        <p class="font-sans text-xs leading-relaxed text-deep-ink-muted">
          Datos públicos agregados (MINSAL, OpenDengue, Open-Meteo) &middot;
          software libre y reproducible. Este panel es una ayuda de
          priorización, no un diagnóstico ni un pronóstico -- ninguna capa
          asigna un nivel de riesgo departamental.
        </p>
        <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-sans text-xs">
          <a
            href={`${API_BASE}/docs`}
            class="text-deep-ink underline underline-offset-2 hover:text-white"
          >
            API pública (Swagger)
          </a>
          <a
            href="https://github.com/the-monolith-project/EPI-Aetheris"
            class="text-deep-ink underline underline-offset-2 hover:text-white"
          >
            Código en GitHub
          </a>
        </div>
        <p
          class="mt-4 font-sans text-[11px] uppercase tracking-wide text-deep-ink-muted"
        >
          Fuentes
        </p>
        <div class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1 font-sans text-xs">
          <a
            href="https://www.salud.gob.sv/category/publicaciones/informes-de-vigilancia-sanitaria/"
            class="text-deep-ink-muted underline underline-offset-2 hover:text-white"
          >
            MINSAL -- boletines de vigilancia
          </a>
          <a
            href="https://opendengue.org/"
            class="text-deep-ink-muted underline underline-offset-2 hover:text-white"
          >
            OpenDengue
          </a>
          <a
            href="https://open-meteo.com/en/license"
            class="text-deep-ink-muted underline underline-offset-2 hover:text-white"
          >
            Open-Meteo (CC BY 4.0)
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
