---
import PanelWorkspace from './analisis/PanelWorkspace.astro';
import CargadorCurva from './CargadorCurva.astro';
import { ANIOS_RESPIRATORIO } from '../lib/respiratorio-state';
interface Props {
  evento?: 'ira' | 'neumonias';
  /**
   * Código de departamento fijo (p. ej. en /departamento/[codigo]). Con él se
   * oculta el selector y el componente no lee ni escribe el estado compartido.
   */
  departamento?: string;
}
const evento = Astro.props.evento ?? 'ira';
const departamentoFijo = Astro.props.departamento;
const etiqueta = evento === 'neumonias' ? 'Neumonías' : 'IRA';
const apiBase = evento === 'neumonias' ? '/api/neumonias' : '/api/ira';
---

<PanelWorkspace
  tipo="traza"
  titulo={`Casos semanales de ${etiqueta} por departamento`}
  descripcion="Serie desacumulada de los boletines MINSAL (la fuente publica acumulados desde SE1). Unidad: conteo notificado. Un año por línea; los huecos se dejan vacíos, no se interpolan."
  data-curva-evento={evento}
  data-curva-api={apiBase}
  data-curva-departamento={departamentoFijo}
  controlesAnchos
>
  <div
    slot="controles"
    class="flex flex-wrap items-center gap-2 font-sans text-sm text-ink-muted"
  >
    <label
      class:list={[
        'flex flex-wrap items-center gap-2',
        { hidden: departamentoFijo },
      ]}
      >Departamento
      <select
        data-curva-depto
        class="rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-sm text-ink"
      ></select>
    </label>
    <label class="flex flex-wrap items-center gap-2"
      >Año
      <select
        data-curva-anio
        class="rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-sm text-ink"
      >
        <option value="todos">todos (comparar temporadas)</option>
        {ANIOS_RESPIRATORIO.map((a) => <option value={String(a)}>{a}</option>)}
      </select>
    </label>
    <label class="flex flex-wrap items-center gap-2"
      >Comparar con
      <select
        data-curva-compare
        class="rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-sm text-ink"
      >
        <option value="">(ningún otro departamento)</option>
      </select>
    </label>
    <label class="flex flex-wrap items-center gap-2"
      >SE
      <input
        data-curva-desde
        type="range"
        min="1"
        max="52"
        value="1"
        aria-label="Semana epidemiológica inicial"
        aria-valuetext="Semana epidemiológica 1"
      />
      <input
        data-curva-hasta
        type="range"
        min="1"
        max="52"
        value="52"
        aria-label="Semana epidemiológica final"
        aria-valuetext="Semana epidemiológica 52"
      />
      <span data-curva-rango class="font-sans tabular-nums text-xs"
        >SE1–SE52</span
      >
    </label>
    <button
      type="button"
      data-curva-export
      aria-label={`Exportar datos de ${etiqueta} a CSV`}
      disabled
      class="rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-xs font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:cursor-not-allowed disabled:opacity-50"
    >
      Exportar CSV
    </button>
  </div>

  <div
    data-curva-canvas
    class="mt-4 rounded-xl border border-border bg-bg p-3 transition-opacity sm:p-4"
    role="status"
  >
    <div data-estado aria-hidden="true">
      <CargadorCurva
        class="h-40 w-full justify-center sm:h-52"
        texto="Cargando la curva…"
      />
    </div>
  </div>
</PanelWorkspace>

<script>
  import type {
    DepartamentoIRA,
    RespuestaIraDepartamental,
  } from '../lib/tipos-analisis';
  import { colorCualitativo } from '../lib/colores';
  import {
    actualizarFiltrosRespiratorio,
    obtenerFiltrosRespiratorio,
    suscribirFiltrosRespiratorio,
    type FiltrosRespiratorio,
  } from '../lib/respiratorio-state';
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderSinDato,
  } from './estado-async';

  // [semana, valor|null]
  type Punto = [number, number | null];

  interface RespuestaTemporal {
    departamento_codigo: string;
    departamento_nombre: string;
    anios: number[];
    series: Record<string, [number, number][]>;
    aviso: string;
  }

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const ANCHO = 720;
  const ALTO = 260;
  const MARGEN = { arriba: 20, abajo: 40, izquierda: 44, derecha: 8 };

  function recortar(
    series: Record<string, Punto[]>,
    desde: number,
    hasta: number,
  ): Record<string, Punto[]> {
    const out: Record<string, Punto[]> = {};
    for (const anio of Object.keys(series)) {
      out[anio] = (series[anio] ?? []).filter(
        ([s]) => s >= desde && s <= hasta,
      );
    }
    return out;
  }

  function dibujar(
    contenedor: HTMLElement,
    capas: {
      nombre: string;
      series: Record<string, Punto[]>;
      dashed?: boolean;
    }[],
    desde: number,
    hasta: number,
  ) {
    contenedor.innerHTML = '';

    const series = capas[0]?.series ?? {};
    const anios = Object.keys(series).sort();
    const valores = capas.flatMap((c) =>
      Object.values(c.series).flatMap((pts) =>
        pts.map((p) => p[1]).filter((v) => v !== null),
      ),
    );
    if (valores.length === 0) {
      renderSinDato(
        contenedor,
        'Sin puntos con dato para este departamento en el rango elegido.',
      );
      return;
    }
    const maxValor = Math.max(...(valores as number[]));
    const areaGrafica = ALTO - MARGEN.arriba - MARGEN.abajo;
    const escalaY = (v: number) =>
      ALTO - MARGEN.abajo - (v / (maxValor || 1)) * areaGrafica;
    const anchoSe = Math.max(1, hasta - desde);
    const escalaX = (semana: number) =>
      MARGEN.izquierda +
      ((semana - desde) / anchoSe) *
        (ANCHO - MARGEN.izquierda - MARGEN.derecha);

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${ANCHO} ${ALTO}`);
    svg.setAttribute('class', 'w-full');
    svg.setAttribute('role', 'img');
    svg.setAttribute(
      'aria-label',
      `Casos semanales notificados ${capas.map((c) => c.nombre).join(' y ')}, SE${desde}–SE${hasta}`,
    );
    const numeros = valores as number[];
    const totalCasos = numeros.reduce((suma, v) => suma + v, 0);
    const descSvg = document.createElementNS(SVG_NS, 'desc');
    descSvg.textContent = `Entre la semana epidemiológica ${desde} y la ${hasta}, el valor máximo notificado en cualquier semana fue ${Math.max(...numeros).toLocaleString('es-SV')} y el total acumulado en el rango fue ${totalCasos.toLocaleString('es-SV')}.`;
    svg.appendChild(descSvg);

    for (const nivel of [0, maxValor / 2, maxValor]) {
      const y = escalaY(nivel);
      const linea = document.createElementNS(SVG_NS, 'line');
      linea.setAttribute('x1', String(MARGEN.izquierda));
      linea.setAttribute('x2', String(ANCHO - MARGEN.derecha));
      linea.setAttribute('y1', String(y));
      linea.setAttribute('y2', String(y));
      linea.setAttribute('stroke', 'var(--color-border)');
      linea.setAttribute('stroke-width', '1');
      svg.appendChild(linea);

      const etiqueta = document.createElementNS(SVG_NS, 'text');
      etiqueta.setAttribute('x', String(MARGEN.izquierda - 8));
      etiqueta.setAttribute('y', String(y + 3));
      etiqueta.setAttribute('text-anchor', 'end');
      etiqueta.setAttribute('font-family', 'var(--font-sans)');
      etiqueta.style.fontVariantNumeric = 'tabular-nums';
      etiqueta.setAttribute('font-size', '9');
      etiqueta.setAttribute('fill', 'var(--color-ink-muted)');
      etiqueta.textContent = Math.round(nivel).toLocaleString('es-SV');
      svg.appendChild(etiqueta);
    }

    const marcas = [desde, Math.round((desde + hasta) / 2), hasta];
    for (const semana of marcas) {
      const etiqueta = document.createElementNS(SVG_NS, 'text');
      etiqueta.setAttribute('x', String(escalaX(semana)));
      etiqueta.setAttribute('y', String(ALTO - 24));
      etiqueta.setAttribute('text-anchor', 'middle');
      etiqueta.setAttribute('font-family', 'var(--font-sans)');
      etiqueta.style.fontVariantNumeric = 'tabular-nums';
      etiqueta.setAttribute('font-size', '9');
      etiqueta.setAttribute('fill', 'var(--color-ink-muted)');
      etiqueta.textContent = `SE${semana}`;
      svg.appendChild(etiqueta);
    }

    for (const capa of capas) {
      const aniosCapa = Object.keys(capa.series).sort();
      for (const anio of aniosCapa) {
        let d = '';
        let enTramo = false;
        for (const [semana, valor] of capa.series[anio]) {
          if (valor === null) {
            enTramo = false;
            continue;
          }
          d += `${enTramo ? 'L' : 'M'}${escalaX(semana).toFixed(1)},${escalaY(valor).toFixed(1)} `;
          enTramo = true;
        }
        if (!d) continue;
        const trazo = document.createElementNS(SVG_NS, 'path');
        trazo.setAttribute('d', d.trim());
        trazo.setAttribute('fill', 'none');
        trazo.setAttribute('stroke', colorCualitativo(anios.indexOf(anio)));
        trazo.setAttribute(
          'stroke-width',
          anio === aniosCapa[aniosCapa.length - 1] ? '2' : '1.5',
        );
        if (capa.dashed) trazo.setAttribute('stroke-dasharray', '4 3');
        trazo.setAttribute('stroke-linejoin', 'round');
        trazo.setAttribute('stroke-linecap', 'round');
        svg.appendChild(trazo);
      }
    }

    // Leyenda de años sobre la línea base inferior.
    let x = MARGEN.izquierda;
    for (const anio of anios) {
      const muestra = document.createElementNS(SVG_NS, 'line');
      muestra.setAttribute('x1', String(x));
      muestra.setAttribute('x2', String(x + 14));
      muestra.setAttribute('y1', String(ALTO - 8));
      muestra.setAttribute('y2', String(ALTO - 8));
      muestra.setAttribute('stroke', colorCualitativo(anios.indexOf(anio)));
      muestra.setAttribute('stroke-width', '2');
      svg.appendChild(muestra);
      const texto = document.createElementNS(SVG_NS, 'text');
      texto.setAttribute('x', String(x + 18));
      texto.setAttribute('y', String(ALTO - 5));
      texto.setAttribute('font-family', 'var(--font-sans)');
      texto.style.fontVariantNumeric = 'tabular-nums';
      texto.setAttribute('font-size', '10');
      texto.setAttribute('fill', 'var(--color-ink-muted)');
      texto.textContent = anio;
      svg.appendChild(texto);
      x += 60;
    }

    contenedor.appendChild(svg);

    // Nota de huecos: cuántas semanas por año quedaron sin dato, y por qué
    // tipo (hueco entre cortes vs corrección retroactiva excluida).
    const resumen = anios
      .map((a) => {
        const sinDato = series[a].filter((p) => p[1] === null).length;
        return sinDato > 0 ? `${a}: ${sinDato} semanas sin dato` : null;
      })
      .filter(Boolean)
      .join(' · ');
    if (resumen) {
      const p = document.createElement('p');
      p.className = 'mt-2 font-sans text-xs text-ink-muted';
      p.textContent = `Huecos (no interpolados) -- ${resumen}`;
      contenedor.appendChild(p);
    }
  }

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';

  async function cargarTemporal(
    apiBase: string,
    codigo: string,
  ): Promise<Record<string, Punto[]>> {
    const resp = await fetch(`${API_BASE}${apiBase}/temporal/${codigo}`);
    if (!resp.ok) throw new Error('respuesta no OK');
    const datos = await resp.json();
    if (esNoDisponible(datos)) {
      throw Object.assign(new Error(motivoNoDisponible(datos)), {
        noDisponible: true,
        motivo: motivoNoDisponible(datos),
      });
    }
    const cuerpo = datos as RespuestaTemporal;
    const series: Record<string, Punto[]> = {};
    for (const anio of cuerpo.anios) {
      series[String(anio)] = cuerpo.series[String(anio)] ?? [];
    }
    return series;
  }

  async function iniciarSeccion(seccion: HTMLElement) {
    const apiBase = seccion.dataset.curvaApi ?? '/api/ira';
    const contenedor = seccion.querySelector(
      '[data-curva-canvas]',
    ) as HTMLElement | null;
    const selector = seccion.querySelector(
      '[data-curva-depto]',
    ) as HTMLSelectElement | null;
    const selAnio = seccion.querySelector(
      '[data-curva-anio]',
    ) as HTMLSelectElement | null;
    const selCompare = seccion.querySelector(
      '[data-curva-compare]',
    ) as HTMLSelectElement | null;
    const inpDesde = seccion.querySelector(
      '[data-curva-desde]',
    ) as HTMLInputElement | null;
    const inpHasta = seccion.querySelector(
      '[data-curva-hasta]',
    ) as HTMLInputElement | null;
    const txtRango = seccion.querySelector(
      '[data-curva-rango]',
    ) as HTMLElement | null;
    const btnExport = seccion.querySelector(
      '[data-curva-export]',
    ) as HTMLButtonElement | null;
    if (
      !contenedor ||
      !selector ||
      !selAnio ||
      !selCompare ||
      !inpDesde ||
      !inpHasta ||
      !txtRango
    )
      return;
    let ultimoCsv = '';

    let departamentos: DepartamentoIRA[];
    try {
      const resp = await fetch(`${API_BASE}${apiBase}/departamental`);
      if (!resp.ok) throw new Error('respuesta no OK');
      const datos = await resp.json();
      if (esNoDisponible(datos)) {
        renderSinDato(contenedor, motivoNoDisponible(datos));
        return;
      }
      departamentos = (datos as RespuestaIraDepartamental).departamentos;
    } catch {
      // Los <select> nunca llegaron a poblarse en este punto, así que
      // reintentar es volver a ejecutar iniciarSeccion sin duplicar opciones.
      renderErrorFuente(contenedor, () => void iniciarSeccion(seccion));
      return;
    }

    departamentos.sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
    for (const d of departamentos) {
      const opcion = document.createElement('option');
      opcion.value = d.codigo;
      opcion.textContent = d.nombre;
      selector.appendChild(opcion);
      const op2 = opcion.cloneNode(true) as HTMLOptionElement;
      op2.selected = false;
      selCompare.appendChild(op2);
    }

    const rango = () => {
      let desde = Number(inpDesde.value);
      let hasta = Number(inpHasta.value);
      if (desde > hasta) [desde, hasta] = [hasta, desde];
      txtRango.textContent = `SE${desde}–SE${hasta}`;
      inpDesde.setAttribute('aria-valuetext', `Semana epidemiológica ${desde}`);
      inpHasta.setAttribute('aria-valuetext', `Semana epidemiológica ${hasta}`);
      return { desde, hasta };
    };

    // Con departamento fijo el componente vive aparte del estado compartido.
    const fijo = seccion.dataset.curvaDepartamento ?? null;

    const sincronizarControles = (f: FiltrosRespiratorio) => {
      selector.value = fijo ?? f.departamento;
      selAnio.value = String(f.anio);
      selCompare.value = f.comparar ?? '';
      // Los deslizadores pueden cruzarse mientras se arrastran: solo se
      // reasignan si el rango efectivo cambió, para no mover el que se sostiene.
      const actualDesde = Math.min(
        Number(inpDesde.value),
        Number(inpHasta.value),
      );
      const actualHasta = Math.max(
        Number(inpDesde.value),
        Number(inpHasta.value),
      );
      if (actualDesde !== f.semanaDesde || actualHasta !== f.semanaHasta) {
        inpDesde.value = String(f.semanaDesde);
        inpHasta.value = String(f.semanaHasta);
      }
    };
    sincronizarControles(
      fijo
        ? { ...obtenerFiltrosRespiratorio(), departamento: fijo }
        : obtenerFiltrosRespiratorio(),
    );

    const refrescar = async () => {
      const { desde, hasta } = rango();
      const codigo = selector.value;
      const nombre = selector.selectedOptions[0]?.textContent ?? codigo;
      contenedor.setAttribute('aria-busy', 'true');
      contenedor.classList.add('opacity-60');
      try {
        const series = await cargarTemporal(apiBase, codigo);
        const filtro = selAnio.value;
        const base = recortar(
          filtro === 'todos' ? series : { [filtro]: series[filtro] ?? [] },
          desde,
          hasta,
        );
        const capas: {
          nombre: string;
          series: Record<string, Punto[]>;
          dashed?: boolean;
        }[] = [{ nombre, series: base }];
        const cmp = selCompare.value;
        if (cmp && cmp !== codigo) {
          const series2 = await cargarTemporal(apiBase, cmp);
          const nombre2 = selCompare.selectedOptions[0]?.textContent ?? cmp;
          capas.push({
            nombre: nombre2,
            dashed: true,
            series: recortar(
              filtro === 'todos'
                ? series2
                : { [filtro]: series2[filtro] ?? [] },
              desde,
              hasta,
            ),
          });
        }
        dibujar(contenedor, capas, desde, hasta);
        const lineas = ['departamento,anio,semana,valor'];
        for (const capa of capas) {
          for (const anio of Object.keys(capa.series)) {
            for (const [s, v] of capa.series[anio]) {
              lineas.push(`${capa.nombre},${anio},${s},${v ?? ''}`);
            }
          }
        }
        ultimoCsv = lineas.join('\n');
        if (btnExport) btnExport.disabled = false;
      } catch (err) {
        const noDisponible =
          err instanceof Error &&
          (err as Error & { noDisponible?: boolean }).noDisponible === true;
        if (noDisponible) {
          renderSinDato(
            contenedor,
            (err as Error & { motivo?: string }).motivo ??
              motivoNoDisponible({ disponible: false }),
          );
        } else {
          renderErrorFuente(contenedor, () => void refrescar());
        }
        ultimoCsv = '';
        if (btnExport) btnExport.disabled = true;
      } finally {
        contenedor.removeAttribute('aria-busy');
        contenedor.classList.remove('opacity-60');
      }
    };
    const alCambiar = () => {
      if (fijo) {
        void refrescar();
        return;
      }
      actualizarFiltrosRespiratorio({
        departamento: selector.value,
        anio: selAnio.value === 'todos' ? 'todos' : Number(selAnio.value),
        comparar: selCompare.value || null,
        semanaDesde: Number(inpDesde.value),
        semanaHasta: Number(inpHasta.value),
      });
    };
    selector.addEventListener('change', alCambiar);
    selAnio.addEventListener('change', alCambiar);
    selCompare.addEventListener('change', alCambiar);
    inpDesde.addEventListener('input', alCambiar);
    inpHasta.addEventListener('input', alCambiar);
    if (!fijo) {
      suscribirFiltrosRespiratorio((f) => {
        sincronizarControles(f);
        void refrescar();
      }, false);
    }
    btnExport?.addEventListener('click', () => {
      if (!ultimoCsv) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(
        new Blob([ultimoCsv], { type: 'text/csv;charset=utf-8' }),
      );
      a.download = 'serie-respiratoria.csv';
      a.click();
    });
    void refrescar();
  }

  document
    .querySelectorAll<HTMLElement>('[data-curva-evento]')
    .forEach((seccion) => {
      void iniciarSeccion(seccion);
    });
</script>
