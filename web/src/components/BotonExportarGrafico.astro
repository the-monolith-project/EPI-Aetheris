---
// Botones "Descargar SVG" y "Descargar PNG" para el primer gráfico de Plot
// de la sección (article o section) que los contiene. Ver exportar-grafico.ts.
interface Props {
  titulo: string;
  fuente: string;
  /** "analisis" toma los filtros vigentes de /dengue; otro texto se usa tal cual. */
  filtros?: string;
  class?: string;
}

const { titulo, fuente, filtros, class: clase = '' } = Astro.props;
const estiloBoton =
  'min-h-[44px] rounded-lg border border-border bg-bg px-3 py-1.5 font-sans text-xs font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent';
---

<div
  class:list={['flex flex-wrap items-center gap-2', clase]}
  data-exportar-grafico
  data-exportar-titulo={titulo}
  data-exportar-fuente={fuente}
  data-exportar-filtros={filtros}
>
  <button type="button" data-exportar-formato="svg" class={estiloBoton}>
    Descargar SVG
  </button>
  <button type="button" data-exportar-formato="png" class={estiloBoton}>
    Descargar PNG
  </button>
  <span data-exportar-estado role="status" class="sr-only"></span>
</div>

<script>
  import { obtenerFiltrosAnalisis } from '../lib/analisis-state';
  import {
    encontrarGraficoPlot,
    exportarPng,
    exportarSvg,
  } from '../lib/exportar-grafico';

  function textoFiltrosAnalisis(): string {
    const f = obtenerFiltrosAnalisis();
    const partes = [
      f.departamento ?? 'todos los departamentos',
      String(f.anio),
      f.serie,
      `SE${f.semanaDesde}–SE${f.semanaHasta}`,
    ];
    return partes.join(' · ');
  }

  document.addEventListener('click', async (evento) => {
    const boton = (evento.target as HTMLElement).closest<HTMLButtonElement>(
      '[data-exportar-formato]',
    );
    const caja = boton?.closest<HTMLElement>('[data-exportar-grafico]');
    if (!boton || !caja) return;
    const estado = caja.querySelector<HTMLElement>('[data-exportar-estado]');
    const seccion = caja.closest('section, article');
    const svg = seccion ? encontrarGraficoPlot(seccion) : null;
    if (!svg) {
      if (estado) estado.textContent = 'El gráfico todavía no está disponible.';
      return;
    }
    const filtros =
      caja.dataset.exportarFiltros === 'analisis'
        ? textoFiltrosAnalisis()
        : caja.dataset.exportarFiltros;
    const opciones = {
      titulo: caja.dataset.exportarTitulo ?? 'Gráfico',
      fuente: caja.dataset.exportarFuente ?? 'EPI-Aetheris',
      filtros,
    };
    try {
      if (boton.dataset.exportarFormato === 'png') {
        await exportarPng(svg, opciones);
      } else {
        exportarSvg(svg, opciones);
      }
      if (estado) estado.textContent = 'Imagen descargada.';
    } catch {
      if (estado) estado.textContent = 'No se pudo generar la imagen.';
    }
  });
</script>
