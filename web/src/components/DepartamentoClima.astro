---
import PanelWorkspace from './analisis/PanelWorkspace.astro';

interface Props {
  codigo: string;
  nombre: string;
}
const { codigo, nombre } = Astro.props;
---

<PanelWorkspace
  tipo="traza"
  titulo="Idoneidad biofísica y anomalía climática"
  descripcion="M1 y M2 del año más reciente con datos: el Iv de cada semana contra la banda P25 a P75 de la propia historia del departamento, y cuántas desviaciones se aparta (σ). Describen el clima, no casos."
  data-departamento-clima={codigo}
  data-departamento-nombre={nombre}
>
  <div
    data-clima-grafica
    class="mt-4 min-h-[260px]"
    role="region"
    aria-label={`Idoneidad biofísica semanal de ${nombre} contra su banda histórica`}
    aria-busy="true"
  >
  </div>
  <p
    data-clima-resumen
    role="status"
    class="mt-3 font-sans text-xs text-ink-muted"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoTraza,
    renderSinDato,
  } from './estado-async';
  import { obtenerSerieIdoneidad } from '../lib/analisis-api';
  import { montarGrafico } from '../lib/echarts-montaje';
  import {
    crearOpcionBase,
    ejeSemana,
    ejeValores,
    etiquetaSemana,
    tooltipPorSemana,
  } from '../lib/echarts-tema';
  import { aniosClimaPresentacion } from '../lib/tipos-analisis';
  import type { SerieTemporalIdoneidad } from '../lib/tipos-analisis';

  async function montar(raiz: HTMLElement): Promise<void> {
    const codigo = raiz.dataset.departamentoClima ?? '';
    const grafica = raiz.querySelector<HTMLElement>('[data-clima-grafica]');
    const resumen = raiz.querySelector<HTMLElement>('[data-clima-resumen]');
    if (!grafica || !resumen) return;
    renderEsqueletoTraza(grafica);

    // El año en curso puede no tener semanas todavía: se prueba hacia atrás.
    const anios = aniosClimaPresentacion().reverse().slice(0, 3);
    let serie: SerieTemporalIdoneidad | null = null;
    let motivo = 'Sin idoneidad biofísica para este departamento.';
    try {
      for (const anio of anios) {
        const respuesta = await obtenerSerieIdoneidad(codigo, anio);
        if (esNoDisponible(respuesta)) {
          motivo = motivoNoDisponible(respuesta);
          continue;
        }
        if (respuesta.semanas.some((s) => s.iv_real !== null)) {
          serie = respuesta;
          break;
        }
      }
    } catch {
      grafica.setAttribute('aria-busy', 'false');
      renderErrorFuente(
        grafica,
        () => void montar(raiz),
        'No se pudo cargar la idoneidad biofísica.',
      );
      return;
    }
    grafica.setAttribute('aria-busy', 'false');
    if (!serie) {
      renderSinDato(grafica, motivo);
      return;
    }

    const semanas = serie.semanas;
    const conIv = semanas.filter((s) => s.iv_real !== null);
    const banda = semanas.filter(
      (s) => s.p25_baseline !== null && s.p75_baseline !== null,
    );
    const porSemana = new Map(semanas.map((s) => [s.semana_epi, s]));
    await montarGrafico(
      grafica,
      (t) => ({
        ...crearOpcionBase(t, {
          grid: { bottom: 84 },
          legend: { data: ['Iv observado', 'Banda histórica P25 a P75'] },
          tooltip: {
            formatter: tooltipPorSemana(
              porSemana,
              (s) =>
                `${etiquetaSemana(s.semana_epi)} · Iv ${s.iv_real ?? '—'} · banda P25–P75: ${
                  s.p25_baseline ?? '—'
                } a ${s.p75_baseline ?? '—'}`,
            ),
          },
        }),
        xAxis: ejeSemana(t, 1, 53),
        yAxis: ejeValores(t, 'Iv (0–1)', { min: 0 }),
        series: [
          {
            // Base invisible de la banda; la serie siguiente aporta el tramo
            // entre P25 y P75.
            name: 'Base de la banda',
            type: 'line',
            stack: 'banda',
            silent: true,
            symbol: 'none',
            lineStyle: { width: 0 },
            data: banda.map((s) => [s.semana_epi, s.p25_baseline]),
          },
          {
            name: 'Banda histórica P25 a P75',
            type: 'line',
            stack: 'banda',
            silent: true,
            symbol: 'none',
            lineStyle: { width: 0 },
            itemStyle: { color: t.secundario, opacity: 0.5 },
            areaStyle: { color: t.secundario, opacity: 0.5 },
            data: banda.map((s) => [
              s.semana_epi,
              (s.p75_baseline as number) - (s.p25_baseline as number),
            ]),
          },
          {
            name: 'Iv observado',
            type: 'line',
            symbolSize: 5,
            itemStyle: { color: t.acento },
            lineStyle: { width: 2.5, color: t.acento },
            z: 5,
            data: conIv.map((s) => [s.semana_epi, s.iv_real]),
          },
        ],
      }),
      `Idoneidad biofísica semanal de ${raiz.dataset.departamentoNombre ?? codigo} contra su banda histórica`,
    );

    const ultima = conIv[conIv.length - 1];
    const sigma =
      ultima.anomaly_sigma !== null
        ? `, anomalía ${ultima.anomaly_sigma.toFixed(2)} σ`
        : '';
    const bandaTexto =
      ultima.p25_baseline !== null && ultima.p75_baseline !== null
        ? ` (banda histórica ${ultima.p25_baseline.toFixed(2)} a ${ultima.p75_baseline.toFixed(2)})`
        : '';
    resumen.textContent = `${serie.departamento_nombre} · ${serie.anio}: última semana con dato SE${String(
      ultima.semana_epi,
    ).padStart(
      2,
      '0',
    )}, Iv ${ultima.iv_real?.toFixed(2)}${bandaTexto}${sigma}.`;
  }

  document
    .querySelectorAll<HTMLElement>('[data-departamento-clima]')
    .forEach((raiz) => void montar(raiz));
</script>
