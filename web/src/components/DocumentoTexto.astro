---
/**
 * Envoltorio de las páginas de texto largo escritas a mano: las tres legales,
 * contacto y acerca de. Da el mismo bloque de lectura que la Biblioteca
 * (tarjeta elevada, medida de ~68 caracteres, titular en Fraunces) sin pasar
 * por la colección de contenido: esos documentos son markdown compartido con
 * el monorepo, y el texto legal es específico de este despliegue.
 *
 * Los estilos de prosa van en un único `is:global` acotado a `.doc-texto`,
 * así no se duplican en cada página ni se filtran a /biblioteca, que conserva
 * su propio bloque scoped (`.doc-md`).
 */
import Layout from '../layouts/Layout.astro';

interface Props {
  titulo: string;
  descripcion: string;
  /** Fecha visible de última revisión. Obligatoria en las legales: sin ella
   *  el lector no sabe qué versión está aceptando. */
  actualizado?: string;
  /** Rótulo pequeño sobre el titular (p. ej. "Documento legal"). */
  seccion?: string;
}

const { titulo, descripcion, actualizado, seccion } = Astro.props;
---

<Layout title={`EPI-Aetheris — ${titulo}`} descripcion={descripcion}>
  <main
    id="contenido-principal"
    class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    <article
      class="card-elevated max-w-[calc(68ch+4rem)] rounded-2xl border border-border bg-surface p-6 sm:p-8"
    >
      <header class="border-b border-border pb-5">
        {
          seccion && (
            <p class="font-sans text-xs font-semibold uppercase tracking-wider text-accent">
              {seccion}
            </p>
          )
        }
        <h1
          class="mt-1 font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-[2rem]"
        >
          {titulo}
        </h1>
        <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
          {descripcion}
        </p>
        {
          actualizado && (
            <p class="mt-4 font-mono text-[11px] text-ink-muted">
              Última actualización: {actualizado}
            </p>
          )
        }
      </header>
      <div class="doc-texto mt-2 font-sans text-ink">
        <slot />
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  /* Prosa de las páginas escritas a mano. Mismos valores que el `.doc-md` de
     la Biblioteca; se mantienen separados a propósito (aquel renderiza
     markdown de terceros, este HTML propio) y se unificarán si aparece un
     tercer consumidor. */
  .doc-texto {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .doc-texto h2 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
    margin-top: 2.75rem;
    margin-bottom: 0.6rem;
  }
  .doc-texto h3 {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    margin-top: 1.75rem;
    margin-bottom: 0.4rem;
  }
  .doc-texto p {
    margin-top: 0.9rem;
    margin-bottom: 0.9rem;
  }
  .doc-texto ul,
  .doc-texto ol {
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
  }
  .doc-texto ul {
    list-style: disc;
  }
  .doc-texto ol {
    list-style: decimal;
  }
  .doc-texto li {
    margin-top: 0.35rem;
  }
  .doc-texto a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .doc-texto strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .doc-texto code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .doc-texto table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.85em;
  }
  .doc-texto th,
  .doc-texto td {
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.6rem;
    text-align: left;
    vertical-align: top;
  }
  .doc-texto th {
    background: var(--color-bg);
    font-weight: 600;
  }
  .doc-texto hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
  /* Bloque para los datos pendientes de rellenar y para los avisos cortos. */
  .doc-texto .nota {
    border-left: 3px solid var(--color-accent);
    background: var(--color-secondary);
    color: var(--color-secondary-ink);
    padding: 0.75rem 1rem;
    border-radius: 0 8px 8px 0;
    margin: 1.25rem 0;
  }
  .doc-texto .nota p {
    margin: 0.35rem 0;
  }
</style>
