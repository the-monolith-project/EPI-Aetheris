---
import PanelWorkspace from './PanelWorkspace.astro';
---

<PanelWorkspace
  tipo="traza"
  titulo="Comparación de departamentos"
  descripcion="Compara hasta cuatro departamentos con la misma escala. Los huecos corresponden a semanas sin observación."
>
  <div
    data-vacio-departamentos
    class="mt-4 flex flex-col items-center justify-center rounded-xl border border-dashed border-border bg-bg/50 p-8 text-center"
  >
    <p class="font-sans text-sm text-ink-muted">
      Selecciona hasta cuatro departamentos en Filtros para comparar sus curvas.
    </p>
    <button
      type="button"
      data-abrir-filtros-accion
      class="mt-3 rounded-lg border border-border bg-surface px-3 py-1.5 font-sans text-xs font-semibold text-accent transition-colors hover:border-accent/40"
    >
      Abrir filtros
    </button>
  </div>

  <div
    id="comparacion-departamentos-grafica"
    class="mt-4 max-h-[560px] overflow-auto scroll-shadow-x"
    hidden
  >
    <div
      id="comparacion-departamentos"
      class="min-h-[240px] min-w-[720px]"
      role="region"
      aria-label="Comparación semanal en paneles alineados para los departamentos seleccionados"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[240px] w-full min-w-[720px] flex-col justify-around gap-4 p-4"
        aria-hidden="true"
      >
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
      </div>
    </div>
  </div>

  <details
    id="departamentos-tabla-detalles"
    class="mt-3 rounded-xl border border-border bg-bg p-3"
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
    >
      Ver los datos en tabla
    </summary>
    <div id="departamentos-tabla-contenedor"></div>
  </details>

  <p
    id="comparacion-departamentos-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  // Plot entra por import dinamico, como en el resto de paneles: cuando
  // un solo componente lo importa de forma estatica, Vite lo arrastra al
  // grafo inicial y anula los await import de los demas -- 391 KB de Plot
  // y d3 quedaban en la carga critica de /dengue.
  let Plot: typeof import('@observablehq/plot') | null = null;
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoTraza,
    renderSinDato,
  } from '../estado-async';
  import { obtenerDatasetAnalitico } from '../../lib/analisis-api';
  import {
    actualizarFiltrosAnalisis,
    obtenerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import { ESTILO_PLOT, marcoPlot } from '../../lib/plot-tema';
  import { vincularMarcasPlot } from '../../lib/plot-interacciones';
  import { TablaAlternativa } from '../../lib/tabla-alternativa';
  import {
    esAnioAnalisisDengue,
    notaAnioSoloClima,
    type FiltrosAnalisis,
  } from '../../lib/tipos-analisis';

  interface PuntoDepartamento {
    codigo: string;
    departamento: string;
    semana: number;
    casos: number | null;
  }

  const contenedor = document.getElementById('comparacion-departamentos');
  const marcoGrafica = document.getElementById(
    'comparacion-departamentos-grafica',
  );
  const vacioContenedor = document.querySelector<HTMLElement>(
    '[data-vacio-departamentos]',
  );
  const resumen = document.getElementById('comparacion-departamentos-resumen');
  let revision = 0;
  let filtrosActuales = obtenerFiltrosAnalisis();
  let datosTabla: PuntoDepartamento[] = [];

  const detailsTabla = document.getElementById(
    'departamentos-tabla-detalles',
  ) as HTMLDetailsElement | null;
  const contenedorTabla = document.getElementById(
    'departamentos-tabla-contenedor',
  );

  const tablaAlternativa =
    detailsTabla && contenedorTabla
      ? new TablaAlternativa({
          details: detailsTabla,
          contenedorTabla,
          caption: 'Comparación de departamentos seleccionados por semana',
          columnas: [
            { clave: 'departamento', encabezado: 'Departamento' },
            {
              clave: 'semana',
              encabezado: 'Semana',
              alineacion: 'derecha',
              formato: (v) => `SE${String(v).padStart(2, '0')}`,
            },
            {
              clave: 'casos',
              encabezado: 'Casos observados',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? String(v) : '—'),
            },
          ],
          obtenerDatos: () => datosTabla,
        })
      : null;

  vacioContenedor
    ?.querySelector('[data-abrir-filtros-accion]')
    ?.addEventListener('click', () => {
      document.getElementById('analisis-abrir-filtros')?.click();
    });

  async function renderizar(filtros: FiltrosAnalisis) {
    if (!contenedor) return;
    const idRevision = ++revision;
    if (filtros.comparar.length === 0) {
      contenedor.replaceChildren();
      if (marcoGrafica) marcoGrafica.hidden = true;
      if (vacioContenedor) vacioContenedor.hidden = false;
      if (resumen)
        resumen.textContent =
          'Selecciona entre uno y cuatro departamentos en los filtros.';
      return;
    }
    if (vacioContenedor) vacioContenedor.hidden = true;
    if (marcoGrafica) marcoGrafica.hidden = false;
    if (resumen) resumen.textContent = 'Cargando comparación departamental…';

    if (!esAnioAnalisisDengue(filtros.anio)) {
      renderSinDato(contenedor, notaAnioSoloClima(filtros.anio));
      if (resumen) resumen.textContent = notaAnioSoloClima(filtros.anio);
      contenedor.setAttribute('aria-busy', 'false');
      return;
    }

    contenedor.setAttribute('aria-busy', 'true');
    renderEsqueletoTraza(contenedor);
    try {
      const dataset = await obtenerDatasetAnalitico(filtros.anio);
      if (idRevision !== revision) return;
      if (esNoDisponible(dataset)) {
        renderSinDato(contenedor, motivoNoDisponible(dataset));
        return;
      }
      const orden = new Map(
        filtros.comparar.map((codigo, indice) => [codigo, indice]),
      );
      const departamentos = dataset.departamentos
        .filter((departamento) => orden.has(departamento.codigo))
        .sort(
          (a, b) => (orden.get(a.codigo) ?? 0) - (orden.get(b.codigo) ?? 0),
        );
      const puntos: PuntoDepartamento[] = departamentos.flatMap(
        (departamento) =>
          departamento.semanas
            .filter(
              (semana) =>
                semana.semana_epi >= filtros.semanaDesde &&
                semana.semana_epi <= filtros.semanaHasta,
            )
            .map((semana) => ({
              codigo: departamento.codigo,
              departamento: departamento.nombre,
              semana: semana.semana_epi,
              casos: semana[filtros.serie],
            })),
      );
      const observados = puntos.filter((punto) => punto.casos !== null);
      const dominios = departamentos.map((departamento) => departamento.nombre);

      datosTabla = observados;
      tablaAlternativa?.marcarCaducada();

      Plot ??= await import('@observablehq/plot');
      const grafica = Plot!.plot({
        width: Math.max(contenedor.clientWidth, 720),
        height: Math.max(260, departamentos.length * 170),
        marginLeft: 130,
        marginBottom: 48,
        x: {
          domain: [filtros.semanaDesde, filtros.semanaHasta],
          label: 'Semana epidemiológica',
          tickFormat: (valor) => `SE${String(valor).padStart(2, '0')}`,
          ticks: 10,
        },
        y: { label: `Casos ${filtros.serie}`, grid: true, zero: true },
        fy: { domain: dominios, label: null, padding: 0.12 },
        style: ESTILO_PLOT,
        marks: [
          Plot.line(puntos, {
            x: 'semana',
            y: 'casos',
            fy: 'departamento',
            stroke: 'var(--color-accent)',
            strokeWidth: 2,
          }),
          Plot.dot(observados, {
            className: 'epi-comparacion-departamentos-puntos',
            x: 'semana',
            y: 'casos',
            fy: 'departamento',
            r: (punto: PuntoDepartamento) =>
              punto.codigo === filtros.departamento &&
              punto.semana === filtros.semana
                ? 4
                : 2.25,
            fill: (punto: PuntoDepartamento) =>
              punto.codigo === filtros.departamento
                ? 'var(--color-accent)'
                : '#5598e7',
            stroke: (punto: PuntoDepartamento) =>
              punto.codigo === filtros.departamento &&
              punto.semana === filtros.semana
                ? 'var(--color-seleccion)'
                : 'none',
            strokeWidth: 2,
            title: (punto: PuntoDepartamento) =>
              `${punto.departamento} · SE${String(punto.semana).padStart(2, '0')}\n${punto.casos} casos ${filtros.serie}`,
          }),
          marcoPlot(Plot!),
        ],
      });
      vincularMarcasPlot(
        grafica,
        '.epi-comparacion-departamentos-puntos circle',
        observados,
        (punto) =>
          `${punto.departamento}, SE${String(punto.semana).padStart(2, '0')}, ${punto.casos} casos ${filtros.serie}`,
        (punto) =>
          actualizarFiltrosAnalisis({
            departamento: punto.codigo,
            semana: punto.semana,
          }),
      );
      contenedor.replaceChildren(grafica);

      if (resumen) {
        const coberturas = departamentos.map((departamento) => {
          const cantidad = observados.filter(
            (punto) => punto.codigo === departamento.codigo,
          ).length;
          return `${departamento.nombre}: ${cantidad} semanas`;
        });
        resumen.innerHTML = `<span>Año <span class="cifra">${filtros.anio}</span> · serie ${filtros.serie} · ${coberturas.join(' · ')}.</span>`;
      }
    } catch {
      if (idRevision !== revision) return;
      if (marcoGrafica) marcoGrafica.hidden = false;
      renderErrorFuente(contenedor, () => void renderizar(filtrosActuales));
      if (resumen)
        resumen.textContent = 'No se pudo cargar la comparación departamental.';
    } finally {
      contenedor.setAttribute('aria-busy', 'false');
    }
  }

  suscribirFiltrosAnalisis((filtros) => {
    filtrosActuales = filtros;
    void renderizar(filtros);
  });
  let ultimoAncho = 0;
  let timerResize: ReturnType<typeof setTimeout> | null = null;
  if (contenedor) {
    new ResizeObserver((entradas) => {
      const entrada = entradas[0];
      if (!entrada) return;
      const nuevoAncho = Math.round(entrada.contentRect.width);
      if (nuevoAncho === ultimoAncho) return;
      ultimoAncho = nuevoAncho;
      if (timerResize) clearTimeout(timerResize);
      timerResize = setTimeout(() => {
        void renderizar(filtrosActuales);
      }, 150);
    }).observe(contenedor);
  }
</script>
