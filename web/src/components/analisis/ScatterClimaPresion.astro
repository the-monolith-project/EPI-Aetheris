---
import PanelWorkspace from './PanelWorkspace.astro';
---

<PanelWorkspace
  tipo="traza"
  titulo="Anomalía climática y presión relativa"
  descripcion="Cada punto es un departamento en la semana activa: anomalía climática en un eje, presión relativa en el otro."
>
  <div class="mt-4 overflow-x-auto scroll-shadow-x" tabindex="0">
    <div
      id="scatter-clima-presion"
      class="min-h-[340px] min-w-[720px]"
      role="region"
      aria-label="Scatter de anomalía climática y percentil de presión epidemiológica por departamento"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[340px] w-full min-w-[720px] flex-col justify-around gap-4 p-4"
        aria-hidden="true"
      >
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
      </div>
    </div>
  </div>

  <details
    id="scatter-tabla-detalles"
    class="mt-3 rounded-xl border border-border bg-bg p-3"
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
    >
      Ver los datos en tabla
    </summary>
    <div id="scatter-tabla-contenedor"></div>
  </details>

  <p
    id="scatter-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoTraza,
    renderSinDato,
  } from '../estado-async';
  import { obtenerDatasetAnalitico } from '../../lib/analisis-api';
  import {
    actualizarFiltrosAnalisis,
    obtenerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import { montarGrafico } from '../../lib/echarts-montaje';
  import type { GraficoMontado } from '../../lib/echarts-montaje';
  import { crearOpcionBase, ejeValores } from '../../lib/echarts-tema';
  import { escapeHtml } from '../../utils/security';
  import { TablaAlternativa } from '../../lib/tabla-alternativa';
  import {
    esAnioAnalisisDengue,
    notaAnioSoloClima,
    type FiltrosAnalisis,
  } from '../../lib/tipos-analisis';

  interface PuntoScatter {
    codigo: string;
    departamento: string;
    anomalia: number;
    percentil: number;
    casos: number | null;
    iv: number | null;
    p50: number | null;
    p75: number | null;
    observacionesBaseline: number;
    aniosBaseline: number;
  }

  const contenedor = document.getElementById('scatter-clima-presion');
  const resumen = document.getElementById('scatter-resumen');
  let revision = 0;
  let grafico: GraficoMontado | null = null;
  let filtrosActuales = obtenerFiltrosAnalisis();
  let datosTabla: PuntoScatter[] = [];

  const detailsTabla = document.getElementById(
    'scatter-tabla-detalles',
  ) as HTMLDetailsElement | null;
  const contenedorTabla = document.getElementById('scatter-tabla-contenedor');

  const tablaAlternativa =
    detailsTabla && contenedorTabla
      ? new TablaAlternativa({
          details: detailsTabla,
          contenedorTabla,
          caption: 'Anomalía climática y percentil de presión por departamento',
          columnas: [
            { clave: 'departamento', encabezado: 'Departamento' },
            {
              clave: 'anomalia',
              encabezado: 'Anomalía climática',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? `${Number(v).toFixed(2)}σ` : '—'),
            },
            {
              clave: 'percentil',
              encabezado: 'Percentil presión',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? `${v}%` : '—'),
            },
            {
              clave: 'casos',
              encabezado: 'Casos observados',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? String(v) : '—'),
            },
            {
              clave: 'iv',
              encabezado: 'Idoneidad (Iv)',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? Number(v).toFixed(3) : '—'),
            },
          ],
          obtenerDatos: () => datosTabla,
        })
      : null;

  function tooltip(punto: PuntoScatter, filtros: FiltrosAnalisis): string {
    return (
      `${punto.departamento} · ${filtros.anio} · SE${String(filtros.semana).padStart(2, '0')}\n` +
      `Anomalía: ${punto.anomalia.toFixed(2)}σ\nPercentil presión (${filtros.serie}): ${punto.percentil}\n` +
      `Casos observados: ${punto.casos ?? 'sin dato'} · Iv: ${punto.iv?.toFixed(3) ?? 'sin dato'}\n` +
      `P50/P75: ${punto.p50 ?? 'sin dato'} / ${punto.p75 ?? 'sin dato'}\n` +
      `Línea base: ${punto.observacionesBaseline} observaciones, ${punto.aniosBaseline} años`
    );
  }

  async function renderizar(filtros: FiltrosAnalisis) {
    if (!contenedor) return;
    const idRevision = ++revision;
    grafico?.destruir();
    grafico = null;
    if (resumen)
      resumen.textContent = `Cargando ${filtros.anio}, SE${String(filtros.semana).padStart(2, '0')}…`;

    if (!esAnioAnalisisDengue(filtros.anio)) {
      renderSinDato(contenedor, notaAnioSoloClima(filtros.anio));
      if (resumen) resumen.textContent = notaAnioSoloClima(filtros.anio);
      contenedor.setAttribute('aria-busy', 'false');
      return;
    }

    contenedor.setAttribute('aria-busy', 'true');
    renderEsqueletoTraza(contenedor);
    try {
      const datos = await obtenerDatasetAnalitico(filtros.anio);
      if (idRevision !== revision) return;
      if (esNoDisponible(datos)) {
        renderSinDato(contenedor, motivoNoDisponible(datos));
        return;
      }
      const puntos: PuntoScatter[] = datos.departamentos.flatMap(
        (departamento) => {
          const semana = departamento.semanas.find(
            (fila) => fila.semana_epi === filtros.semana,
          );
          if (!semana || semana.anomaly_sigma === null) return [];
          const presion =
            filtros.serie === 'probable'
              ? semana.presion_probable
              : semana.presion_confirmado;
          if (presion.percentil === null) return [];
          return [
            {
              codigo: departamento.codigo,
              departamento: departamento.nombre,
              anomalia: semana.anomaly_sigma,
              percentil: presion.percentil,
              casos: presion.casos_observados,
              iv: semana.iv,
              p50: presion.p50_baseline,
              p75: presion.p75_baseline,
              observacionesBaseline: presion.n_obs_baseline,
              aniosBaseline: presion.anios_baseline,
            },
          ];
        },
      );
      const puntoActivo = puntos.filter(
        (punto) => punto.codigo === filtros.departamento,
      );

      datosTabla = puntos;
      tablaAlternativa?.marcarCaducada();

      const COLOR_PUNTO = '#2171b5';
      contenedor.style.height = '350px';
      const montado = await montarGrafico(
        contenedor,
        (t) => ({
          ...crearOpcionBase(t, {
            grid: { left: 62, bottom: 56, show: true, borderColor: t.borde },
            legend: { show: false },
            tooltip: {
              trigger: 'item',
              formatter: (p: { dataIndex: number }) =>
                escapeHtml(tooltip(puntos[p.dataIndex], filtros)).replaceAll(
                  '\n',
                  '<br/>',
                ),
            },
          }),
          xAxis: ejeValores(t, '', {
            name: 'Anomalía climática (σ)',
            nameLocation: 'middle',
            nameGap: 32,
            nameTextStyle: { color: t.tintaSuave },
            scale: true,
          }),
          yAxis: ejeValores(t, `Percentil presión (${filtros.serie})`, {
            min: 0,
            max: 100,
          }),
          series: [
            {
              type: 'scatter',
              symbolSize: 10,
              itemStyle: {
                color: COLOR_PUNTO,
                opacity: 0.75,
                borderColor: t.superficie,
                borderWidth: 1.5,
              },
              data: puntos.map((punto) => [punto.anomalia, punto.percentil]),
              // Eje de anomalía cero: separa clima por debajo y por encima de lo normal.
              markLine: {
                silent: true,
                symbol: 'none',
                label: { show: false },
                lineStyle: { color: t.borde, width: 1.5, type: 'solid' },
                data: [{ xAxis: 0 }],
              },
            },
            {
              // Anillo y nombre del departamento activo, por encima del resto.
              type: 'scatter',
              silent: true,
              symbolSize: 17,
              z: 5,
              itemStyle: {
                color: 'transparent',
                borderColor: t.seleccion,
                borderWidth: 2.5,
              },
              label: {
                show: true,
                position: 'top',
                distance: 6,
                color: t.tinta,
                fontSize: 11,
                formatter: (p: { dataIndex: number }) =>
                  puntoActivo[p.dataIndex].departamento,
              },
              data: puntoActivo.map((punto) => [
                punto.anomalia,
                punto.percentil,
              ]),
            },
          ],
        }),
        'Anomalía climática y percentil de presión epidemiológica por departamento',
      );
      if (idRevision !== revision) {
        montado.destruir();
        return;
      }
      grafico = montado;
      // Pulsar un punto fija el departamento (antes, también con teclado).
      montado.instancia.on('click', (evento: unknown) => {
        const { componentType, seriesIndex, dataIndex } = evento as {
          componentType?: string;
          seriesIndex?: number;
          dataIndex?: number;
        };
        if (
          componentType !== 'series' ||
          seriesIndex !== 0 ||
          dataIndex === undefined
        ) {
          return;
        }
        actualizarFiltrosAnalisis({ departamento: puntos[dataIndex].codigo });
      });

      const omitidos = datos.departamentos.length - puntos.length;
      const activo = puntoActivo[0];
      if (resumen) {
        resumen.innerHTML = activo
          ? `<span><strong class="font-medium text-ink">${activo.departamento}</strong> · año <span class="cifra">${filtros.anio}</span> · semana <span class="cifra font-semibold text-accent">SE${String(filtros.semana).padStart(2, '0')}</span> · anomalía <span class="cifra">${activo.anomalia.toFixed(2)}σ</span> · percentil <span class="cifra font-semibold text-accent">${activo.percentil}</span> (${filtros.serie}).</span>`
          : `<span><span class="cifra">${puntos.length}</span> departamentos con ambas variables; <span class="cifra">${omitidos}</span> omitidos por falta de datos · año <span class="cifra">${filtros.anio}</span> · semana <span class="cifra">SE${String(filtros.semana).padStart(2, '0')}</span> · serie ${filtros.serie}.</span>`;
      }
    } catch {
      if (idRevision !== revision) return;
      renderErrorFuente(contenedor, () => void renderizar(filtrosActuales));
      if (resumen)
        resumen.textContent = 'No se pudo cargar la relación clima-presión.';
    } finally {
      contenedor.setAttribute('aria-busy', 'false');
    }
  }

  let activado = false;
  async function activar() {
    if (activado || !contenedor) return;
    activado = true;
    suscribirFiltrosAnalisis((filtros) => {
      filtrosActuales = filtros;
      void renderizar(filtros);
    });
  }

  const panel = contenedor?.closest('[data-panel-workspace]') ?? contenedor;
  if (panel) {
    const io = new IntersectionObserver((entradas) => {
      if (entradas.some((entrada) => entrada.isIntersecting)) {
        io.disconnect();
        void activar();
      }
    });
    io.observe(panel);
  } else {
    void activar();
  }
</script>
