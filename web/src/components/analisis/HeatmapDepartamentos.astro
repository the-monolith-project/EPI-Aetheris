---
import LeyendaRampa from './LeyendaRampa.astro';
import PanelWorkspace from './PanelWorkspace.astro';
import { RAMPA_PRESION } from '../../lib/colores';
---

<PanelWorkspace
  tipo="matriz"
  titulo="Presión por departamento y semana"
  descripcion="Percentil del conteo observado respecto a la historia del mismo departamento. Las celdas grises indican que falta la observación o que no hay historial suficiente para calcular el percentil."
>
  <div class="mt-4 overflow-x-auto scroll-shadow-x" tabindex="0">
    <div
      id="heatmap-departamentos"
      class="min-h-[420px] min-w-[760px]"
      role="region"
      aria-label="Mapa de calor de presión epidemiológica relativa por departamento y semana"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[420px] w-full min-w-[760px] flex-col justify-between gap-2.5 p-2"
        aria-hidden="true"
      >
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
      </div>
    </div>
  </div>

  <LeyendaRampa
    rampa={RAMPA_PRESION}
    idRampa="heatmap-leyenda-rampa"
    etiquetaMin="Percentil 0"
    etiquetaMax="Percentil 100"
    descripcionLectores="El color de cada celda va de un tono claro en el percentil 0 a un tono oscuro en el percentil 100, en una escala continua; las celdas grises indican que falta el dato."
  />

  <details
    id="heatmap-tabla-detalles"
    class="mt-3 rounded-xl border border-border bg-bg p-3"
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
    >
      Ver los datos en tabla
    </summary>
    <div id="heatmap-tabla-contenedor"></div>
  </details>

  <p
    id="heatmap-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoMatriz,
    renderSinDato,
  } from '../estado-async';
  import { obtenerDatasetAnalitico } from '../../lib/analisis-api';
  import {
    actualizarFiltrosAnalisis,
    obtenerFiltrosAnalisis,
    soloCambiaSemana,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import { colorPresion, gradienteCss, RAMPA_PRESION } from '../../lib/colores';
  import { moverSeleccionMatriz, montarMatriz } from '../../lib/echarts-matriz';
  import type { ConfigMatriz } from '../../lib/echarts-matriz';
  import type { GraficoMontado } from '../../lib/echarts-montaje';
  import { TablaAlternativa } from '../../lib/tabla-alternativa';
  import {
    esAnioAnalisisDengue,
    notaAnioSoloClima,
    type FiltrosAnalisis,
    type PresionAnalitica,
  } from '../../lib/tipos-analisis';

  interface CeldaHeatmap {
    codigo: string;
    departamento: string;
    semana: number;
    percentil: number | null;
    casos: number | null;
    presion: PresionAnalitica;
  }

  const contenedor = document.getElementById('heatmap-departamentos');
  const resumen = document.getElementById('heatmap-resumen');
  const leyenda = document.getElementById('heatmap-leyenda-rampa');
  if (leyenda) leyenda.style.background = gradienteCss(RAMPA_PRESION);

  let revision = 0;
  let grafico: GraficoMontado | null = null;
  let filtrosActuales = obtenerFiltrosAnalisis();
  let filtrosPintados: FiltrosAnalisis | null = null;
  /** Reaplica la semana activa sobre la matriz vigente, con transición. */
  let moverSemana: ((filtros: FiltrosAnalisis) => void) | null = null;
  let datosTabla: any[] = [];

  const detailsTabla = document.getElementById(
    'heatmap-tabla-detalles',
  ) as HTMLDetailsElement | null;
  const contenedorTabla = document.getElementById('heatmap-tabla-contenedor');

  const tablaAlternativa =
    detailsTabla && contenedorTabla
      ? new TablaAlternativa({
          details: detailsTabla,
          contenedorTabla,
          caption: 'Presión epidemiológica relativa por departamento y semana',
          columnas: [
            { clave: 'departamento', encabezado: 'Departamento' },
            {
              clave: 'semana',
              encabezado: 'Semana',
              alineacion: 'derecha',
              formato: (v) => `SE${String(v).padStart(2, '0')}`,
            },
            {
              clave: 'casos',
              encabezado: 'Casos observados',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? String(v) : '—'),
            },
            {
              clave: 'percentil',
              encabezado: 'Percentil',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? `${v}%` : '—'),
            },
            {
              clave: 'p50_p75',
              encabezado: 'P50 / P75',
              alineacion: 'derecha',
            },
          ],
          obtenerDatos: () => datosTabla,
        })
      : null;

  function textoCelda(celda: CeldaHeatmap, filtros: FiltrosAnalisis): string {
    if (celda.percentil === null) {
      return `${celda.departamento} · ${filtros.anio} · SE${String(celda.semana).padStart(2, '0')}\n${celda.presion.nota ?? 'Sin percentil disponible'}`;
    }
    return (
      `${celda.departamento} · ${filtros.anio} · SE${String(celda.semana).padStart(2, '0')}\n` +
      `Percentil: ${celda.percentil}\nCasos observados (${filtros.serie}): ${celda.casos ?? 'sin dato'}\n` +
      `P50/P75: ${celda.presion.p50_baseline} / ${celda.presion.p75_baseline}`
    );
  }

  async function renderizar(filtros: FiltrosAnalisis) {
    if (!contenedor) return;
    if (grafico && moverSemana && soloCambiaSemana(filtrosPintados, filtros)) {
      filtrosPintados = filtros;
      moverSemana(filtros);
      return;
    }
    filtrosPintados = filtros;
    moverSemana = null;
    const idRevision = ++revision;
    grafico?.destruir();
    grafico = null;
    if (resumen)
      resumen.textContent = `Cargando ${filtros.anio}, serie ${filtros.serie}…`;

    if (!esAnioAnalisisDengue(filtros.anio)) {
      renderSinDato(contenedor, notaAnioSoloClima(filtros.anio));
      if (resumen) resumen.textContent = notaAnioSoloClima(filtros.anio);
      contenedor.setAttribute('aria-busy', 'false');
      return;
    }

    contenedor.setAttribute('aria-busy', 'true');
    renderEsqueletoMatriz(contenedor);
    try {
      const datos = await obtenerDatasetAnalitico(filtros.anio);
      if (idRevision !== revision) return;
      if (esNoDisponible(datos)) {
        renderSinDato(contenedor, motivoNoDisponible(datos));
        return;
      }
      const celdas: CeldaHeatmap[] = datos.departamentos.flatMap(
        (departamento) =>
          departamento.semanas
            .filter(
              (semana) =>
                semana.semana_epi >= filtros.semanaDesde &&
                semana.semana_epi <= filtros.semanaHasta,
            )
            .map((semana) => {
              const presion =
                filtros.serie === 'probable'
                  ? semana.presion_probable
                  : semana.presion_confirmado;
              return {
                codigo: departamento.codigo,
                departamento: departamento.nombre,
                semana: semana.semana_epi,
                percentil: presion.percentil,
                casos: presion.casos_observados,
                presion,
              };
            }),
      );
      const seleccionDe = (f: FiltrosAnalisis) =>
        celdas.filter(
          (celda) =>
            celda.semana === f.semana &&
            (!f.departamento || celda.codigo === f.departamento),
        );
      const configMatriz = (f: FiltrosAnalisis): ConfigMatriz => {
        const seleccion = seleccionDe(f);
        return {
          semanas: Array.from(
            { length: f.semanaHasta - f.semanaDesde + 1 },
            (_, indice) => f.semanaDesde + indice,
          ),
          filas: datos.departamentos.map((departamento) => departamento.nombre),
          celdas: celdas.map((celda) => ({
            semana: celda.semana,
            fila: celda.departamento,
            color: colorPresion(celda.percentil),
            activa: seleccion.includes(celda),
          })),
          izquierda: 110,
          etiquetasX: 10,
          texto: (indice) => textoCelda(celdas[indice], f),
        };
      };

      datosTabla = celdas.map((c) => ({
        ...c,
        p50_p75: `${c.presion.p50_baseline ?? '—'} / ${c.presion.p75_baseline ?? '—'}`,
      }));
      tablaAlternativa?.marcarCaducada();

      contenedor.style.height = '430px';
      const montado = await montarMatriz(
        contenedor,
        () => configMatriz(filtrosActuales),
        'Presión epidemiológica relativa por departamento y semana',
        (indice) =>
          actualizarFiltrosAnalisis({
            departamento: celdas[indice].codigo,
            semana: celdas[indice].semana,
          }),
      );
      if (idRevision !== revision) {
        montado.destruir();
        return;
      }
      grafico = montado;

      const pintarResumen = (filtros: FiltrosAnalisis) => {
        if (!resumen) return;
        const celdaActiva = filtros.departamento
          ? celdas.find(
              (celda) =>
                celda.codigo === filtros.departamento &&
                celda.semana === filtros.semana,
            )
          : null;
        if (celdaActiva) {
          const pTexto =
            celdaActiva.percentil !== null
              ? `percentil ${celdaActiva.percentil}`
              : 'sin percentil';
          const casosTexto =
            celdaActiva.casos !== null
              ? `${celdaActiva.casos} casos observados`
              : 'sin dato de casos';
          resumen.innerHTML = `
            <span>${celdaActiva.departamento} · <span class="cifra font-semibold text-accent">${pTexto}</span> con <span class="cifra">${casosTexto}</span> (${filtros.serie}) en la semana <span class="cifra font-semibold text-accent">SE${String(celdaActiva.semana).padStart(2, '0')}</span> de <span class="cifra">${filtros.anio}</span>.</span>
          `;
        } else {
          resumen.innerHTML = `
            <span><span class="cifra">${datos.departamentos.length}</span> departamentos en el rango <span class="cifra">SE${String(filtros.semanaDesde).padStart(2, '0')}–SE${String(filtros.semanaHasta).padStart(2, '0')}</span> del año <span class="cifra">${filtros.anio}</span> (serie ${filtros.serie}).</span>
          `;
        }
      };
      pintarResumen(filtros);
      moverSemana = (f) => {
        moverSeleccionMatriz(montado, configMatriz(f));
        pintarResumen(f);
      };
    } catch {
      if (idRevision !== revision) return;
      renderErrorFuente(contenedor, () => void renderizar(filtrosActuales));
      if (resumen)
        resumen.textContent =
          'No se pudo cargar el mapa de calor departamental.';
    } finally {
      contenedor.setAttribute('aria-busy', 'false');
    }
  }

  suscribirFiltrosAnalisis((filtros) => {
    filtrosActuales = filtros;
    void renderizar(filtros);
  });
</script>
