<article
  class="card-elevated rounded-2xl border border-border bg-surface p-5 sm:p-6"
>
  <header>
    <h3 class="font-sans text-base font-semibold text-ink">
      Presión por departamento y semana
    </h3>
    <p class="mt-1 font-sans text-xs leading-relaxed text-ink-muted">
      Percentil del conteo observado respecto a la historia del mismo
      departamento. Las celdas grises indican que falta la observación o que no
      hay historial suficiente para calcular el percentil.
    </p>
  </header>

  <div class="mt-4 overflow-x-auto">
    <div
      id="heatmap-departamentos"
      class="min-h-[420px] min-w-[760px]"
      role="region"
      aria-label="Heatmap de presión epidemiológica relativa por departamento y semana"
    >
    </div>
  </div>

  <div
    class="mt-3 flex flex-wrap items-center gap-2 font-sans text-[11px] text-ink-muted"
  >
    <span>Percentil 0</span>
    <span
      id="heatmap-leyenda-rampa"
      class="h-2.5 w-44 rounded-full ring-1 ring-black/10"
      aria-hidden="true"></span>
    <span>Percentil 100</span>
    <span class="ml-2 inline-flex items-center gap-1.5">
      <span class="h-2.5 w-2.5 rounded-sm bg-zinc-200 ring-1 ring-black/10"
      ></span> Sin dato
    </span>
  </div>
  <p
    id="heatmap-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
  >
  </p>
</article>

<script>
  import * as Plot from '@observablehq/plot';
  import { obtenerDatasetAnalitico } from '../../lib/analisis-api';
  import {
    actualizarFiltrosAnalisis,
    obtenerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import { colorPresion, gradienteCss, RAMPA_PRESION } from '../../lib/colores';
  import { debounce } from '../../lib/debounce';
  import { vincularMarcasPlot } from '../../lib/plot-interacciones';
  import type {
    FiltrosAnalisis,
    PresionAnalitica,
  } from '../../lib/tipos-analisis';

  interface CeldaHeatmap {
    codigo: string;
    departamento: string;
    semana: number;
    percentil: number | null;
    casos: number | null;
    presion: PresionAnalitica;
  }

  const contenedor = document.getElementById('heatmap-departamentos');
  const resumen = document.getElementById('heatmap-resumen');
  const leyenda = document.getElementById('heatmap-leyenda-rampa');
  if (leyenda) leyenda.style.background = gradienteCss(RAMPA_PRESION);

  let revision = 0;
  let filtrosActuales = obtenerFiltrosAnalisis();

  function textoCelda(celda: CeldaHeatmap, filtros: FiltrosAnalisis): string {
    if (celda.percentil === null) {
      return `${celda.departamento} · ${filtros.anio} · SE${String(celda.semana).padStart(2, '0')}\n${celda.presion.nota ?? 'Sin percentil disponible'}`;
    }
    return (
      `${celda.departamento} · ${filtros.anio} · SE${String(celda.semana).padStart(2, '0')}\n` +
      `Percentil: ${celda.percentil}\nCasos observados (${filtros.serie}): ${celda.casos ?? 'sin dato'}\n` +
      `P50/P75: ${celda.presion.p50_baseline} / ${celda.presion.p75_baseline}`
    );
  }

  async function renderizar(filtros: FiltrosAnalisis) {
    if (!contenedor) return;
    const idRevision = ++revision;
    if (resumen)
      resumen.textContent = `Cargando ${filtros.anio}, serie ${filtros.serie}…`;

    try {
      const datos = await obtenerDatasetAnalitico(filtros.anio);
      if (idRevision !== revision) return;
      const celdas: CeldaHeatmap[] = datos.departamentos.flatMap(
        (departamento) =>
          departamento.semanas
            .filter(
              (semana) =>
                semana.semana_epi >= filtros.semanaDesde &&
                semana.semana_epi <= filtros.semanaHasta,
            )
            .map((semana) => {
              const presion =
                filtros.serie === 'probable'
                  ? semana.presion_probable
                  : semana.presion_confirmado;
              return {
                codigo: departamento.codigo,
                departamento: departamento.nombre,
                semana: semana.semana_epi,
                percentil: presion.percentil,
                casos: presion.casos_observados,
                presion,
              };
            }),
      );
      const seleccion = celdas.filter(
        (celda) =>
          celda.semana === filtros.semana &&
          (!filtros.departamento || celda.codigo === filtros.departamento),
      );

      const grafica = Plot.plot({
        width: Math.max(contenedor.clientWidth, 760),
        height: 430,
        marginLeft: 110,
        marginBottom: 48,
        x: {
          domain: Array.from(
            { length: filtros.semanaHasta - filtros.semanaDesde + 1 },
            (_, indice) => filtros.semanaDesde + indice,
          ),
          label: 'Semana epidemiológica',
          tickFormat: (valor) => `SE${String(valor).padStart(2, '0')}`,
          ticks: 10,
        },
        y: {
          domain: datos.departamentos.map(
            (departamento) => departamento.nombre,
          ),
          label: null,
        },
        style: { background: 'transparent', color: 'var(--color-ink-muted)' },
        marks: [
          Plot.cell(celdas, {
            className: 'epi-heatmap-celdas',
            x: 'semana',
            y: 'departamento',
            fill: (celda: CeldaHeatmap) => colorPresion(celda.percentil),
            inset: 0.5,
            title: (celda: CeldaHeatmap) => textoCelda(celda, filtros),
          }),
          Plot.cell(seleccion, {
            x: 'semana',
            y: 'departamento',
            fill: 'none',
            stroke: 'var(--color-ink)',
            strokeWidth: 2,
            inset: 0.5,
            pointerEvents: 'none',
          }),
          Plot.frame({ stroke: 'var(--color-border)' }),
        ],
      });
      vincularMarcasPlot(
        grafica,
        '.epi-heatmap-celdas rect',
        celdas,
        (celda) => textoCelda(celda, filtros).replaceAll('\n', '. '),
        (celda) =>
          actualizarFiltrosAnalisis({
            departamento: celda.codigo,
            semana: celda.semana,
          }),
      );
      contenedor.replaceChildren(grafica);

      if (resumen) {
        const celdaActiva = filtros.departamento
          ? celdas.find(
              (celda) =>
                celda.codigo === filtros.departamento &&
                celda.semana === filtros.semana,
            )
          : null;
        resumen.textContent = celdaActiva
          ? textoCelda(celdaActiva, filtros).replaceAll('\n', ' · ')
          : `${datos.departamentos.length} departamentos · SE${String(filtros.semanaDesde).padStart(2, '0')}–SE${String(filtros.semanaHasta).padStart(2, '0')} · ${filtros.anio} · serie ${filtros.serie}.`;
      }
    } catch {
      if (idRevision !== revision) return;
      contenedor.replaceChildren();
      if (resumen)
        resumen.textContent = 'No fue posible cargar el heatmap departamental.';
    }
  }

  suscribirFiltrosAnalisis((filtros) => {
    filtrosActuales = filtros;
    void renderizar(filtros);
  });
  new ResizeObserver(
    debounce(() => void renderizar(filtrosActuales), 100),
  ).observe(contenedor!);
</script>
