---
import PanelWorkspace from './PanelWorkspace.astro';
---

<PanelWorkspace
  tipo="traza"
  titulo="Serie del departamento"
  descripcion="Los tres módulos descriptivos del departamento activo, semana a semana: presión epidemiológica relativa (M3), idoneidad biofísica contra su banda histórica (M1) y anomalía climática (M2). Cada uno compara al departamento con su propia historia; ninguno reparte un nivel de riesgo."
>
  <div
    data-vacio-serie
    class="mt-4 flex flex-col items-center justify-center rounded-xl border border-dashed border-border bg-bg/50 p-8 text-center"
  >
    <p class="font-sans text-sm text-ink-muted">
      Elige un departamento en el mapa o en Filtros para ver sus tres módulos
      temporales.
    </p>
    <button
      type="button"
      data-abrir-filtros-accion
      class="mt-3 rounded-lg border border-border bg-surface px-3 py-1.5 font-sans text-xs font-semibold text-accent transition-colors hover:border-accent/40"
    >
      Abrir filtros
    </button>
  </div>

  <div id="serie-departamento-grafica" class="mt-4 flex flex-col gap-5" hidden>
    <div
      id="serie-presion"
      class="min-h-[220px]"
      role="region"
      aria-label="Percentil de presión epidemiológica relativa por semana para el departamento activo"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[220px] w-full flex-col justify-around gap-4 p-4"
        aria-hidden="true"
      >
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
      </div>
    </div>
    <div
      id="serie-idoneidad"
      class="min-h-[220px]"
      role="region"
      aria-label="Idoneidad biofísica por semana contra la banda histórica del departamento activo"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[220px] w-full flex-col justify-around gap-4 p-4"
        aria-hidden="true"
      >
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
      </div>
    </div>
    <div
      id="serie-anomalia"
      class="min-h-[200px]"
      role="region"
      aria-label="Anomalía climática continua por semana para el departamento activo"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[200px] w-full flex-col justify-around gap-4 p-4"
        aria-hidden="true"
      >
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
        <div class="skeleton h-5 w-full rounded"></div>
      </div>
    </div>
  </div>

  <details
    id="serie-tabla-detalles"
    class="mt-3 rounded-xl border border-border bg-bg p-3"
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
    >
      Ver los datos en tabla
    </summary>
    <div id="serie-tabla-contenedor"></div>
  </details>

  <p
    id="serie-departamento-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
  </p>
  <p
    id="serie-departamento-aviso"
    class="mt-2 font-sans text-xs leading-relaxed text-ink-muted"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoTraza,
    renderSinDato,
  } from '../estado-async';
  import {
    obtenerSerieIdoneidad,
    obtenerSeriePresion,
  } from '../../lib/analisis-api';
  import {
    obtenerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import { ESTILO_PLOT, ejeSemana, marcoPlot } from '../../lib/plot-tema';
  import { TablaAlternativa } from '../../lib/tabla-alternativa';
  import {
    esAnioAnalisisDengue,
    notaAnioSoloClima,
  } from '../../lib/tipos-analisis';
  import type {
    FiltrosAnalisis,
    SemanaSerieIdoneidad,
    SemanaSeriePresion,
  } from '../../lib/tipos-analisis';

  const COLOR_ACENTO = 'var(--color-accent)';
  const COLOR_CONFIRMADO = '#2171b5';
  const COLOR_CONTEXTO = '#9ca3af';
  const COLOR_BANDA = 'var(--color-secondary)';

  const marco = document.getElementById('serie-departamento-grafica');
  const vacioContenedor =
    document.querySelector<HTMLElement>('[data-vacio-serie]');
  const nodoPresion = document.getElementById('serie-presion');
  const nodoIdoneidad = document.getElementById('serie-idoneidad');
  const nodoAnomalia = document.getElementById('serie-anomalia');
  const resumen = document.getElementById('serie-departamento-resumen');
  const avisoNodo = document.getElementById('serie-departamento-aviso');

  let revision = 0;
  let filtrosActuales = obtenerFiltrosAnalisis();
  type PlotNs = typeof import('@observablehq/plot');
  type Grafica = ReturnType<PlotNs['plot']>;
  let Plot: PlotNs | null = null;
  let datosTabla: any[] = [];

  const detailsTabla = document.getElementById(
    'serie-tabla-detalles',
  ) as HTMLDetailsElement | null;
  const contenedorTabla = document.getElementById('serie-tabla-contenedor');

  const tablaAlternativa =
    detailsTabla && contenedorTabla
      ? new TablaAlternativa({
          details: detailsTabla,
          contenedorTabla,
          caption: 'Series temporales del departamento por semana',
          columnas: [
            {
              clave: 'semana',
              encabezado: 'Semana',
              alineacion: 'derecha',
              formato: (v) => `SE${String(v).padStart(2, '0')}`,
            },
            {
              clave: 'probable',
              encabezado: 'Percentil probable',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? `${v}%` : '—'),
            },
            {
              clave: 'confirmado',
              encabezado: 'Percentil confirmado',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? `${v}%` : '—'),
            },
            {
              clave: 'iv',
              encabezado: 'Idoneidad (Iv)',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? Number(v).toFixed(2) : '—'),
            },
            {
              clave: 'anomalia',
              encabezado: 'Anomalía',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? Number(v).toFixed(2) : '—'),
            },
          ],
          obtenerDatos: () => datosTabla,
        })
      : null;

  vacioContenedor
    ?.querySelector('[data-abrir-filtros-accion]')
    ?.addEventListener('click', () => {
      document.getElementById('analisis-abrir-filtros')?.click();
    });

  function enRango(semana: number, filtros: FiltrosAnalisis) {
    return semana >= filtros.semanaDesde && semana <= filtros.semanaHasta;
  }

  function hayValores(valores: (number | null)[]): boolean {
    return valores.some((v) => v !== null && !Number.isNaN(v));
  }

  function marcadorSemana(P: PlotNs, filtros: FiltrosAnalisis) {
    return P.ruleX([filtros.semana], {
      stroke: 'var(--color-seleccion)',
      strokeWidth: 2,
      strokeOpacity: 0.6,
      strokeDasharray: '3,3',
    });
  }

  function graficaPresion(
    P: PlotNs,
    semanas: SemanaSeriePresion[],
    filtros: FiltrosAnalisis,
    ancho: number,
  ) {
    const datos = semanas
      .filter((s) => enRango(s.semana_epi, filtros))
      .map((s) => ({
        semana_epi: s.semana_epi,
        probable: s.probable.percentil,
        confirmado: s.confirmado.percentil,
      }));
    if (
      !hayValores([
        ...datos.map((s) => s.probable),
        ...datos.map((s) => s.confirmado),
      ])
    ) {
      return null;
    }
    return P.plot({
      width: ancho,
      height: 210,
      marginLeft: 52,
      marginBottom: 40,
      x: ejeSemana(filtros.semanaDesde, filtros.semanaHasta),
      y: {
        label: 'Percentil frente a su historia (0–100)',
        domain: [0, 100],
        grid: true,
      },
      style: ESTILO_PLOT,
      marks: [
        P.ruleY([50, 75], {
          stroke: COLOR_CONTEXTO,
          strokeOpacity: 0.5,
          strokeDasharray: '2,3',
        }),
        P.line(datos, {
          x: 'semana_epi',
          y: 'probable',
          stroke: COLOR_ACENTO,
          strokeWidth: 2.5,
        }),
        P.line(datos, {
          x: 'semana_epi',
          y: 'confirmado',
          stroke: COLOR_CONFIRMADO,
          strokeWidth: 2,
        }),
        P.dot(
          datos.filter((s) => s.probable !== null),
          {
            x: 'semana_epi',
            y: 'probable',
            fill: COLOR_ACENTO,
            r: 2.5,
            title: (s: (typeof datos)[number]) =>
              `SE${String(s.semana_epi).padStart(2, '0')} · probable p${
                s.probable ?? '—'
              } · confirmado p${s.confirmado ?? '—'}`,
          },
        ),
        marcadorSemana(P, filtros),
        marcoPlot(Plot!),
      ],
    });
  }

  function graficaIdoneidad(
    P: PlotNs,
    semanas: SemanaSerieIdoneidad[],
    filtros: FiltrosAnalisis,
    ancho: number,
  ) {
    const datos = semanas.filter((s) => enRango(s.semana_epi, filtros));
    if (!hayValores(datos.map((s) => s.iv_real))) return null;
    const banda = datos.filter(
      (s) => s.p25_baseline !== null && s.p75_baseline !== null,
    );
    return P.plot({
      width: ancho,
      height: 210,
      marginLeft: 52,
      marginBottom: 40,
      x: ejeSemana(filtros.semanaDesde, filtros.semanaHasta),
      y: { label: 'Iv (0–1)', grid: true, zero: true },
      style: ESTILO_PLOT,
      marks: [
        P.areaY(banda, {
          x: 'semana_epi',
          y1: 'p25_baseline',
          y2: 'p75_baseline',
          fill: COLOR_BANDA,
          fillOpacity: 0.5,
        }),
        P.line(datos, {
          x: 'semana_epi',
          y: 'iv_real',
          stroke: COLOR_ACENTO,
          strokeWidth: 2.5,
        }),
        P.dot(
          datos.filter((s) => s.iv_real !== null),
          {
            x: 'semana_epi',
            y: 'iv_real',
            fill: COLOR_ACENTO,
            r: 2.5,
            title: (s: SemanaSerieIdoneidad) =>
              `SE${String(s.semana_epi).padStart(2, '0')} · Iv ${
                s.iv_real ?? '—'
              } · banda P25–P75: ${s.p25_baseline ?? '—'} a ${
                s.p75_baseline ?? '—'
              }`,
          },
        ),
        marcadorSemana(P, filtros),
        marcoPlot(Plot!),
      ],
    });
  }

  function graficaAnomalia(
    P: PlotNs,
    semanas: SemanaSerieIdoneidad[],
    filtros: FiltrosAnalisis,
    ancho: number,
  ) {
    const datos = semanas.filter((s) => enRango(s.semana_epi, filtros));
    if (!hayValores(datos.map((s) => s.anomaly_sigma))) return null;
    return P.plot({
      width: ancho,
      height: 190,
      marginLeft: 52,
      marginBottom: 40,
      x: ejeSemana(filtros.semanaDesde, filtros.semanaHasta),
      y: { label: 'Anomalía (σ)', grid: true },
      style: ESTILO_PLOT,
      marks: [
        P.ruleY([0], { stroke: COLOR_CONTEXTO, strokeOpacity: 0.6 }),
        P.line(datos, {
          x: 'semana_epi',
          y: 'anomaly_sigma',
          stroke: '#e65100',
          strokeWidth: 2,
        }),
        P.dot(
          datos.filter((s) => s.anomaly_sigma !== null),
          {
            x: 'semana_epi',
            y: 'anomaly_sigma',
            fill: '#e65100',
            r: 2.5,
            title: (s: SemanaSerieIdoneidad) =>
              `SE${String(s.semana_epi).padStart(2, '0')} · anomalía ${
                s.anomaly_sigma !== null
                  ? `${s.anomaly_sigma.toFixed(2)} σ`
                  : 'sin dato'
              }`,
          },
        ),
        marcadorSemana(P, filtros),
        marcoPlot(Plot!),
      ],
    });
  }

  function pintar(
    nodo: HTMLElement | null,
    grafica: Grafica | null,
    esError: boolean,
    mensaje: string,
  ) {
    if (!nodo) return;
    nodo.setAttribute('aria-busy', 'false');
    if (grafica) {
      nodo.replaceChildren(grafica);
      return;
    }
    if (esError) {
      renderErrorFuente(nodo, () => void renderizar(filtrosActuales), mensaje);
    } else {
      renderSinDato(nodo, mensaje);
    }
  }

  async function renderizar(filtros: FiltrosAnalisis): Promise<void> {
    if (!marco || !resumen) return;
    const idRevision = ++revision;

    if (!filtros.departamento) {
      marco.hidden = true;
      if (vacioContenedor) vacioContenedor.hidden = false;
      resumen.textContent =
        'Selecciona un departamento en los filtros o en el mapa.';
      if (avisoNodo) avisoNodo.textContent = '';
      return;
    }

    if (vacioContenedor) vacioContenedor.hidden = true;
    marco.hidden = false;
    resumen.textContent = 'Cargando series del departamento…';

    if (nodoPresion) {
      nodoPresion.setAttribute('aria-busy', 'true');
      renderEsqueletoTraza(nodoPresion);
    }
    if (nodoIdoneidad) {
      nodoIdoneidad.setAttribute('aria-busy', 'true');
      renderEsqueletoTraza(nodoIdoneidad);
    }
    if (nodoAnomalia) {
      nodoAnomalia.setAttribute('aria-busy', 'true');
      renderEsqueletoTraza(nodoAnomalia);
    }

    if (!Plot) Plot = await import('@observablehq/plot');
    if (idRevision !== revision || !Plot) return;
    const P = Plot;

    const [resPresion, resIdoneidad] = await Promise.allSettled([
      obtenerSeriePresion(filtros.departamento, filtros.anio),
      obtenerSerieIdoneidad(filtros.departamento, filtros.anio),
    ]);
    if (idRevision !== revision) return;

    const ancho = Math.max(marco.clientWidth || 0, 320);
    const presion =
      resPresion.status === 'fulfilled' && !esNoDisponible(resPresion.value)
        ? resPresion.value
        : null;
    const idoneidad =
      resIdoneidad.status === 'fulfilled' && !esNoDisponible(resIdoneidad.value)
        ? resIdoneidad.value
        : null;

    if (resPresion.status === 'rejected') {
      pintar(
        nodoPresion,
        null,
        true,
        'No se pudo cargar la presión epidemiológica.',
      );
    } else if (
      resPresion.status === 'fulfilled' &&
      esNoDisponible(resPresion.value)
    ) {
      pintar(nodoPresion, null, false, motivoNoDisponible(resPresion.value));
    } else {
      pintar(
        nodoPresion,
        presion ? graficaPresion(P, presion.semanas, filtros, ancho) : null,
        false,
        'Sin presión epidemiológica para este año (los casos MINSAL se detienen en 2023).',
      );
    }

    if (resIdoneidad.status === 'rejected') {
      pintar(
        nodoIdoneidad,
        null,
        true,
        'No se pudo cargar la idoneidad biofísica.',
      );
      pintar(
        nodoAnomalia,
        null,
        true,
        'No se pudo cargar la anomalía climática.',
      );
    } else if (
      resIdoneidad.status === 'fulfilled' &&
      esNoDisponible(resIdoneidad.value)
    ) {
      pintar(
        nodoIdoneidad,
        null,
        false,
        motivoNoDisponible(resIdoneidad.value),
      );
      pintar(nodoAnomalia, null, false, motivoNoDisponible(resIdoneidad.value));
    } else {
      pintar(
        nodoIdoneidad,
        idoneidad
          ? graficaIdoneidad(P, idoneidad.semanas, filtros, ancho)
          : null,
        false,
        'Sin idoneidad biofísica para este departamento y año.',
      );
      pintar(
        nodoAnomalia,
        idoneidad
          ? graficaAnomalia(P, idoneidad.semanas, filtros, ancho)
          : null,
        false,
        'Sin anomalía climática para este departamento y año.',
      );
    }

    // Preparar datos para tabla alternativa
    const filasTabla: any[] = [];
    for (let sem = filtros.semanaDesde; sem <= filtros.semanaHasta; sem++) {
      const pSem = presion?.semanas.find((s) => s.semana_epi === sem);
      const iSem = idoneidad?.semanas.find((s) => s.semana_epi === sem);
      filasTabla.push({
        semana: sem,
        probable: pSem?.probable.percentil ?? null,
        confirmado: pSem?.confirmado.percentil ?? null,
        iv: iSem?.iv_real ?? null,
        anomalia: iSem?.anomaly_sigma ?? null,
      });
    }
    datosTabla = filasTabla;
    tablaAlternativa?.marcarCaducada();

    const nombre =
      idoneidad?.departamento_nombre ??
      presion?.departamento_nombre ??
      filtros.departamento;
    resumen.innerHTML = `<span><strong class="font-medium text-ink">${nombre}</strong> · año <span class="cifra">${filtros.anio}</span> · rango <span class="cifra">SE${String(
      filtros.semanaDesde,
    ).padStart(
      2,
      '0',
    )}–SE${String(filtros.semanaHasta).padStart(2, '0')}</span>.</span>`;

    if (avisoNodo) {
      const partes: string[] = [];
      if (!esAnioAnalisisDengue(filtros.anio)) {
        partes.push(notaAnioSoloClima(filtros.anio));
      }
      if (idoneidad?.aviso) partes.push(idoneidad.aviso);
      if (presion?.aviso) partes.push(presion.aviso);
      avisoNodo.textContent = partes.join(' · ');
    }
  }

  suscribirFiltrosAnalisis((filtros) => {
    filtrosActuales = filtros;
    void renderizar(filtros);
  });
  let ultimoAncho = 0;
  let timerResize: ReturnType<typeof setTimeout> | null = null;
  if (marco) {
    new ResizeObserver((entradas) => {
      const entrada = entradas[0];
      if (!entrada) return;
      const nuevoAncho = Math.round(entrada.contentRect.width);
      if (nuevoAncho === ultimoAncho) return;
      ultimoAncho = nuevoAncho;
      if (timerResize) clearTimeout(timerResize);
      timerResize = setTimeout(() => {
        void renderizar(filtrosActuales);
      }, 150);
    }).observe(marco);
  }
</script>
