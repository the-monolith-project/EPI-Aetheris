---
import LeyendaRampa from './LeyendaRampa.astro';
import PanelWorkspace from './PanelWorkspace.astro';
---

<PanelWorkspace
  tipo="matriz"
  titulo="Disponibilidad de observaciones"
  descripcion="Muestra qué semanas tienen dato MINSAL y cuáles no, por departamento."
>
  <LeyendaRampa
    modo="disponibilidad"
    descripcionLectores="Las celdas azules indican la presencia de una observación en la semana; las celdas grises indican ausencia de dato."
  />

  <div class="mt-4 overflow-x-auto scroll-shadow-x">
    <div
      id="disponibilidad-datos"
      class="min-h-[390px] min-w-[900px]"
      role="region"
      aria-label="Mapa de calor de disponibilidad de observaciones por departamento y semana"
      aria-busy="true"
    >
      <div
        class="flex h-full min-h-[390px] w-full min-w-[900px] flex-col justify-between gap-2.5 p-2"
        aria-hidden="true"
      >
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
        <div class="skeleton h-7 w-full rounded"></div>
      </div>
    </div>
  </div>

  <details
    id="disponibilidad-tabla-detalles"
    class="mt-3 rounded-xl border border-border bg-bg p-3"
  >
    <summary
      class="cursor-pointer font-sans text-xs font-medium text-ink-muted hover:text-ink"
    >
      Ver los datos en tabla
    </summary>
    <div id="disponibilidad-tabla-contenedor"></div>
  </details>

  <p
    id="disponibilidad-datos-resumen"
    class="mt-3 font-sans text-xs text-ink-muted"
    role="status"
    slot="pie"
  >
  </p>
</PanelWorkspace>

<script>
  let Plot: typeof import('@observablehq/plot') | null = null;
  import {
    esNoDisponible,
    motivoNoDisponible,
    renderErrorFuente,
    renderEsqueletoMatriz,
    renderSinDato,
  } from '../estado-async';
  import { obtenerDatasetAnalitico } from '../../lib/analisis-api';
  import {
    actualizarFiltrosAnalisis,
    obtenerFiltrosAnalisis,
    suscribirFiltrosAnalisis,
  } from '../../lib/analisis-state';
  import { COLOR_DATO_DISPONIBLE, COLOR_SIN_DATO } from '../../lib/colores';
  import { ESTILO_PLOT, marcoPlot } from '../../lib/plot-tema';
  import { vincularMarcasPlot } from '../../lib/plot-interacciones';
  import { TablaAlternativa } from '../../lib/tabla-alternativa';
  import {
    esAnioAnalisisDengue,
    notaAnioSoloClima,
    type FiltrosAnalisis,
  } from '../../lib/tipos-analisis';

  interface CeldaDisponibilidad {
    codigo: string;
    departamento: string;
    semana: number;
    casos: number | null;
  }

  const contenedor = document.getElementById('disponibilidad-datos');
  const resumen = document.getElementById('disponibilidad-datos-resumen');
  let revision = 0;
  let filtrosActuales = obtenerFiltrosAnalisis();
  let datosTabla: CeldaDisponibilidad[] = [];

  const detailsTabla = document.getElementById(
    'disponibilidad-tabla-detalles',
  ) as HTMLDetailsElement | null;
  const contenedorTabla = document.getElementById(
    'disponibilidad-tabla-contenedor',
  );

  const tablaAlternativa =
    detailsTabla && contenedorTabla
      ? new TablaAlternativa({
          details: detailsTabla,
          contenedorTabla,
          caption: 'Disponibilidad de observaciones por departamento y semana',
          columnas: [
            { clave: 'departamento', encabezado: 'Departamento' },
            {
              clave: 'semana',
              encabezado: 'Semana',
              alineacion: 'derecha',
              formato: (v) => `SE${String(v).padStart(2, '0')}`,
            },
            {
              clave: 'casos',
              encabezado: 'Estado de observación',
              alineacion: 'derecha',
              formato: (v) => (v !== null ? `${v} casos` : 'Sin dato'),
            },
          ],
          obtenerDatos: () => datosTabla,
        })
      : null;

  function etiqueta(celda: CeldaDisponibilidad, serie: string): string {
    const semana = `SE${String(celda.semana).padStart(2, '0')}`;
    if (celda.casos === null) {
      return `${celda.departamento}, ${semana}: dato ${serie} ausente`;
    }
    return `${celda.departamento}, ${semana}: dato ${serie} disponible, ${celda.casos} casos observados`;
  }

  async function renderizar(filtros: FiltrosAnalisis) {
    if (!contenedor) return;
    const idRevision = ++revision;
    if (resumen) resumen.textContent = 'Cargando cobertura semanal…';

    if (!esAnioAnalisisDengue(filtros.anio)) {
      renderSinDato(contenedor, notaAnioSoloClima(filtros.anio));
      if (resumen) resumen.textContent = notaAnioSoloClima(filtros.anio);
      contenedor.setAttribute('aria-busy', 'false');
      return;
    }

    contenedor.setAttribute('aria-busy', 'true');
    renderEsqueletoMatriz(contenedor, 7);
    try {
      const dataset = await obtenerDatasetAnalitico(filtros.anio);
      if (idRevision !== revision) return;
      if (esNoDisponible(dataset)) {
        renderSinDato(contenedor, motivoNoDisponible(dataset));
        return;
      }
      const celdas: CeldaDisponibilidad[] = dataset.departamentos.flatMap(
        (departamento) =>
          departamento.semanas
            .filter(
              (semana) =>
                semana.semana_epi >= filtros.semanaDesde &&
                semana.semana_epi <= filtros.semanaHasta,
            )
            .map((semana) => ({
              codigo: departamento.codigo,
              departamento: departamento.nombre,
              semana: semana.semana_epi,
              casos: semana[filtros.serie],
            })),
      );
      const seleccion = celdas.filter(
        (celda) =>
          celda.codigo === filtros.departamento &&
          celda.semana === filtros.semana,
      );

      datosTabla = celdas;
      tablaAlternativa?.marcarCaducada();

      const grafica = Plot!.plot({
        width: Math.max(contenedor.clientWidth, 900),
        height: 400,
        marginLeft: 115,
        marginBottom: 48,
        x: {
          domain: [filtros.semanaDesde, filtros.semanaHasta],
          label: 'Semana epidemiológica',
          tickFormat: (valor) => `SE${String(valor).padStart(2, '0')}`,
          ticks: 12,
        },
        y: {
          domain: dataset.departamentos.map(
            (departamento) => departamento.nombre,
          ),
          label: null,
        },
        style: ESTILO_PLOT,
        marks: [
          Plot.cell(celdas, {
            className: 'epi-disponibilidad-celdas',
            x: 'semana',
            y: 'departamento',
            fill: (celda: CeldaDisponibilidad) =>
              celda.casos === null ? COLOR_SIN_DATO : COLOR_DATO_DISPONIBLE,
            inset: 0.75,
            title: (celda: CeldaDisponibilidad) =>
              etiqueta(celda, filtros.serie),
          }),
          Plot.cell(seleccion, {
            x: 'semana',
            y: 'departamento',
            fill: 'none',
            stroke: 'var(--color-seleccion)',
            strokeWidth: 2,
            inset: 0.5,
            pointerEvents: 'none',
          }),
          marcoPlot(Plot!),
        ],
      });
      vincularMarcasPlot(
        grafica,
        '.epi-disponibilidad-celdas rect',
        celdas,
        (celda) => etiqueta(celda, filtros.serie),
        (celda) =>
          actualizarFiltrosAnalisis({
            departamento: celda.codigo,
            semana: celda.semana,
          }),
      );
      contenedor.replaceChildren(grafica);

      if (resumen) {
        const disponibles = celdas.filter(
          (celda) => celda.casos !== null,
        ).length;
        resumen.innerHTML = `<span>Año <span class="cifra">${filtros.anio}</span> · serie ${filtros.serie} · <span class="cifra font-semibold text-accent">${disponibles}/${celdas.length}</span> celdas con observación en <span class="cifra">SE${String(filtros.semanaDesde).padStart(2, '0')}–SE${String(filtros.semanaHasta).padStart(2, '0')}</span>.</span>`;
      }
    } catch {
      if (idRevision !== revision) return;
      renderErrorFuente(contenedor, () => void renderizar(filtrosActuales));
      if (resumen)
        resumen.textContent = 'No se pudo cargar la disponibilidad de datos.';
    } finally {
      contenedor.setAttribute('aria-busy', 'false');
    }
  }

  let activado = false;
  async function activar() {
    if (activado || !contenedor) return;
    activado = true;
    Plot = await import('@observablehq/plot');
    suscribirFiltrosAnalisis((filtros) => {
      filtrosActuales = filtros;
      void renderizar(filtros);
    });

    let ultimoAncho = 0;
    let timerResize: ReturnType<typeof setTimeout> | null = null;
    new ResizeObserver((entradas) => {
      const entrada = entradas[0];
      if (!entrada) return;
      const nuevoAncho = Math.round(entrada.contentRect.width);
      if (nuevoAncho === ultimoAncho) return;
      ultimoAncho = nuevoAncho;
      if (timerResize) clearTimeout(timerResize);
      timerResize = setTimeout(() => {
        void renderizar(filtrosActuales);
      }, 150);
    }).observe(contenedor);
  }

  const panel = contenedor?.closest('[data-panel-workspace]') ?? contenedor;
  if (panel) {
    const io = new IntersectionObserver((entradas) => {
      if (entradas.some((entrada) => entrada.isIntersecting)) {
        io.disconnect();
        void activar();
      }
    });
    io.observe(panel);
  } else {
    void activar();
  }
</script>
