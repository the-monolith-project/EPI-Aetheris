---
// Heatmap departamento × semana de Neumonías. Una métrica: conteo notificado.
// Celda sin dato = hueco, nunca cero.
---

<section
  class="card-elevated rounded-2xl border border-border bg-surface p-5 sm:p-6"
  data-heatmap-neu
>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-start gap-3">
      <span
        class="mt-1 h-6 w-1 shrink-0 rounded-full bg-accent"
        aria-hidden="true"></span>
      <div>
        <h2 class="font-sans text-base font-semibold text-ink sm:text-lg">
          Heatmap Neumonías — departamento × semana
        </h2>
        <p
          class="mt-1 max-w-3xl font-sans text-sm leading-relaxed text-ink-muted"
        >
          Unidad: conteo notificado (desacumulado). Celdas claras = hueco de la
          fuente MINSAL, no un cero. Más oscuro no significa mayor riesgo.
        </p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2 font-sans text-sm">
      <label class="flex items-center gap-2"
        >Año
        <select
          data-hm-anio
          class="rounded-lg border border-border bg-bg px-3 py-1.5"
        >
          <option value="2023">2023</option>
          <option value="2022">2022</option>
          <option value="2021">2021</option>
          <option value="2019">2019</option>
          <option value="2018">2018</option>
        </select>
      </label>
      <label class="flex items-center gap-2"
        >SE
        <input data-hm-desde type="range" min="1" max="52" value="1" />
        <input data-hm-hasta type="range" min="1" max="52" value="52" />
        <span data-hm-rango class="font-mono text-xs">SE1–SE52</span>
      </label>
      <button
        type="button"
        data-hm-export
        class="rounded-lg border border-border bg-bg px-3 py-1.5 text-ink"
      >
        Exportar CSV
      </button>
    </div>
  </div>
  <div
    data-hm-error
    class="mt-3 hidden rounded-lg border border-secondary bg-secondary/25 p-3 font-sans text-sm"
  >
    No se pudo cargar el heatmap. No se muestra ningún dato sustituto.
  </div>
  <div data-hm-grid class="mt-4 overflow-x-auto"></div>
</section>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const RAMPA = ['#cde2fb', '#9ec5f4', '#5598e7', '#256abf', '#0d366b'];
  const SIN_DATO = '#f4f4f5';

  interface DeptoHeat {
    nombre: string;
    codigo: string;
    semanas: Record<string, number | null>;
  }

  let ultimo: { anio: string; departamentos: DeptoHeat[] } | null = null;

  function rangoActivo(root: HTMLElement): { desde: number; hasta: number } {
    const inpDesde = root.querySelector<HTMLInputElement>('[data-hm-desde]')!;
    const inpHasta = root.querySelector<HTMLInputElement>('[data-hm-hasta]')!;
    let desde = Number(inpDesde.value);
    let hasta = Number(inpHasta.value);
    if (desde > hasta) [desde, hasta] = [hasta, desde];
    return { desde, hasta };
  }

  function color(valor: number, max: number): string {
    if (max <= 0) return RAMPA[0];
    const t = valor / max;
    const i = Math.min(RAMPA.length - 1, Math.floor(t * RAMPA.length));
    return RAMPA[i];
  }

  async function pintar() {
    const root = document.querySelector<HTMLElement>('[data-heatmap-neu]');
    if (!root) return;
    const sel = root.querySelector<HTMLSelectElement>('[data-hm-anio]')!;
    const grid = root.querySelector<HTMLElement>('[data-hm-grid]')!;
    const error = root.querySelector<HTMLElement>('[data-hm-error]')!;
    const inpDesde = root.querySelector<HTMLInputElement>('[data-hm-desde]')!;
    const inpHasta = root.querySelector<HTMLInputElement>('[data-hm-hasta]')!;
    const txtRango = root.querySelector<HTMLElement>('[data-hm-rango]')!;
    let desde = Number(inpDesde.value);
    let hasta = Number(inpHasta.value);
    if (desde > hasta) [desde, hasta] = [hasta, desde];
    txtRango.textContent = `SE${desde}–SE${hasta}`;
    const anio = sel.value;
    grid.textContent = 'Cargando…';
    try {
      const resp = await fetch(`${API_BASE}/api/neumonias/heatmap/${anio}`);
      if (!resp.ok) throw new Error('no ok');
      const datos = await resp.json();
      const departamentos: DeptoHeat[] = datos.departamentos;
      ultimo = { anio, departamentos };
      error.classList.add('hidden');

      let max = 0;
      for (const d of departamentos) {
        for (let s = desde; s <= hasta; s++) {
          const v = d.semanas[String(s)];
          if (v != null && v > max) max = v;
        }
      }

      const table = document.createElement('table');
      table.className = 'border-collapse font-mono text-[10px]';
      const thead = document.createElement('thead');
      const trh = document.createElement('tr');
      const th0 = document.createElement('th');
      th0.className =
        'pr-2 text-left font-sans text-xs text-ink sticky left-0 bg-surface';
      th0.textContent = 'Departamento';
      trh.appendChild(th0);
      for (let s = desde; s <= hasta; s++) {
        const th = document.createElement('th');
        th.className = 'px-0.5 font-sans text-ink-muted';
        th.textContent = String(s);
        trh.appendChild(th);
      }
      thead.appendChild(trh);
      table.appendChild(thead);
      const tbody = document.createElement('tbody');
      for (const d of departamentos) {
        const tr = document.createElement('tr');
        const name = document.createElement('td');
        name.className =
          'pr-2 font-sans text-xs text-ink sticky left-0 bg-surface';
        name.textContent = d.nombre;
        tr.appendChild(name);
        for (let s = desde; s <= hasta; s++) {
          const td = document.createElement('td');
          const v = d.semanas[String(s)];
          td.style.width = '14px';
          td.style.height = '18px';
          if (v == null) {
            td.style.background = SIN_DATO;
            td.title = `${d.nombre} SE${s} ${anio}: sin dato`;
          } else {
            td.style.background = color(v, max);
            td.title = `${d.nombre} SE${s} ${anio}: ${v} notificados`;
          }
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
      }
      table.appendChild(tbody);
      const nota = document.createElement('p');
      nota.className = 'mt-2 font-sans text-xs text-ink-muted';
      nota.textContent = `Conteo notificado · ${anio} · SE${desde}–SE${hasta} · MINSAL. Claro = hueco. Escala única de conteo, no positividad.`;
      grid.replaceChildren(table, nota);
    } catch {
      error.classList.remove('hidden');
      grid.textContent = '';
      ultimo = null;
    }
  }

  function exportar() {
    const root = document.querySelector<HTMLElement>('[data-heatmap-neu]');
    if (!ultimo || !root) return;
    const { desde, hasta } = rangoActivo(root);
    const lineas = ['anio,departamento,codigo,semana,valor'];
    for (const d of ultimo.departamentos) {
      for (let s = desde; s <= hasta; s++) {
        const v = d.semanas[String(s)];
        lineas.push(
          `${ultimo.anio},${d.nombre},${d.codigo},${s},${v == null ? '' : v}`,
        );
      }
    }
    const blob = new Blob([lineas.join('\n')], {
      type: 'text/csv;charset=utf-8',
    });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `neumonias-heatmap-${ultimo.anio}-SE${desde}-${hasta}.csv`;
    a.click();
    URL.revokeObjectURL(a.href);
  }

  const root = document.querySelector<HTMLElement>('[data-heatmap-neu]');
  if (root) {
    root
      .querySelector('[data-hm-anio]')
      ?.addEventListener('change', () => void pintar());
    root
      .querySelector('[data-hm-desde]')
      ?.addEventListener('input', () => void pintar());
    root
      .querySelector('[data-hm-hasta]')
      ?.addEventListener('input', () => void pintar());
    root.querySelector('[data-hm-export]')?.addEventListener('click', exportar);
    void pintar();
  }
</script>
