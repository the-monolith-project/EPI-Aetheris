---
// Mapa departamental -- selector de capas DESCRIPTIVAS (Camino Ancho v3,
// docs/contexto). Leaflet necesita el DOM del navegador (no hay forma de
// renderizarlo en el servidor), así que todo el trabajo con L.* vive en el
// <script> de abajo, que Astro procesa y ejecuta solo en el cliente. No se
// agregó React/Preact para esto -- un componente .astro + <script> ya
// resuelve "solo en el navegador" sin sumar un framework de UI nuevo.
//
// Ninguna de las capas es salida del clasificador de riesgo (ese vive en
// MetricasModelo.astro, a nivel nacional). Todas son descriptivas: volumen
// de casos MINSAL, idoneidad biofísica, anomalía climática continua,
// presión epidemiológica relativa (M3, dos series separadas), y una capa
// todavía no implementada (índice de confianza de vigilancia) que se
// muestra deshabilitada ("próximamente") en vez de inventar una fórmula.
//
// La capa de anomalía climática es deliberadamente NO un semáforo de
// alerta -- este proyecto retiró un diseño de alerta binaria porque se
// demostró empíricamente que no discriminaba nada. Escala continua,
// colores neutros (azul/gris/naranja), sin rojo de urgencia ni lenguaje de
// "cruce de umbral".
---

<section class="card-elevated rounded-2xl border border-border bg-surface p-5 sm:p-6">
  <div class="flex items-start gap-3">
    <span class="mt-1 h-6 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
    <div>
      <h2 class="font-sans text-base font-semibold text-ink sm:text-lg">Mapa departamental</h2>
      <p class="mt-1 font-sans text-sm leading-relaxed text-ink-muted">
        Capas descriptivas, no de riesgo: describen lo ya observado (casos, ambiente) contra la
        propia historia de cada departamento. Ninguna capa es salida de un clasificador ni implica
        una lectura de riesgo departamental -- el clasificador nacional piloto fue retirado y queda
        solo como referencia histórica al final de la página.
      </p>
    </div>
  </div>

  <div class="mt-4 flex gap-2 rounded-lg border border-dashed border-border bg-bg p-3">
    <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path
        d="M4 6h12M4 10h12M4 14h8"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
    </svg>
    <p class="font-sans text-xs leading-relaxed text-ink-muted">
      <strong class="font-semibold text-ink">Cómo leer los colores:</strong> cada capa compara el
      departamento contra <strong class="text-ink">su propia historia</strong> -- oscuro/naranja no
      significa "riesgo", significa "más inusual que lo normal para ese departamento en esa
      semana". Ningún color es una alerta ni un pronóstico.
    </p>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2 rounded-lg border border-border bg-bg p-3">
    <label for="mapa-semana" class="font-sans text-xs font-semibold uppercase tracking-wide text-ink-muted">
      Semana epidemiológica
    </label>
    <select
      id="mapa-semana"
      class="rounded-lg border border-border bg-surface px-2 py-1 font-mono text-xs text-ink"
      aria-label="Semana epidemiológica"
    >
      {Array.from({ length: 53 }, (_, i) => i + 1).map((s) => (
        <option value={s} selected={s === 1}>
          SE{String(s).padStart(2, '0')}
        </option>
      ))}
    </select>
    <label for="mapa-anio" class="font-sans text-xs font-semibold uppercase tracking-wide text-ink-muted">
      Año
    </label>
    <select
      id="mapa-anio"
      class="rounded-lg border border-border bg-surface px-2 py-1 font-mono text-xs text-ink"
      aria-label="Año"
    >
      {[2018, 2019, 2021, 2022, 2023].map((a) => (
        <option value={a} selected={a === 2023}>
          {a}
        </option>
      ))}
    </select>
    <span class="font-sans text-xs text-ink-muted">
      Afecta Iv, anomalía y presión -- volumen MINSAL siempre muestra el acumulado 2018-2023.
    </span>
  </div>

  <div id="mapa-selector" class="mt-4 flex flex-wrap gap-2" role="tablist" aria-label="Capas del mapa"></div>

  <div class="mt-3 flex gap-2 rounded-lg border border-border bg-bg p-3">
    <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="10" cy="10" r="8.25" stroke="currentColor" stroke-width="1.5" />
      <path d="M10 9v4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="10" cy="6.75" r="0.9" fill="currentColor" />
    </svg>
    <div>
      <p class="font-sans text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
        Aviso de la capa
      </p>
      <p id="mapa-aviso" class="mt-0.5 font-sans text-sm text-ink"></p>
    </div>
  </div>

  <div id="mapa-no-disponible" class="mt-2 hidden rounded-lg border border-secondary bg-secondary/25 p-3">
    <div class="flex gap-2">
      <svg class="mt-0.5 h-4 w-4 shrink-0 text-secondary-ink" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d="M10 2.5 18 16.5H2L10 2.5Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path d="M10 8v3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <circle cx="10" cy="14" r="0.9" fill="currentColor" />
      </svg>
      <p class="font-sans text-sm text-ink">
        Capa no disponible todavía -- el endpoint del backend para esta capa no respondió como se
        esperaba. El mapa se muestra sin colorear (gris = sin dato) hasta que esté listo.
      </p>
    </div>
  </div>

  <div
    id="mapa-departamentos"
    class="mt-4 h-[300px] w-full overflow-hidden rounded-xl border border-border shadow-inner sm:h-[420px] lg:h-[540px]"
  >
  </div>
  <div id="mapa-leyenda" class="mt-3"></div>

  <div id="mapa-detalle" class="mt-4 hidden rounded-xl border border-accent/30 bg-secondary/20 p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="font-sans text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
          Detalle de departamento
        </p>
        <h3 id="mapa-detalle-nombre" class="mt-0.5 font-display text-lg font-semibold text-ink"></h3>
      </div>
      <button
        type="button"
        id="mapa-detalle-cerrar"
        class="rounded-full border border-border bg-surface px-2.5 py-1 font-sans text-xs text-ink-muted transition-colors hover:border-accent/40 hover:text-ink"
        aria-label="Cerrar detalle de departamento"
      >
        Cerrar
      </button>
    </div>

    <dl id="mapa-detalle-snapshot" class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4"></dl>

    <div class="mt-4">
      <p class="font-sans text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
        Idoneidad biofísica (Iv) -- banda histórica P25-P75 vs. el año seleccionado
      </p>
      <div id="mapa-detalle-curva" class="mt-2 h-24 w-full">
        <div class="skeleton h-full w-full" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <div class="mt-4 rounded-lg border border-border bg-bg p-3">
    <p class="font-sans text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
      Nota sobre calidad de la vigilancia departamental
    </p>
    <p class="mt-1 font-sans text-sm leading-relaxed text-ink-muted">
      Tres hallazgos independientes de este proyecto apuntan a que la escasez de datos
      departamentales de MINSAL es una limitación estructural de la fuente, no un defecto
      corregible del pipeline (huecos por semanas festivas, tablas en imagen sin OCR general, y
      cobertura real de ~49/52 semanas por año). La capa "Índice de confianza de vigilancia"
      (más abajo, todavía no implementada) busca hacer esa limitación visible en vez de
      ocultarla detrás de un mapa que luce completo.
    </p>
  </div>
</section>

<style>
  :global(.leaflet-container) {
    font-family: var(--font-sans);
    background: var(--color-bg);
    /* Los controles internos de Leaflet (.leaflet-top, .leaflet-control)
       usan z-index: 1000 -- sin esto, ese valor compite directamente contra
       el z-40 del header sticky de Layout.astro y gana, así que al hacer
       scroll el zoom del mapa se dibuja encima del header. isolation
       confina el z-index de Leaflet dentro de su propio contexto de
       apilamiento, sin tocar los valores internos de la librería. */
    isolation: isolate;
  }
  :global(.leaflet-control-zoom) {
    border: 1px solid var(--color-border) !important;
    box-shadow: var(--shadow-card) !important;
  }
  :global(.leaflet-control-zoom a) {
    color: var(--color-accent) !important;
    background-color: var(--color-surface) !important;
  }
  :global(.leaflet-control-zoom a:hover) {
    background-color: var(--color-secondary) !important;
  }
  :global(.leaflet-tooltip) {
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-ink);
    padding: 6px 10px;
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  // ---------------------------------------------------------------------
  // Tipos y datos compartidos
  // ---------------------------------------------------------------------

  type IdCapa = 'minsal_volumen' | 'iv' | 'anomalia' | 'presion_probable' | 'presion_confirmado' | 'confianza';

  interface DefinicionCapa {
    id: IdCapa;
    etiqueta: string;
    disponible: boolean; // false => botón deshabilitado, "próximamente"
    aviso: string;
    tituloLeyenda: string;
    rampa: string[];
    sinDatoColor: string;
    // Carga los valores por código de departamento. undefined = sin dato
    // para ese departamento (se pinta con sinDatoColor). null de retorno
    // completo = falla de fetch / capa no disponible en el backend todavía.
    cargarValores: () => Promise<Map<string, number | undefined> | null>;
    calcularCortes: (valores: number[]) => number[];
    etiquetasLeyenda: (cortes: number[]) => string[];
    tooltipValor: (valor: number | undefined) => string;
  }

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const SIN_DATO = '#e4e4e7';

  // El shapeName del geojson (geoBoundaries) es inconsistente: 12 de los 14
  // departamentos traen el prefijo "Departamento de ..." pero La Libertad y
  // San Vicente no -- se ve como un error tipográfico en los tooltips si no
  // se normaliza en un solo lugar. Mismo criterio que index.astro (el hero
  // de la landing ya lo aplicaba, esto lo extiende a los tooltips del mapa).
  function normalizarNombreDepto(shapeName: string): string {
    return shapeName.replace(/^Departamento de /, '');
  }

  // Semana/año de las capas espaciales -- mutables porque ahora hay
  // selectores reales (#mapa-semana / #mapa-anio) en vez del compromiso de
  // "primera versión, semana fija" que sigue teniendo MetricasModelo.astro.
  let SEMANA_ESPACIAL = 1;
  let ANIO_ESPACIAL = 2023;

  // ---------------------------------------------------------------------
  // Funciones genéricas de color / cortes / leyenda, reutilizadas por todas
  // las capas -- cada capa solo aporta su rampa, sus cortes y sus textos.
  // ---------------------------------------------------------------------

  function cortesPorCuantiles(valores: number[]): number[] {
    const ordenados = [...valores].sort((a, b) => a - b);
    if (ordenados.length === 0) return [1, 2, 3, 4];
    const corte = (p: number) => ordenados[Math.min(ordenados.length - 1, Math.floor(p * (ordenados.length - 1)))];
    return [corte(0.2), corte(0.4), corte(0.6), corte(0.8)];
  }

  function colorGenerico(valor: number | undefined, cortes: number[], rampa: string[], sinDato: string): string {
    if (valor === undefined) return sinDato;
    for (let i = 0; i < cortes.length; i++) {
      if (valor <= cortes[i]) return rampa[i];
    }
    return rampa[rampa.length - 1];
  }

  function dibujarLeyenda(contenedor: HTMLElement, capa: DefinicionCapa, cortes: number[]) {
    const rangos = capa.etiquetasLeyenda(cortes);
    const item = (color: string, etiqueta: string) =>
      `<span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-2 py-1">` +
      `<span style="background:${color}" class="inline-block h-2.5 w-2.5 rounded-full ring-1 ring-black/5"></span>` +
      `<span class="font-mono text-[11px] text-ink-muted">${etiqueta}</span></span>`;
    const items = capa.rampa.map((color, i) => item(color, rangos[i])).join('');
    contenedor.innerHTML = `
      <div class="flex flex-wrap items-center gap-1.5 font-sans text-xs text-ink-muted">
        <span class="mr-1 font-medium text-ink">${capa.tituloLeyenda}:</span>
        ${items}
        ${item(capa.sinDatoColor, 'sin dato')}
      </div>
    `;
  }

  // ---------------------------------------------------------------------
  // Capa 1: volumen de casos MINSAL -- ya funcionaba, mismo comportamiento,
  // ahora expresado en la forma genérica de DefinicionCapa.
  // ---------------------------------------------------------------------

  interface DatoDepartamentoMinsal {
    nombre: string;
    codigo: string;
    probable_total: number;
    confirmado_total: number;
    semanas_con_dato_probable: number;
    primer_anio: number | null;
    ultimo_anio: number | null;
  }

  let detallesMinsal = new Map<string, DatoDepartamentoMinsal>();

  const RAMPA_MINSAL = ['#cde2fb', '#9ec5f4', '#5598e7', '#256abf', '#0d366b'];

  const capaMinsal: DefinicionCapa = {
    id: 'minsal_volumen',
    etiqueta: 'Volumen de casos (MINSAL)',
    disponible: true,
    aviso:
      'El color representa volumen de casos "probable" reportado por MINSAL, acumulado ' +
      '2018-2023 -- no una clasificación de riesgo por departamento. No alimenta ningún modelo.',
    tituloLeyenda: 'Casos "probable" acumulados 2018-2023',
    rampa: RAMPA_MINSAL,
    sinDatoColor: SIN_DATO,
    async cargarValores() {
      const resp = await fetch(`${API_BASE}/api/casos-departamentales`);
      if (!resp.ok) return null;
      const datos: { departamentos: DatoDepartamentoMinsal[] } = await resp.json();
      detallesMinsal = new Map(datos.departamentos.map((d) => [d.codigo, d]));
      const valores = new Map<string, number | undefined>();
      for (const d of datos.departamentos) {
        valores.set(d.codigo, d.probable_total > 0 ? d.probable_total : undefined);
      }
      return valores;
    },
    calcularCortes: cortesPorCuantiles,
    etiquetasLeyenda(cortes) {
      return [
        `1–${cortes[0]}`,
        `${cortes[0] + 1}–${cortes[1]}`,
        `${cortes[1] + 1}–${cortes[2]}`,
        `${cortes[2] + 1}–${cortes[3]}`,
        `> ${cortes[3]}`,
      ];
    },
    tooltipValor(valor) {
      return valor === undefined ? 'sin dato' : `${valor}`;
    },
  };

  // ---------------------------------------------------------------------
  // Capas 2 y 3: idoneidad biofísica (Iv) y anomalía climática continua --
  // ambas vienen del mismo endpoint espacial, GET /api/v1/spatial/current.
  // El backend todavía no está mergeado (equipo en paralelo); el fetch se
  // aísla en una sola función con caché de un único intento, y el parseo de
  // nombres de campo vive en un único lugar para que un cambio de contrato
  // sea un ajuste de una línea.
  // ---------------------------------------------------------------------

  interface DatoEspacial {
    codigo: string;
    iv: number | undefined;
    anomalia_sigma: number | undefined;
  }

  let cacheEspacial: Promise<Map<string, DatoEspacial> | null> | null = null;

  // Último resultado resuelto del endpoint espacial, para que el tooltip
  // unificado de Camino Ancho pueda leerlo de forma síncrona.
  let detallesEspacial = new Map<string, DatoEspacial>();

  // Único lugar que conoce la forma exacta de la respuesta del backend.
  // Contrato asumido (no confirmado): { departamentos: [{ codigo, iv,
  // anomalia_sigma }] }. Si el contrato real usa otros nombres, este es el
  // único bloque a tocar.
  function parsearRespuestaEspacial(json: unknown): Map<string, DatoEspacial> | null {
    if (!json || typeof json !== 'object' || !Array.isArray((json as any).departamentos)) return null;
    const mapa = new Map<string, DatoEspacial>();
    for (const fila of (json as any).departamentos) {
      const codigo = fila?.codigo;
      if (typeof codigo !== 'string') continue;
      const iv = typeof fila?.iv === 'number' ? fila.iv : undefined;
      // El backend devuelve "anomaly_sigma" (inglés, ver GET
      // /api/v1/spatial/current en main.py) -- bug real encontrado al
      // conectar el selector de semana/año: esto leía "anomalia_sigma"
      // (español) y siempre caía en undefined, así que la capa de anomalía
      // mostraba "sin dato" en todos los departamentos sin importar la
      // semana pedida.
      const anomalia = typeof fila?.anomaly_sigma === 'number' ? fila.anomaly_sigma : undefined;
      mapa.set(codigo, { codigo, iv, anomalia_sigma: anomalia });
    }
    return mapa;
  }

  async function obtenerDatosEspaciales(): Promise<Map<string, DatoEspacial> | null> {
    if (!cacheEspacial) {
      cacheEspacial = (async () => {
        try {
          const resp = await fetch(
            `${API_BASE}/api/v1/spatial/current?week=${SEMANA_ESPACIAL}&year=${ANIO_ESPACIAL}`
          );
          if (!resp.ok) return null;
          const mapa = parsearRespuestaEspacial(await resp.json());
          if (mapa) detallesEspacial = mapa;
          return mapa;
        } catch {
          return null;
        }
      })();
    }
    return cacheEspacial;
  }

  const RAMPA_IV = ['#e0d6f7', '#bfa6ef', '#9a75e0', '#6f42c1', '#4a1a8a'];

  const capaIv: DefinicionCapa = {
    id: 'iv',
    etiqueta: 'Idoneidad biofísica (Iv)',
    disponible: true,
    aviso:
      'Iv describe qué tan favorables son las condiciones ambientales para el mosquito vector ' +
      'esa semana (escala 0-1) -- es idoneidad del hábitat, NO un pronóstico de riesgo de ' +
      'brote ni una predicción de casos.',
    tituloLeyenda: 'Idoneidad biofísica (Iv, 0-1)',
    rampa: RAMPA_IV,
    sinDatoColor: SIN_DATO,
    async cargarValores() {
      const datos = await obtenerDatosEspaciales();
      if (!datos) return null;
      const valores = new Map<string, number | undefined>();
      for (const [codigo, fila] of datos) valores.set(codigo, fila.iv);
      return valores;
    },
    // Iv está acotado en [0,1] por definición, pero eso NO significa que los
    // valores reales usen ese rango completo -- medido en vivo (SE01/2023):
    // Iv real va de 0.076 a 0.277 en los 14 departamentos, muy por debajo de
    // los cortes fijos que había antes (0.2/0.4/0.6/0.8), así que casi todo
    // el país caía en el mismo balde de color. Cuantiles de los datos (igual
    // que la capa de volumen MINSAL) en vez de cortes fijos sobre [0,1] --
    // siempre usa el rango completo de la rampa contra lo que realmente varía
    // esa semana, en vez de asumir una dispersión que no existe.
    calcularCortes: cortesPorCuantiles,
    etiquetasLeyenda(cortes) {
      return [
        `0.00–${cortes[0].toFixed(2)}`,
        `${cortes[0].toFixed(2)}–${cortes[1].toFixed(2)}`,
        `${cortes[1].toFixed(2)}–${cortes[2].toFixed(2)}`,
        `${cortes[2].toFixed(2)}–${cortes[3].toFixed(2)}`,
        `> ${cortes[3].toFixed(2)}`,
      ];
    },
    tooltipValor(valor) {
      return valor === undefined ? 'sin dato' : valor.toFixed(2);
    },
  };

  // Rampa diverging neutra (azul / gris / naranja) -- deliberadamente sin
  // rojo ni ningún color asociado a alerta/urgencia. La anomalía es un
  // valor continuo descriptivo, no un cruce de umbral.
  const RAMPA_ANOMALIA = ['#3a6ea5', '#8fb8d9', '#e5e5e5', '#e8b86d', '#b5651d'];

  const capaAnomalia: DefinicionCapa = {
    id: 'anomalia',
    etiqueta: 'Anomalía climática (continua)',
    disponible: true,
    aviso:
      'Desviación (en sigmas) de las condiciones ambientales respecto a su promedio histórico ' +
      'esa semana -- valor descriptivo continuo, NO una alerta ni un umbral de riesgo. Este ' +
      'proyecto retiró un diseño de alerta binaria porque no discriminaba nada en la práctica; ' +
      'esta capa muestra el número tal cual, sin clasificarlo en "normal/anómalo".',
    tituloLeyenda: 'Anomalía climática (σ respecto al promedio histórico)',
    rampa: RAMPA_ANOMALIA,
    sinDatoColor: SIN_DATO,
    async cargarValores() {
      const datos = await obtenerDatosEspaciales();
      if (!datos) return null;
      const valores = new Map<string, number | undefined>();
      for (const [codigo, fila] of datos) valores.set(codigo, fila.anomalia_sigma);
      return valores;
    },
    // Sigma ya es una unidad estandarizada -- cortes fijos y simétricos en
    // vez de cuantiles, para que el mismo color siempre signifique la misma
    // magnitud de desviación entre semanas.
    calcularCortes: () => [-1.5, -0.5, 0.5, 1.5],
    etiquetasLeyenda(cortes) {
      return [
        `< ${cortes[0]}σ`,
        `${cortes[0]} a ${cortes[1]}σ`,
        `${cortes[1]} a ${cortes[2]}σ`,
        `${cortes[2]} a ${cortes[3]}σ`,
        `> ${cortes[3]}σ`,
      ];
    },
    tooltipValor(valor) {
      return valor === undefined ? 'sin dato' : `${valor.toFixed(2)}σ`;
    },
  };

  // ---------------------------------------------------------------------
  // Capas 4 y 5: presión epidemiológica relativa (M3), dos series
  // separadas. GET /api/v1/presion/current devuelve 'probable' y
  // 'confirmado' por departamento, nunca fusionadas (son conceptos
  // distintos y no comparables entre sí). Decisión de UI: un botón por
  // serie, reutilizando el selector de capas existente en vez de sumar un
  // sub-selector nuevo -- "probable" va primero por ser la serie con más
  // cobertura (misma serie que colorea la capa de volumen MINSAL). Ambas
  // comparten un único fetch cacheado.
  //
  // El color viene de la CATEGORÍA (baja/media/alta contra P50/P75 del
  // propio baseline del departamento), no del percentil crudo -- el
  // percentil exacto y el conteo observado van en el tooltip. Rampa verde
  // azulada neutra: sin rojo de urgencia, esto no es una alerta.
  // ---------------------------------------------------------------------

  interface CeldaPresion {
    casos_observados: number | null;
    percentil: number | null;
    categoria: 'baja' | 'media' | 'alta' | null;
    p50_baseline: number | null;
    p75_baseline: number | null;
    nota?: string;
  }

  interface DatoPresion {
    codigo: string;
    probable: CeldaPresion | undefined;
    confirmado: CeldaPresion | undefined;
  }

  let cachePresion: Promise<Map<string, DatoPresion> | null> | null = null;

  // Único lugar que conoce la forma exacta de la respuesta de
  // /api/v1/presion/current (espejo del bloque parsearRespuestaEspacial).
  function parsearRespuestaPresion(json: unknown): Map<string, DatoPresion> | null {
    if (!json || typeof json !== 'object' || !Array.isArray((json as any).departamentos)) return null;
    const mapa = new Map<string, DatoPresion>();
    for (const fila of (json as any).departamentos) {
      const codigo = fila?.codigo;
      if (typeof codigo !== 'string') continue;
      mapa.set(codigo, { codigo, probable: fila?.probable, confirmado: fila?.confirmado });
    }
    return mapa;
  }

  async function obtenerDatosPresion(): Promise<Map<string, DatoPresion> | null> {
    if (!cachePresion) {
      cachePresion = (async () => {
        try {
          const resp = await fetch(
            `${API_BASE}/api/v1/presion/current?week=${SEMANA_ESPACIAL}&year=${ANIO_ESPACIAL}`
          );
          if (!resp.ok) return null;
          const mapa = parsearRespuestaPresion(await resp.json());
          if (mapa) detallesPresion = mapa;
          return mapa;
        } catch {
          return null;
        }
      })();
    }
    return cachePresion;
  }

  const CATEGORIA_A_INDICE: Record<string, number> = { baja: 0, media: 1, alta: 2 };
  // Presión solo tiene 3 categorías posibles (baja/media/alta) -- los 3 tonos
  // de teal anteriores eran demasiado parecidos entre sí y con pocos
  // departamentos en "media"/"alta" el mapa se veía casi de un solo color.
  // Mismo family de verde de la marca, pero mucho más separado en luminosidad
  // y saturación para que la diferencia se note incluso con pocos casos en
  // las categorías altas.
  const RAMPA_PRESION = ['#e8f3ef', '#4fae95', '#0b3d33'];

  let detallesPresion = new Map<string, DatoPresion>();

  function definirCapaPresion(serie: 'probable' | 'confirmado'): DefinicionCapa {
    return {
      id: serie === 'probable' ? 'presion_probable' : 'presion_confirmado',
      etiqueta: `Presión epidemiológica (${serie})`,
      disponible: true,
      aviso:
        `Percentil del conteo de casos "${serie}" observado (MINSAL, desacumulado) dentro de la ` +
        'historia del propio departamento (años base 2018-2023 sin 2020, ventana ±1 semana, ' +
        'leave-one-out). 100% descriptivo: dice qué tan inusual es lo YA observado, no predice ' +
        'nada ni es una alerta. Los cortes P50/P75 son deliberadamente sensibles. Los huecos ' +
        '("sin datos suficientes") reflejan límites reales de la fuente MINSAL.',
      tituloLeyenda: `Presión relativa (${serie}, vs. P50/P75 del propio baseline)`,
      rampa: RAMPA_PRESION,
      sinDatoColor: SIN_DATO,
      async cargarValores() {
        const datos = await obtenerDatosPresion();
        if (!datos) return null;
        const valores = new Map<string, number | undefined>();
        for (const [codigo, fila] of datos) {
          const celda = fila[serie];
          const indice = celda?.categoria != null ? CATEGORIA_A_INDICE[celda.categoria] : undefined;
          valores.set(codigo, indice);
        }
        return valores;
      },
      // Cortes fijos sobre el índice de categoría (0=baja, 1=media, 2=alta)
      // -- la categoría ya la decide el backend contra el baseline.
      calcularCortes: () => [0.5, 1.5],
      etiquetasLeyenda: () => ['baja (≤P50)', 'media (P50–P75)', 'alta (>P75)'],
      tooltipValor(valor) {
        if (valor === undefined) return 'sin datos suficientes';
        return ['baja', 'media', 'alta'][valor] ?? 'sin dato';
      },
    };
  }

  const capaPresionProbable = definirCapaPresion('probable');
  const capaPresionConfirmado = definirCapaPresion('confirmado');

  const capaConfianza: DefinicionCapa = {
    id: 'confianza',
    etiqueta: 'Índice de confianza de vigilancia (próximamente)',
    disponible: false,
    aviso:
      'Fórmula todavía no definida en el equipo. Busca hacer visible dónde la vigilancia ' +
      'departamental es más escasa -- ver la nota fija debajo del mapa mientras tanto.',
    tituloLeyenda: '',
    rampa: [],
    sinDatoColor: SIN_DATO,
    async cargarValores() {
      return null;
    },
    calcularCortes: () => [],
    etiquetasLeyenda: () => [],
    tooltipValor: () => 'sin dato',
  };

  const CAPAS: DefinicionCapa[] = [
    capaMinsal,
    capaIv,
    capaAnomalia,
    capaPresionProbable,
    capaPresionConfirmado,
    capaConfianza,
  ];

  // ---------------------------------------------------------------------
  // Tooltip unificado de Camino Ancho: al pasar sobre un departamento en
  // cualquiera de las capas M1/M2/M3 se ven los cuatro valores a la vez
  // (Iv, anomalía, presión probable y confirmado), no solo el de la capa
  // activa -- la capa activa solo decide el COLOR del mapa. La línea de la
  // capa activa va al final con el detalle extra de su baseline.
  // ---------------------------------------------------------------------

  const ES_CAPA_CAMINO_ANCHO: Partial<Record<IdCapa, boolean>> = {
    iv: true,
    anomalia: true,
    presion_probable: true,
    presion_confirmado: true,
  };

  function lineaPresion(celda: CeldaPresion | undefined, etiqueta: string): string {
    if (!celda || celda.percentil === null || celda.categoria === null) {
      return `${etiqueta}: sin datos suficientes`;
    }
    return `${etiqueta}: ${celda.categoria} (percentil ${celda.percentil})`;
  }

  function tooltipCaminoAncho(codigo: string, nombre: string, capaActiva: IdCapa): string {
    const esp = detallesEspacial.get(codigo);
    const pres = detallesPresion.get(codigo);
    const lineas = [
      `Iv (idoneidad): ${esp?.iv !== undefined ? esp.iv.toFixed(2) : 'sin dato'}`,
      `Anomalía climática: ${esp?.anomalia_sigma !== undefined ? `${esp.anomalia_sigma.toFixed(2)}σ` : 'sin dato'}`,
      lineaPresion(pres?.probable, 'Presión (probable)'),
      lineaPresion(pres?.confirmado, 'Presión (confirmado)'),
    ];

    // Detalle extra de la serie de presión activa: casos observados y
    // baseline P50/P75, para poder verificar el color contra el número.
    if (capaActiva === 'presion_probable' || capaActiva === 'presion_confirmado') {
      const serie = capaActiva === 'presion_probable' ? 'probable' : 'confirmado';
      const celda = pres?.[serie];
      if (celda && celda.percentil !== null) {
        lineas.push(
          `Casos observados (${serie}): ${celda.casos_observados} · baseline P50/P75: ` +
            `${celda.p50_baseline} / ${celda.p75_baseline}`
        );
      } else if (celda?.nota) {
        lineas.push(celda.nota);
      }
    }

    return `<strong>${nombre}</strong><br>${lineas.join('<br>')}`;
  }

  // ---------------------------------------------------------------------
  // Detalle de departamento (click en el mapa): snapshot de las 4 capas de
  // Camino Ancho para la semana/año seleccionados + mini-curva de Iv del
  // año contra su banda histórica P25-P75. Mismo patrón hecho a mano de
  // <svg><polyline> que CurvaEpidemicaNacional.astro -- sin librería de
  // charts nueva.
  // ---------------------------------------------------------------------

  interface SemanaTemporal {
    semana_epi: number;
    iv_real: number | null;
    p25_baseline: number | null;
    mediana_baseline: number | null;
    p75_baseline: number | null;
    anomaly_sigma: number | null;
  }

  function dibujarCurvaDetalle(contenedor: HTMLElement, semanas: SemanaTemporal[], semanaActiva: number) {
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const ANCHO = 600;
    const ALTO = 96;
    const conBanda = semanas.filter((s) => s.p25_baseline !== null && s.p75_baseline !== null);
    const valores = conBanda.flatMap((s) => [s.p25_baseline!, s.p75_baseline!, s.iv_real ?? s.p25_baseline!]);
    const min = Math.min(...valores, 0);
    const max = Math.max(...valores, 0.01);
    const escalaX = (i: number) => (i / Math.max(semanas.length - 1, 1)) * ANCHO;
    const escalaY = (v: number) => ALTO - ((v - min) / (max - min || 1)) * (ALTO - 8) - 4;

    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${ANCHO} ${ALTO}`);
    svg.setAttribute('class', 'h-full w-full');
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.setAttribute('role', 'img');
    svg.setAttribute('aria-label', 'Idoneidad biofísica del año seleccionado contra su banda histórica P25-P75');

    if (conBanda.length > 1) {
      const puntosSup = conBanda.map((s, i) => `${escalaX(i)},${escalaY(s.p75_baseline!)}`);
      const puntosInf = [...conBanda].reverse().map((s, i) => `${escalaX(conBanda.length - 1 - i)},${escalaY(s.p25_baseline!)}`);
      const banda = document.createElementNS(SVG_NS, 'polygon');
      banda.setAttribute('points', [...puntosSup, ...puntosInf].join(' '));
      banda.setAttribute('fill', 'var(--color-secondary)');
      banda.setAttribute('opacity', '0.6');
      svg.appendChild(banda);
    }

    const puntosReales = semanas
      .map((s, i) => (s.iv_real !== null ? `${escalaX(i)},${escalaY(s.iv_real)}` : null))
      .filter((p): p is string => p !== null);
    if (puntosReales.length > 1) {
      const linea = document.createElementNS(SVG_NS, 'polyline');
      linea.setAttribute('points', puntosReales.join(' '));
      linea.setAttribute('fill', 'none');
      linea.setAttribute('stroke', 'var(--color-accent)');
      linea.setAttribute('stroke-width', '1.75');
      linea.setAttribute('stroke-linejoin', 'round');
      linea.setAttribute('stroke-linecap', 'round');
      svg.appendChild(linea);
    }

    const indiceActiva = semanas.findIndex((s) => s.semana_epi === semanaActiva);
    if (indiceActiva >= 0 && semanas[indiceActiva].iv_real !== null) {
      const punto = document.createElementNS(SVG_NS, 'circle');
      punto.setAttribute('cx', `${escalaX(indiceActiva)}`);
      punto.setAttribute('cy', `${escalaY(semanas[indiceActiva].iv_real!)}`);
      punto.setAttribute('r', '3.5');
      punto.setAttribute('fill', 'var(--color-deep)');
      punto.setAttribute('stroke', 'var(--color-surface)');
      punto.setAttribute('stroke-width', '1.5');
      svg.appendChild(punto);
    }

    contenedor.innerHTML = '';
    contenedor.appendChild(svg);
  }

  // ---------------------------------------------------------------------
  // Orquestación: un mapa Leaflet, un geojson, una capa geoJSON activa a la
  // vez -- se reemplaza al cambiar de selector en vez de duplicar mapas.
  // ---------------------------------------------------------------------

  // Máscara visual: un rectángulo enorme con un "agujero" recortado por
  // cada departamento (SVG fill-rule evenodd, soportado nativamente por
  // L.Polygon con múltiples anillos). No evita las peticiones de tiles de
  // países vecinos -- son ráster de OpenStreetMap, no hay forma de pedir
  // "sin Guatemala/Honduras" a ese proveedor -- pero atenúa visualmente
  // todo lo que no sea El Salvador, incluyendo los nombres de lugar que
  // trae el tile, para que la atención quede en el país que sí cubre el
  // proyecto. Mismo enfoque que MapaIRA.astro.
  const ANILLO_MUNDO: [number, number][] = [
    [-85, -170],
    [-85, 10],
    [85, 10],
    [85, -170],
  ];

  function construirMascara(geojson: any): [number, number][][] {
    const agujeros: [number, number][][] = [];
    for (const f of geojson.features) {
      const partes = f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : f.geometry.coordinates;
      for (const poligono of partes) {
        agujeros.push(poligono[0].map(([lon, lat]: [number, number]) => [lat, lon]));
      }
    }
    return [ANILLO_MUNDO, ...agujeros];
  }

  async function iniciar() {
    const contenedorSelector = document.getElementById('mapa-selector');
    const contenedorMapa = document.getElementById('mapa-departamentos');
    const contenedorLeyenda = document.getElementById('mapa-leyenda');
    const contenedorAviso = document.getElementById('mapa-aviso');
    const contenedorNoDisponible = document.getElementById('mapa-no-disponible');
    const contenedorDetalle = document.getElementById('mapa-detalle');
    const detalleNombre = document.getElementById('mapa-detalle-nombre');
    const detalleSnapshot = document.getElementById('mapa-detalle-snapshot');
    const detalleCurva = document.getElementById('mapa-detalle-curva');
    const detalleCerrar = document.getElementById('mapa-detalle-cerrar');
    if (
      !contenedorSelector ||
      !contenedorMapa ||
      !contenedorLeyenda ||
      !contenedorAviso ||
      !contenedorNoDisponible ||
      !contenedorDetalle ||
      !detalleNombre ||
      !detalleSnapshot ||
      !detalleCurva ||
      !detalleCerrar
    )
      return;

    detalleCerrar.addEventListener('click', () => contenedorDetalle.classList.add('hidden'));

    function celdaSnapshot(etiqueta: string, valor: string): string {
      return (
        `<div class="rounded-lg border border-border bg-surface px-3 py-2">` +
        `<dt class="font-sans text-[11px] font-medium uppercase tracking-wide text-ink-muted">${etiqueta}</dt>` +
        `<dd class="mt-0.5 font-mono text-sm text-ink">${valor}</dd></div>`
      );
    }

    async function mostrarDetalle(codigo: string, nombre: string) {
      contenedorDetalle.classList.remove('hidden');
      detalleNombre.textContent = nombre;
      detalleSnapshot.innerHTML =
        '<div class="skeleton h-12 rounded-lg"></div><div class="skeleton h-12 rounded-lg"></div>' +
        '<div class="skeleton h-12 rounded-lg"></div><div class="skeleton h-12 rounded-lg"></div>';
      detalleCurva.innerHTML = '<div class="skeleton h-full w-full" aria-hidden="true"></div>';

      await Promise.all([obtenerDatosEspaciales(), obtenerDatosPresion()]);
      const esp = detallesEspacial.get(codigo);
      const pres = detallesPresion.get(codigo);

      detalleSnapshot.innerHTML = [
        celdaSnapshot('Iv (idoneidad)', esp?.iv !== undefined ? esp.iv.toFixed(2) : 'sin dato'),
        celdaSnapshot(
          'Anomalía climática',
          esp?.anomalia_sigma !== undefined ? `${esp.anomalia_sigma.toFixed(2)}σ` : 'sin dato'
        ),
        celdaSnapshot(
          'Presión (probable)',
          pres?.probable?.categoria ? `${pres.probable.categoria} (p${pres.probable.percentil})` : 'sin datos suficientes'
        ),
        celdaSnapshot(
          'Presión (confirmado)',
          pres?.confirmado?.categoria
            ? `${pres.confirmado.categoria} (p${pres.confirmado.percentil})`
            : 'sin datos suficientes'
        ),
      ].join('');

      try {
        const resp = await fetch(`${API_BASE}/api/v1/temporal/${codigo}?anio=${ANIO_ESPACIAL}`);
        if (!resp.ok) throw new Error('respuesta no OK');
        const datos: { semanas: SemanaTemporal[] } = await resp.json();
        dibujarCurvaDetalle(detalleCurva, datos.semanas, SEMANA_ESPACIAL);
      } catch {
        detalleCurva.innerHTML =
          '<p class="font-sans text-xs text-ink-muted">Serie histórica no disponible en este momento.</p>';
      }
    }

    // Límites duros a El Salvador (bbox real del geojson + margen) -- sin
    // esto, un scroll de más con la rueda del mouse manda a ver Guatemala u
    // Honduras, que el proyecto todavía no cubre. maxBoundsViscosity: 1
    // hace que el mapa "rebote" en vez de dejar salir el pan; minZoom evita
    // alejar hasta ver la región entera.
    const LIMITES_SV = L.latLngBounds([12.95, -90.35], [14.65, -87.45]);
    const mapa = L.map(contenedorMapa, {
      minZoom: 8,
      maxBounds: LIMITES_SV,
      maxBoundsViscosity: 1.0,
    }).setView([13.79, -88.9], 8);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 12,
    }).addTo(mapa);

    const respGeo = await fetch('/geo/slv-adm1.geojson');
    const geojson = await respGeo.json();

    L.polygon(construirMascara(geojson), {
      stroke: false,
      fillColor: '#f0f0f0',
      fillOpacity: 0.85,
      interactive: false,
    }).addTo(mapa);

    let capaGeoJsonActiva: L.GeoJSON | null = null;
    let capaActivaId: IdCapa = capaMinsal.id;
    const cacheValoresPorCapa = new Map<IdCapa, Map<string, number | undefined> | null>();

    function botonId(id: IdCapa) {
      return `mapa-boton-${id}`;
    }

    function pintarSelector(activaId: IdCapa) {
      contenedorSelector!.innerHTML = CAPAS.map((capa) => {
        const activa = capa.id === activaId;
        const base =
          'rounded-full border px-3.5 py-1.5 font-sans text-xs font-medium transition-colors duration-150';
        const estilo = !capa.disponible
          ? 'cursor-not-allowed border-border bg-bg text-ink-muted opacity-60'
          : activa
            ? 'border-accent bg-accent text-accent-ink shadow-sm'
            : 'border-border bg-surface text-ink hover:border-accent/40 hover:bg-secondary/30';
        return `<button type="button" id="${botonId(capa.id)}" data-id="${capa.id}" ${
          capa.disponible ? '' : 'disabled aria-disabled="true" title="Capa no disponible temporalmente"'
        } role="tab" aria-selected="${activa}" class="${base} ${estilo}">${capa.etiqueta}</button>`;
      }).join('');

      for (const capa of CAPAS) {
        if (!capa.disponible) continue;
        const boton = document.getElementById(botonId(capa.id));
        boton?.addEventListener('click', () => activarCapa(capa.id));
      }
    }

    async function activarCapa(id: IdCapa) {
      const capa = CAPAS.find((c) => c.id === id);
      if (!capa || !capa.disponible) return;
      capaActivaId = id;

      pintarSelector(id);
      contenedorAviso!.textContent = capa.aviso;
      contenedorLeyenda!.innerHTML =
        '<div class="flex items-center gap-2" aria-hidden="true">' +
        '<div class="skeleton h-4 w-40"></div><div class="skeleton h-4 w-24"></div><div class="skeleton h-4 w-24"></div>' +
        '</div>';
      contenedorNoDisponible!.classList.add('hidden');

      let valores = cacheValoresPorCapa.get(id);
      if (valores === undefined) {
        valores = await capa.cargarValores();
        cacheValoresPorCapa.set(id, valores);
      }

      // Para las capas de Camino Ancho el tooltip muestra los CUATRO valores
      // (Iv, anomalía, presión probable/confirmado) a la vez -- se esperan
      // ambos endpoints aquí (cacheados: 2 fetch en total como máximo) para
      // que el tooltip no dependa de qué capa se visitó antes.
      if (ES_CAPA_CAMINO_ANCHO[id]) {
        await Promise.all([obtenerDatosEspaciales(), obtenerDatosPresion()]);
      }

      if (capaGeoJsonActiva) {
        mapa.removeLayer(capaGeoJsonActiva);
        capaGeoJsonActiva = null;
      }

      if (!valores) {
        contenedorNoDisponible!.classList.remove('hidden');
        contenedorLeyenda!.innerHTML = '';
        // Se sigue dibujando el contorno departamental, todo en "sin dato",
        // para que el mapa no se sienta roto.
        capaGeoJsonActiva = L.geoJSON(geojson, {
          style: () => ({ color: '#8a8a90', weight: 1, fillColor: SIN_DATO, fillOpacity: 0.5 }),
          onEachFeature: (feature, layer) => {
            const nombre = feature.properties?.shapeName
              ? normalizarNombreDepto(feature.properties.shapeName)
              : (feature.properties?.codigo ?? '');
            layer.bindTooltip(`<strong>${nombre}</strong><br>capa no disponible todavía`);
          },
        }).addTo(mapa);
        return;
      }

      const numericos = [...valores.values()].filter((v): v is number => v !== undefined);
      const cortes = capa.calcularCortes(numericos);
      dibujarLeyenda(contenedorLeyenda!, capa, cortes);

      capaGeoJsonActiva = L.geoJSON(geojson, {
        style: (feature) => {
          const codigo = feature?.properties?.codigo ?? '';
          const valor = valores!.get(codigo);
          return {
            color: '#8a8a90',
            weight: 1,
            fillColor: colorGenerico(valor, cortes, capa.rampa, capa.sinDatoColor),
            fillOpacity: 0.75,
          };
        },
        onEachFeature: (feature, layer) => {
          const codigo = feature.properties?.codigo ?? '';
          const nombre = feature.properties?.shapeName ? normalizarNombreDepto(feature.properties.shapeName) : codigo;
          const valor = valores!.get(codigo);

          layer.on('click', () => mostrarDetalle(codigo, nombre));

          if (capa.id === 'minsal_volumen') {
            const dato = detallesMinsal.get(codigo);
            if (!dato) {
              layer.bindTooltip(nombre);
              return;
            }
            const ventana =
              dato.primer_anio && dato.ultimo_anio ? `${dato.primer_anio}-${dato.ultimo_anio}` : 'sin dato';
            layer.bindTooltip(
              `<strong>${nombre}</strong><br>` +
                `Probable (acum.): ${dato.probable_total}<br>` +
                `Confirmado (acum.): ${dato.confirmado_total}<br>` +
                `Semanas con dato: ${dato.semanas_con_dato_probable}<br>` +
                `Ventana: ${ventana}`
            );
            return;
          }

          if (ES_CAPA_CAMINO_ANCHO[capa.id]) {
            layer.bindTooltip(tooltipCaminoAncho(codigo, nombre, capa.id));
            return;
          }

          layer.bindTooltip(`<strong>${nombre}</strong><br>${capa.tituloLeyenda}: ${capa.tooltipValor(valor)}`);
        },
      }).addTo(mapa);
    }

    pintarSelector(capaMinsal.id);
    await activarCapa(capaMinsal.id);

    // Selector de semana/año -- solo afecta a las capas de Camino Ancho
    // (Iv, anomalía, presión); volumen MINSAL y confianza lo ignoran, pero
    // se limpia igual el caché de las 4 capas de Camino Ancho para no
    // servir datos de la semana/año anterior si el usuario cambia de capa
    // después de mover el selector.
    const selectSemana = document.getElementById('mapa-semana') as HTMLSelectElement | null;
    const selectAnio = document.getElementById('mapa-anio') as HTMLSelectElement | null;

    function onCambioTiempo() {
      const semana = Number(selectSemana?.value ?? SEMANA_ESPACIAL);
      const anio = Number(selectAnio?.value ?? ANIO_ESPACIAL);
      if (semana === SEMANA_ESPACIAL && anio === ANIO_ESPACIAL) return;
      SEMANA_ESPACIAL = semana;
      ANIO_ESPACIAL = anio;
      cacheEspacial = null;
      cachePresion = null;
      (['iv', 'anomalia', 'presion_probable', 'presion_confirmado'] as IdCapa[]).forEach((id) =>
        cacheValoresPorCapa.delete(id)
      );
      activarCapa(capaActivaId);
    }

    selectSemana?.addEventListener('change', onCambioTiempo);
    selectAnio?.addEventListener('change', onCambioTiempo);
  }

  iniciar();
</script>
