---
// Mapa departamental -- capa descriptiva, sin datos todavía. Leaflet necesita
// el DOM del navegador (no hay forma de renderizarlo en el servidor), así
// que todo el trabajo con L.* vive en el <script> de abajo, que Astro
// procesa y ejecuta solo en el cliente. No se agregó React/Preact/etc. para
// esto -- un componente .astro + <script> ya resuelve "solo en el
// navegador" sin sumar un framework de UI nuevo al proyecto.
---

<section class="rounded-lg border border-border bg-surface p-4">
  <h2 class="font-sans text-base font-semibold text-ink">Mapa departamental</h2>

  <div class="mt-2 rounded-md border border-border bg-bg p-3">
    <p class="font-sans text-sm text-ink-muted">
      <strong class="text-ink">Capa descriptiva, sin datos departamentales cargados todavía.</strong>
      No representa una clasificación de riesgo por departamento bajo ninguna circunstancia --
      el clasificador de esta primera entrega opera a nivel nacional, no departamental.
    </p>
  </div>

  <div id="mapa-departamentos" class="mt-3 h-[360px] w-full rounded-md border border-border"></div>
</section>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  async function iniciar() {
    const contenedor = document.getElementById('mapa-departamentos');
    if (!contenedor) return;

    const mapa = L.map(contenedor).setView([13.79, -88.9], 8);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 12,
    }).addTo(mapa);

    const resp = await fetch('/geo/slv-adm1.geojson');
    const geojson = await resp.json();

    // Relleno neutro uniforme para los 14 departamentos -- deliberadamente
    // el mismo color para todos, para no sugerir ninguna escala de riesgo
    // ni siquiera como placeholder visual.
    L.geoJSON(geojson, {
      style: () => ({
        color: '#8a8a90',
        weight: 1,
        fillColor: '#c7c7cc',
        fillOpacity: 0.5,
      }),
      onEachFeature: (feature, layer) => {
        const nombre = feature.properties?.shapeName ?? feature.properties?.codigo ?? '';
        layer.bindTooltip(nombre);
      },
    }).addTo(mapa);
  }

  iniciar();
</script>
