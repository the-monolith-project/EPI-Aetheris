---
// Panel de auditoría del dato. Los hechos que no son métrica (ventana,
// exclusión de 2020) siguen siendo estáticos. Completitud anual y
// antigüedad por serie las produce M4 (GET /api/v1/vigilancia/integridad)
// y se rellenan en el cliente. No es un índice compuesto ni un score de
// confianza: son tres métricas separadas; aquí se muestran las dos que
// tienen sentido como resumen (completitud anual y antigüedad).
---

<section aria-label="Auditoría del dato" class="rounded-2xl bg-deep p-5 sm:p-6">
  <p class="font-sans text-xs font-medium text-deep-ink-muted">
    Auditoría del dato
  </p>

  <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="rounded-xl border border-white/10 bg-white/5 p-3">
      <dt class="font-sans text-[11px] font-medium text-deep-ink-muted">
        Ventana de datos
      </dt>
      <dd class="mt-1 font-sans text-sm leading-relaxed text-deep-ink">
        Nacional (OpenDengue): 2018-2024. Departamental (MINSAL): 2018, 2019,
        2021, 2022, 2023. Clima (ERA5-Land / ERA5, M1/M2): desde 2014 hasta el
        año en curso, con un rezago de unos 5 días propio del reanálisis; no es
        incidencia ni sustituye a los casos MINSAL.
      </dd>
    </div>
    <div class="rounded-xl border border-white/10 bg-white/5 p-3">
      <dt class="font-sans text-[11px] font-medium text-deep-ink-muted">
        2020 excluido de la referencia departamental
      </dt>
      <dd class="mt-1 font-sans text-sm leading-relaxed text-deep-ink">
        La exclusión no responde a una baja transmisión. La vigilancia
        epidemiológica se vio alterada durante la pandemia de COVID-19 (26,434
        casos nacionales en 2019 frente a 5,224 en 2020). El año sigue visible
        en la curva nacional.
      </dd>
    </div>
    <div class="rounded-xl border border-white/10 bg-white/5 p-3">
      <dt class="font-sans text-[11px] font-medium text-deep-ink-muted">
        Completitud geográfica MINSAL
      </dt>
      <dd
        id="auditoria-completitud"
        class="mt-1 font-sans text-sm leading-relaxed text-deep-ink"
      >
        Cargando semanas con los 14 departamentos…
      </dd>
    </div>
    <div class="rounded-xl border border-white/10 bg-white/5 p-3">
      <dt class="font-sans text-[11px] font-medium text-deep-ink-muted">
        Antigüedad del dato
      </dt>
      <dd
        id="auditoria-antiguedad"
        class="mt-1 font-sans text-sm leading-relaxed text-deep-ink"
      >
        Cargando semanas desde la última observación de cada serie…
      </dd>
    </div>
  </dl>
</section>

<script>
  import { obtenerIntegridadVigilancia } from '../lib/analisis-api';

  const ETIQUETAS_SERIE: Record<string, string> = {
    dengue_minsal_departamental: 'dengue MINSAL departamental',
    dengue_opendengue_nacional: 'dengue OpenDengue nacional',
    clima: 'clima',
    ira: 'IRA',
    neumonias: 'neumonías',
    virus_respiratorios: 'virus respiratorios',
  };

  const nodoCompletitud = document.getElementById('auditoria-completitud');
  const nodoAntiguedad = document.getElementById('auditoria-antiguedad');

  function textoCompletitud(
    resumen: {
      anio: number;
      probable: {
        semanas_completas: number;
        semanas_con_dato: number;
        semanas_nominales: number;
      };
    }[],
  ): string {
    if (resumen.length === 0) {
      return 'Sin filas departamentales de dengue MINSAL para calcular completitud.';
    }
    const partes = resumen.map((fila) => {
      const celda = fila.probable;
      return `${fila.anio}: ${celda.semanas_completas} de ${celda.semanas_nominales}`;
    });
    return (
      `Semanas con los 14 departamentos (serie probable): ${partes.join(' · ')}. ` +
      'Los huecos se concentran en semanas festivas y en boletines sin tabla departamental.'
    );
  }

  function textoAntiguedad(
    antiguedad: Record<
      string,
      {
        ultima_anio: number | null;
        ultima_semana_epi: number | null;
        semanas: number | null;
      }
    >,
  ): string {
    const partes = Object.entries(ETIQUETAS_SERIE).map(([clave, etiqueta]) => {
      const celda = antiguedad[clave];
      if (!celda || celda.semanas === null || celda.ultima_anio === null) {
        return `${etiqueta}: sin filas`;
      }
      const se = String(celda.ultima_semana_epi).padStart(2, '0');
      return `${etiqueta}: ${celda.semanas} sem. (última SE${se}/${celda.ultima_anio})`;
    });
    return partes.join(' · ');
  }

  async function pintar() {
    if (!nodoCompletitud || !nodoAntiguedad) return;
    try {
      const datos = await obtenerIntegridadVigilancia();
      nodoCompletitud.textContent = textoCompletitud(datos.resumen_anual ?? []);
      nodoAntiguedad.textContent = textoAntiguedad(datos.antiguedad);
    } catch {
      nodoCompletitud.textContent =
        'No se pudo calcular la completitud geográfica en este momento.';
      nodoAntiguedad.textContent =
        'No se pudo calcular la antigüedad de las series en este momento.';
    }
  }

  void pintar();
</script>
