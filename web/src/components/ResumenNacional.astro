---
// Fila de cifras reales -- mismos datos que ya carga CurvaEpidemicaNacional.astro
// (GET /api/casos-nacional), agregados del lado del cliente. No inventa ninguna
// métrica nueva ni implica lectura de riesgo: es un resumen histórico ("lo que
// ya pasó"), no una alerta. Diseño horizontal inspirado en la fila de tarjetas
// de resumen de referencias_no_trakear/boceto_dashboard_pre-camino-ancho_DESACTUALIZADO.png
// (layout reciclado, contenido de riesgo de ese boceto NO -- ver LEEME.md ahí).
---

<section
  aria-label="Resumen histórico nacional"
  class="grid grid-cols-2 gap-4 lg:grid-cols-4"
>
  <div id="resumen-nacional" class="contents">
    <div data-estado aria-hidden="true" class="contents">
      <div class="skeleton h-24 border border-border"></div>
      <div class="skeleton h-24 border border-border"></div>
      <div class="skeleton h-24 border border-border"></div>
    </div>
  </div>

  <div class="card-elevated rounded-2xl border border-border bg-surface p-4">
    <p class="font-sans text-2xl font-semibold tracking-tight text-ink">14</p>
    <p class="mt-0.5 font-sans text-xs leading-snug text-ink-muted">
      departamentos con capas descriptivas
    </p>
  </div>
</section>

<script>
  import { obtenerCasosNacionales } from '../lib/analisis-api';

  function formatearSemana(fecha: string): string {
    const d = new Date(`${fecha}T00:00:00`);
    return d.toLocaleDateString('es-SV', {
      year: 'numeric',
      month: 'short',
      day: '2-digit',
    });
  }

  async function iniciar() {
    const contenedor = document.getElementById('resumen-nacional');
    if (!contenedor) return;

    try {
      const datos = await obtenerCasosNacionales();
      if (datos.length === 0) throw new Error('sin datos');

      const total = datos.reduce((acc, d) => acc + d.conteo, 0);
      const pico = datos.reduce((a, b) => (b.conteo > a.conteo ? b : a));
      const primero = datos[0];
      const ultimo = datos[datos.length - 1];

      contenedor.innerHTML = `
        <div class="card-elevated rounded-2xl border border-border bg-surface p-4">
          <p class="font-sans text-2xl font-semibold tracking-tight text-ink">${total.toLocaleString('es-SV')}</p>
          <p class="mt-0.5 font-sans text-xs leading-snug text-ink-muted">
            casos acumulados, ${primero.anio}-${ultimo.anio} (nacional)
          </p>
        </div>
        <div class="card-elevated rounded-2xl border border-border bg-surface p-4">
          <p class="font-sans text-2xl font-semibold tracking-tight text-ink">${pico.conteo.toLocaleString('es-SV')}</p>
          <p class="mt-0.5 font-sans text-xs leading-snug text-ink-muted">
            pico semanal histórico. Semana del ${formatearSemana(pico.semana_inicio)}
          </p>
        </div>
        <div class="card-elevated rounded-2xl border border-border bg-surface p-4">
          <p class="font-sans text-2xl font-semibold tracking-tight text-ink">${datos.length}</p>
          <p class="mt-0.5 font-sans text-xs leading-snug text-ink-muted">
            semanas epidemiológicas con dato nacional cargado
          </p>
        </div>
      `;
    } catch {
      contenedor.innerHTML =
        '<p class="col-span-3 font-sans text-sm text-ink-muted">No se pudo cargar el resumen en este momento.</p>';
    }
  }

  iniciar();
</script>
