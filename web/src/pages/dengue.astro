---
import Layout from '../layouts/Layout.astro';
import CurvaEpidemicaNacional from '../components/CurvaEpidemicaNacional.astro';
import PanelAnalisis from '../components/analisis/PanelAnalisis.astro';
import UltimaSemanaDengue from '../components/UltimaSemanaDengue.astro';
import {
  RUTA_FUENTES,
  RUTA_PREDICCION,
  RUTA_SENSIBILIDAD,
} from '../lib/enlaces';
---

<Layout mapa title="EPI-Aetheris — Dengue">
  {
    /* Modo presentación para grabar el video de la demo (?demo=1, ?demo=lento).
     Se activa lo antes posible para minimizar el parpadeo del header. */
  }
  <script is:inline>
    try {
      if (new URLSearchParams(location.search).has('demo')) {
        document.documentElement.classList.add('demo-presentacion');
      }
    } catch {
      // Ignorar entornos sin soporte de URLSearchParams
    }
  </script>
  <main
    id="contenido-principal"
    data-pagina-dengue
    class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    <h1 class="font-display text-2xl font-semibold text-ink sm:text-3xl">
      Vigilancia del dengue por departamento
    </h1>
    <p
      class="mb-6 mt-3 flex flex-wrap gap-x-5 gap-y-1 font-sans text-sm"
      data-enlaces-dengue
    >
      <a
        href={RUTA_PREDICCION}
        data-enlace-prediccion
        class="font-medium text-accent underline underline-offset-2"
        >Predicción a corto plazo →</a
      >
      <a
        href="/alertas?tipo=dengue"
        data-enlace-alertas="dengue"
        class="font-medium text-accent underline underline-offset-2"
        >¿Alerta activa? →</a
      >
      <a
        href={RUTA_FUENTES}
        class="font-medium text-accent underline underline-offset-2"
        >Fuentes de los datos</a
      >
      <a
        href={RUTA_SENSIBILIDAD}
        class="font-medium text-accent underline underline-offset-2"
        >Cómo leer estas cifras</a
      >
    </p>

    <div data-franja-ultima-semana>
      <UltimaSemanaDengue />
    </div>

    <PanelAnalisis />

    <div id="curva" class="mt-8 scroll-mt-[calc(var(--alto-header)+0.5rem)]">
      <CurvaEpidemicaNacional />
    </div>
  </main>
</Layout>

<script>
  import { actualizarFiltrosAnalisis } from '../lib/analisis-state';
  import { leerDepartamentoRecordado } from '../lib/departamento-recordado';
  import { iniciarMovimiento } from '../lib/movimiento';

  iniciarMovimiento();

  // El departamento recordado es el inicial solo si el enlace no trae uno.
  const recordado = leerDepartamentoRecordado();
  if (recordado && !new URLSearchParams(location.search).has('dept')) {
    actualizarFiltrosAnalisis({ departamento: recordado });
  }

  // La predicción vivía en una pestaña de esta página (?t=prediccion). Los
  // enlaces guardados siguen llegando a su página propia.
  if (new URLSearchParams(location.search).get('t') === 'prediccion') {
    const destino = new URL('/prediccion', location.origin);
    if (new URLSearchParams(location.search).has('demo')) {
      destino.searchParams.set(
        'demo',
        new URLSearchParams(location.search).get('demo') ?? '',
      );
    }
    location.replace(destino);
  }
</script>

<style is:global>
  /* Modo presentación (solo /dengue, solo con ?demo). Sin la clase en <html>
     la página queda idéntica. */
  html.demo-presentacion [data-franja-ultima-semana] {
    display: none;
  }
  html.demo-presentacion body > header,
  html.demo-presentacion body > footer {
    display: none !important;
  }
  html.demo-presentacion body > main {
    max-width: none !important;
    padding: 1.5rem 3rem 2rem !important;
  }
  html.demo-presentacion body > main > p[data-enlaces-dengue] {
    display: none !important;
  }
</style>
