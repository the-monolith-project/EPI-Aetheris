---
import Layout from '../layouts/Layout.astro';
import NavSecciones from '../components/NavSecciones.astro';
import AyudaTermino from '../components/AyudaTermino.astro';
import Icono from '../components/Icono.astro';
import CurvaIRADepartamental from '../components/CurvaIRADepartamental.astro';
import CurvaRespiratoriaNacional from '../components/CurvaRespiratoriaNacional.astro';
import HeatmapNeumonias from '../components/HeatmapNeumonias.astro';
import MapaIRA from '../components/MapaIRA.astro';
import PanelCobertura from '../components/PanelCobertura.astro';
import PanelVirus from '../components/PanelVirus.astro';
---

<Layout mapa title="EPI-Aetheris — Observatorio respiratorio">
  <main
    id="contenido-principal"
    class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    <header class="mb-8 max-w-3xl">
      <p
        class="font-sans text-xs font-semibold uppercase tracking-wider text-accent"
      >
        Observatorio respiratorio · MINSAL
      </p>
      <h1
        class="mt-1 font-display text-2xl font-semibold tracking-tight text-ink sm:text-[1.75rem]"
      >
        Observatorio respiratorio (MINSAL)
      </h1>
      <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
        IRA y neumonías son conteos clínicos notificados: nacionales desde 2025,
        del tablero de MINSAL, y por departamento de 2018 a 2023, de los
        boletines. Influenza, VSR y SARS-CoV-2 son vigilancia laboratorial
        nacional (muestras, detecciones, positividad). Cada serie conserva su
        unidad.
        <AyudaTermino clave="conteo-notificado" />
        <AyudaTermino clave="positividad" />
      </p>
      <p class="mt-4 font-sans text-sm">
        <a
          href="/alertas?tipo=respiratorio"
          data-enlace-alertas="respiratorio"
          class="font-medium text-accent underline underline-offset-2"
          >¿Alerta activa? →</a
        >
      </p>
    </header>

    <div class="mb-4 flex flex-wrap items-center gap-3 font-sans text-xs">
      <button
        type="button"
        data-copiar-enlace
        class="flex min-h-[44px] items-center rounded-lg border border-border bg-bg px-3 py-2 font-semibold text-ink transition-colors hover:border-accent/50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        Copiar enlace a esta vista
      </button>
      <p data-copiar-estado role="status" class="min-h-4 text-ink-muted"></p>
    </div>

    <NavSecciones
      etiqueta="Serie respiratoria"
      enlaces={[
        { href: '#cobertura', etiqueta: 'Cobertura' },
        { href: '#ira', etiqueta: 'IRA' },
        { href: '#neumonias', etiqueta: 'Neumonías' },
        { href: '#virus', etiqueta: 'Virus (nacional)' },
      ]}
    />

    <section id="cobertura" class="mb-10">
      <PanelCobertura />
    </section>

    <section id="ira" class="mb-10 grid grid-cols-1 gap-6">
      <h2
        class="flex items-center gap-2.5 font-display text-xl font-semibold text-ink"
      >
        <Icono nombre="lungs" class="h-6 w-6 text-accent" />
        IRA — conteo notificado
      </h2>
      <CurvaRespiratoriaNacional evento="ira" />
      <div class="rounded-[28px] bg-deep p-2 sm:p-3">
        <MapaIRA evento="ira" />
      </div>
      <CurvaIRADepartamental evento="ira" />
    </section>

    <section id="neumonias" class="mb-10 grid grid-cols-1 gap-6">
      <h2
        class="flex items-center gap-2.5 font-display text-xl font-semibold text-ink"
      >
        <Icono nombre="lungs" class="h-6 w-6 text-accent" />
        Neumonías — conteo notificado
      </h2>
      <CurvaRespiratoriaNacional evento="neumonias" />
      <div class="rounded-[28px] bg-deep p-2 sm:p-3">
        <MapaIRA evento="neumonias" />
      </div>
      <CurvaIRADepartamental evento="neumonias" />
      <HeatmapNeumonias />
    </section>

    <section id="virus" class="mb-10 grid grid-cols-1 gap-6">
      <h2
        class="flex items-center gap-2.5 font-display text-xl font-semibold text-ink"
      >
        <Icono nombre="virus" class="h-6 w-6 text-accent" />
        Influenza, VSR y SARS-CoV-2 — laboratorio nacional
      </h2>
      <PanelVirus />
    </section>
  </main>
</Layout>

<script>
  const boton = document.querySelector<HTMLButtonElement>(
    '[data-copiar-enlace]',
  );
  const estado = document.querySelector<HTMLElement>('[data-copiar-estado]');
  boton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (estado) estado.textContent = 'Enlace a esta vista copiado.';
    } catch {
      if (estado)
        estado.textContent =
          'No se pudo copiar el enlace. Cópialo desde la barra de direcciones.';
    }
  });
</script>
