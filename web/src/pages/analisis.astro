---
import Layout from '../layouts/Layout.astro';
import { DEPARTAMENTOS } from '../lib/departamentos';

// Índice de las herramientas descriptivas (ADR 0014). Existe para que la
// puerta de entrada del sitio pueda ser el panorama sin que las dos vistas
// de análisis pierdan un lugar propio y estable en la navegación. No calcula
// nada: solo enruta; el estatuto vive en el footer y en la Biblioteca.

const HERRAMIENTAS = [
  {
    href: '/dengue',
    titulo: 'Dengue',
    estado: 'Capas descriptivas completas',
    texto:
      'Mapa departamental con las tres capas activas: idoneidad biofísica (M1), anomalía climática frente a la propia historia del departamento (M2) y presión epidemiológica relativa como percentil (M3). Incluye el archivo histórico del clasificador piloto.',
  },
  {
    href: '/respiratorio',
    titulo: 'Respiratorio',
    estado: 'Series notificadas, sin capas climáticas',
    texto:
      'Neumonías e infección respiratoria aguda (IRA) notificadas por departamento (ADR 0011), más vigilancia laboratorial nacional de virus (muestras y detecciones). Cada serie conserva su unidad.',
  },
];

const COMO_LEER = [
  'Cada departamento se compara contra su propia historia.',
  'Cada capa describe lo ya publicado: un percentil, un conteo, una anomalía.',
  'Las series son históricas, no de tiempo real: el dato más reciente cargado no es el de esta semana.',
];
---

<Layout
  title="EPI-Aetheris — Análisis"
  descripcion="Herramientas descriptivas de EPI-Aetheris: dengue y respiratorio por departamento, sobre datos públicos históricos."
>
  <main class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12">
    <header class="max-w-3xl">
      <p
        class="font-sans text-xs font-semibold uppercase tracking-wider text-accent"
      >
        Herramientas de análisis &middot; datos públicos históricos
      </p>
      <h1
        class="mt-1 font-display text-2xl font-semibold tracking-tight text-ink sm:text-[1.75rem]"
      >
        Análisis
      </h1>
      <p class="mt-3 font-sans text-base leading-relaxed text-ink-muted">
        Las dos vistas descriptivas del sistema. Para lo que está vigente y las
        indicaciones para la unidad, la sección de
        <a
          href="/alertas"
          class="font-medium text-accent underline underline-offset-2"
          >Alertas de campo</a
        > es más directa.
      </p>
    </header>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        HERRAMIENTAS.map((h) => (
          <a
            href={h.href}
            data-herramienta={h.href}
            class="card-elevated flex flex-col rounded-2xl border border-border bg-surface p-5 transition-colors hover:border-accent/40"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-display text-lg font-semibold text-ink">
                {h.titulo}
              </span>
              <span class="rounded-full bg-secondary px-2 py-0.5 font-sans text-[10px] font-semibold uppercase tracking-wide text-secondary-ink">
                {h.estado}
              </span>
            </div>
            <p class="mt-2 font-sans text-sm leading-relaxed text-ink-muted">
              {h.texto}
            </p>
            <span class="mt-4 font-sans text-sm font-medium text-accent underline underline-offset-2">
              Abrir {h.titulo.toLowerCase()}
            </span>
          </a>
        ))
      }
    </div>

    <section
      data-seccion-fichas
      class="mt-8 rounded-2xl border border-border bg-surface p-5 sm:p-6"
    >
      <div
        class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2"
      >
        <div>
          <h2 class="font-sans text-base font-semibold text-ink">
            Fichas departamentales imprimibles
          </h2>
          <p class="mt-1 font-sans text-sm text-ink-muted leading-relaxed">
            Resumen en una hoja diseñado para campo e impresión sin conexión:
            estado de la última semana disponible (M1, M2, M3), series
            históricas, IRA, neumonías y guías de prevención oficiales citadas.
          </p>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap gap-2">
        {
          DEPARTAMENTOS.map((dep) => (
            <a
              href={`/analisis/ficha/${dep.codigo}`}
              data-ficha-enlace={dep.codigo}
              class="rounded-full border border-border bg-bg px-3 py-1.5 font-sans text-xs font-medium text-ink transition-colors hover:border-accent/40 hover:text-accent"
            >
              {dep.nombre} <span class="text-ink-muted">({dep.codigo})</span>
            </a>
          ))
        }
      </div>
    </section>

    <section
      class="mt-10 rounded-2xl border border-border bg-surface p-5 sm:p-6"
    >
      <h2 class="font-sans text-sm font-semibold text-ink">
        Cómo leer estas vistas
      </h2>
      <ul class="mt-3 space-y-2">
        {
          COMO_LEER.map((item) => (
            <li class="font-sans text-sm leading-relaxed text-ink-muted">
              {item}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 font-sans text-sm text-ink-muted">
        El porqué de cada decisión está en la
        <a
          href="/biblioteca"
          class="font-medium text-accent underline underline-offset-2"
          >Biblioteca</a
        >.
      </p>
    </section>
  </main>
</Layout>
