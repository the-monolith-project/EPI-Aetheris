---
import Layout from '../layouts/Layout.astro';

// Índice de las herramientas descriptivas (ADR 0014). Existe para que la
// puerta de entrada del sitio pueda ser el panorama sin que las tres vistas
// de análisis pierdan un lugar propio y estable en la navegación. No calcula
// nada: solo enruta y repite el estatuto (descriptivo, nunca predictivo).

const HERRAMIENTAS = [
  {
    href: '/dengue',
    titulo: 'Dengue',
    estado: 'Camino Ancho completo',
    texto:
      'Mapa departamental con las tres capas activas: idoneidad biofísica (M1), anomalía climática frente a la propia historia del departamento (M2) y presión epidemiológica relativa como percentil (M3). Incluye el clasificador piloto retirado, marcado como referencia histórica.',
  },
  {
    href: '/respiratorio',
    titulo: 'Respiratorio',
    estado: 'Sin capas Camino Ancho',
    texto:
      'Neumonías notificadas por departamento y vigilancia laboratorial nacional de virus (muestras y detecciones, no casos). Las fórmulas de idoneidad, anomalía y presión siguen cerradas solo a dengue: no se reutilizan aquí sin validación propia.',
  },
  {
    href: '/ira',
    titulo: 'IRA',
    estado: 'Serie notificada',
    texto:
      'Infección respiratoria aguda notificada por departamento (ADR 0011). Serie publicada acumulada desde la semana 1 y desacumulada por diferencia entre cortes consecutivos.',
  },
];

const COMO_LEER = [
  'Cada departamento se compara contra su propia historia, nunca contra los demás ni contra un promedio nacional.',
  'Ninguna capa asigna un nivel de riesgo ni anticipa un brote. Son descripciones de lo ya publicado.',
  'Las series son históricas, no de tiempo real: el dato más reciente cargado no es el de esta semana.',
  'La coexistencia temporal de dos series no demuestra que una cause la otra.',
];
---

<Layout
  title="EPI-Aetheris — Análisis"
  descripcion="Herramientas descriptivas de EPI-Aetheris: dengue, respiratorio e IRA por departamento, sobre datos públicos históricos."
>
  <main class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12">
    <header class="max-w-3xl">
      <p
        class="font-sans text-xs font-semibold uppercase tracking-wider text-accent"
      >
        Herramientas de análisis &middot; datos públicos históricos
      </p>
      <h1
        class="mt-1 font-display text-2xl font-semibold tracking-tight text-ink sm:text-[1.75rem]"
      >
        Análisis
      </h1>
      <p class="mt-3 font-sans text-base leading-relaxed text-ink-muted">
        Las tres vistas descriptivas del sistema. Si lo que buscás es qué hacer
        hoy en la unidad de salud, la sección de
        <a
          href="/alertas"
          class="font-medium text-accent underline underline-offset-2"
          >Alertas de campo</a
        > es más directa.
      </p>
    </header>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        HERRAMIENTAS.map((h) => (
          <a
            href={h.href}
            data-herramienta={h.href}
            class="card-elevated flex flex-col rounded-2xl border border-border bg-surface p-5 transition-colors hover:border-accent/40"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="font-display text-lg font-semibold text-ink">
                {h.titulo}
              </span>
              <span class="rounded-full bg-secondary px-2 py-0.5 font-sans text-[10px] font-semibold uppercase tracking-wide text-secondary-ink">
                {h.estado}
              </span>
            </div>
            <p class="mt-2 font-sans text-sm leading-relaxed text-ink-muted">
              {h.texto}
            </p>
            <span class="mt-4 font-sans text-sm font-medium text-accent underline underline-offset-2">
              Abrir {h.titulo.toLowerCase()}
            </span>
          </a>
        ))
      }
    </div>

    <section
      class="mt-10 rounded-2xl border border-border bg-surface p-5 sm:p-6"
    >
      <h2 class="font-sans text-sm font-semibold text-ink">
        Cómo leer estas vistas
      </h2>
      <ul class="mt-3 space-y-2">
        {
          COMO_LEER.map((item) => (
            <li class="font-sans text-sm leading-relaxed text-ink-muted">
              {item}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 font-sans text-sm text-ink-muted">
        El porqué de cada decisión está en la
        <a
          href="/biblioteca"
          class="font-medium text-accent underline underline-offset-2"
          >Biblioteca</a
        >.
      </p>
    </section>
  </main>
</Layout>
