---
import { getCollection } from 'astro:content';
import Icono from '../../components/Icono.astro';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const entradas = (await getCollection('biblioteca')).sort(
  (a: CollectionEntry<'biblioteca'>, b: CollectionEntry<'biblioteca'>) =>
    a.data.orden - b.data.orden,
);

type Grupo = {
  categoria: string;
  items: CollectionEntry<'biblioteca'>[];
};

const grupos: Grupo[] = [];
const indicePorCategoria = new Map<string, number>();
for (const entrada of entradas) {
  const categoria = entrada.data.categoria ?? 'Documentos';
  const existente = indicePorCategoria.get(categoria);
  if (existente === undefined) {
    indicePorCategoria.set(categoria, grupos.length);
    grupos.push({ categoria, items: [entrada] });
  } else {
    const grupo = grupos[existente];
    if (grupo) grupo.items.push(entrada);
  }
}
---

<Layout
  title="EPI-Aetheris — Biblioteca"
  descripcion="Documentos del proyecto: qué es EPI-Aetheris, qué hace cada módulo, de dónde salen los datos, qué límites tiene y cómo se instala el sistema."
>
  <main
    id="contenido-principal"
    class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12"
  >
    <header class="mb-10 max-w-3xl">
      <h1
        class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-[1.75rem]"
      >
        Biblioteca
      </h1>
      <p class="mt-3 font-sans text-sm leading-relaxed text-ink-muted">
        Qué es el sistema, qué hace cada función, de dónde salen los datos, qué
        límites tiene y cómo se instala en otra computadora. Para quien estudia,
        investiga, evalúa o quiere replicar el proyecto.
      </p>
    </header>

    <div class="flex flex-col gap-10">
      {
        grupos.map((grupo) => (
          <section>
            <h2 class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight text-ink">
              <Icono nombre="book-2" class="h-5 w-5 text-accent" />
              {grupo.categoria}
            </h2>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {grupo.items.map((item) => (
                <a
                  href={`/biblioteca/${item.id}`}
                  class="card-elevated flex flex-col gap-2 rounded-2xl border border-border bg-surface p-5"
                >
                  <h3 class="font-sans text-base font-semibold leading-snug text-ink">
                    {item.data.titulo}
                  </h3>
                  <p class="font-sans text-sm leading-relaxed text-ink-muted">
                    {item.data.descripcion}
                  </p>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</Layout>
