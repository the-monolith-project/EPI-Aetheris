---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const entradas = await getCollection('biblioteca');
  return entradas.map((entrada) => ({
    params: { slug: entrada.id },
    props: { entrada },
  }));
}

interface Props {
  entrada: CollectionEntry<'biblioteca'>;
}

const { entrada } = Astro.props;
const { Content, headings } = await render(entrada);
const titulo = headings.find((h) => h.depth === 1)?.text ?? entrada.id;
---

<Layout title={`EPI-Aetheris — ${titulo}`}>
  <main class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12">
    <a
      href="/biblioteca"
      class="inline-flex items-center gap-1.5 font-sans text-sm font-medium text-accent hover:underline"
    >
      &larr; Volver a la biblioteca
    </a>

    <article class="card-elevated mt-4 max-w-3xl rounded-2xl border border-border bg-surface p-6 sm:p-8">
      <div class="doc-md font-sans text-sm leading-relaxed text-ink">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style>
  /* Estilos de lectura para markdown renderizado -- sin plugin de
     tipografía (@tailwindcss/typography no está instalado), se define acá
     lo mínimo para que headings/listas/código/tablas/blockquotes de los
     docs originales (escritos para lectura en editor, no en HTML) queden
     legibles con la paleta del proyecto. */
  .doc-md :global(h1) {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }
  .doc-md :global(h2) {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .doc-md :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-top: 1.5rem;
    margin-bottom: 0.4rem;
  }
  .doc-md :global(p) {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .doc-md :global(ul),
  .doc-md :global(ol) {
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
  }
  .doc-md :global(ul) {
    list-style: disc;
  }
  .doc-md :global(ol) {
    list-style: decimal;
  }
  .doc-md :global(li) {
    margin-top: 0.35rem;
  }
  .doc-md :global(li > ul),
  .doc-md :global(li > ol) {
    margin-top: 0.35rem;
    margin-bottom: 0;
  }
  .doc-md :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .doc-md :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
  .doc-md :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .doc-md :global(pre) {
    background: var(--color-deep);
    color: var(--color-deep-ink);
    border-radius: 12px;
    padding: 1rem;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .doc-md :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: inherit;
  }
  .doc-md :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    background: var(--color-secondary);
    color: var(--color-secondary-ink);
    padding: 0.75rem 1rem;
    border-radius: 0 8px 8px 0;
    margin: 1rem 0;
  }
  .doc-md :global(blockquote p) {
    margin: 0;
  }
  .doc-md :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 1.5rem 0;
  }
  .doc-md :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.85em;
  }
  .doc-md :global(th),
  .doc-md :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.6rem;
    text-align: left;
  }
  .doc-md :global(th) {
    background: var(--color-bg);
    font-weight: 600;
  }
</style>
