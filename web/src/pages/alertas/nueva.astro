---
import Layout from '../../layouts/Layout.astro';
import Icono from '../../components/Icono.astro';
import { DEPARTAMENTOS } from '../../lib/departamentos';
---

{
  /* noindex: es la ruta de operadores, no contenido público. Tampoco entra
al sitemap (filtro en astro.config.mjs) ni se lista en robots.txt, que la
anunciaría. */
}
<Layout title="EPI-Aetheris — Nueva alerta" noindex>
  <main
    id="contenido-principal"
    class="mx-auto max-w-3xl px-4 py-8 sm:px-8 sm:py-10"
  >
    <header class="mb-6">
      <p
        class="font-sans text-xs font-semibold uppercase tracking-wider text-accent"
      >
        Operadores · no enlazado en la navegación
      </p>
      <h1
        class="mt-1 font-display text-2xl font-semibold tracking-tight text-ink"
      >
        Emitir alerta de campo
      </h1>
      <aside
        data-aviso-formulario
        class="mt-4 rounded-2xl border-2 border-secondary bg-secondary/20 p-4 font-sans text-sm leading-relaxed text-ink"
      >
        <p>
          <strong
            >Lo que se escriba aquí lo va a leer un médico en terreno.</strong
          >
          No sustituye los lineamientos oficiales del MINSAL ni el criterio clínico.
          La fuente del dato es obligatoria. No inventes teléfonos, correos ni texto
          clínico sin cita.
        </p>
      </aside>
    </header>

    <p class="mb-2 font-sans text-xs text-ink-muted">
      Los campos marcados con <span aria-hidden="true">*</span><span
        class="sr-only"
      >
        (obligatorio)</span
      > son obligatorios.
    </p>
    <form data-form-alerta class="flex flex-col gap-4 font-sans text-sm">
      <fieldset class="rounded-2xl border border-border bg-surface p-4">
        <legend class="px-1 font-semibold">Autenticación</legend>
        <label class="mt-2 flex flex-col gap-1">
          <span
            >Token de escritura (ALERTAS_TOKEN) <span aria-hidden="true">*</span
            ></span
          >
          <input
            type="password"
            name="token"
            data-alerta-token
            autocomplete="off"
            required
            aria-required="true"
            class="rounded-lg border border-border bg-bg px-3 py-2"
          />
        </label>
        <label class="mt-3 flex items-start gap-2">
          <input type="checkbox" data-alerta-recordar-token class="mt-1" />
          <span
            >Recordar el token en este navegador. Sin esta casilla no se guarda.
            Podés cerrar sesión después.</span
          >
        </label>
        <button
          type="button"
          data-alerta-cerrar-sesion
          class="mt-3 inline-flex items-center gap-2 rounded-full border border-border px-3 py-1.5"
        >
          <Icono nombre="logout" class="h-4 w-4" />
          Cerrar sesión (olvidar token)
        </button>
      </fieldset>

      <label class="flex flex-col gap-1">
        <span class="font-semibold">Tipo <span aria-hidden="true">*</span></span
        >
        <select
          name="tipo"
          required
          aria-required="true"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        >
          <option value="dengue">dengue</option>
          <option value="respiratorio">respiratorio</option>
        </select>
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold"
          >Nivel <span aria-hidden="true">*</span></span
        >
        <select
          name="nivel"
          required
          aria-required="true"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        >
          <option value="informativo">informativo</option>
          <option value="atencion">atencion</option>
          <option value="intensificacion">intensificacion</option>
        </select>
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold">Etiqueta (vacío = producción)</span>
        <select
          name="etiqueta"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        >
          <option value="">ninguna</option>
          <option value="test">test</option>
          <option value="simulacro">simulacro</option>
          <option value="historica">historica</option>
        </select>
      </label>
      <fieldset class="rounded-2xl border border-border bg-surface p-4">
        <legend class="px-1 font-semibold">Alcance (departamentos)</legend>
        <p class="text-xs text-ink-muted">
          Sin marcar ninguno, la alerta es nacional.
        </p>
        <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 sm:grid-cols-3">
          {
            DEPARTAMENTOS.map((d) => (
              <label class="inline-flex min-h-[32px] items-center gap-2">
                <input type="checkbox" name="departamentos" value={d.codigo} />
                <span>{d.nombre}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <label class="flex flex-col gap-1">
        <span class="font-semibold"
          >Título <span aria-hidden="true">*</span></span
        >
        <input
          name="titulo"
          required
          aria-required="true"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold"
          >Contexto <span aria-hidden="true">*</span></span
        >
        <textarea
          name="contexto"
          required
          aria-required="true"
          rows="4"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        ></textarea>
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold"
          >Indicaciones <span aria-hidden="true">*</span></span
        >
        <textarea
          name="indicaciones"
          required
          aria-required="true"
          rows="5"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        ></textarea>
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold"
          >Fuente (obligatoria) <span aria-hidden="true">*</span></span
        >
        <input
          name="fuente"
          required
          aria-required="true"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold"
          >Autor <span aria-hidden="true">*</span></span
        >
        <input
          name="autor"
          required
          aria-required="true"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold"
          >Vigente desde <span aria-hidden="true">*</span></span
        >
        <input
          type="date"
          name="vigente_desde"
          required
          aria-required="true"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold">Vigente hasta (opcional)</span>
        <input
          type="date"
          name="vigente_hasta"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold">Definición de caso (opcional)</span>
        <textarea
          name="definicion_caso"
          rows="3"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        ></textarea>
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold">Signos de alarma (opcional)</span>
        <textarea
          name="signos_alarma"
          rows="3"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        ></textarea>
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold">Criterios de referencia (opcional)</span>
        <textarea
          name="criterios_referencia"
          rows="3"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        ></textarea>
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold">Qué notificar (opcional)</span>
        <textarea
          name="que_notificar"
          rows="3"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        ></textarea>
      </label>
      <label class="flex flex-col gap-1">
        <span class="font-semibold">Contacto de vigilancia (opcional)</span>
        <textarea
          name="contacto_vigilancia"
          rows="3"
          class="rounded-lg border border-border bg-surface px-3 py-2"
        ></textarea>
      </label>

      <button
        type="submit"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2 font-semibold text-accent-ink"
      >
        <Icono nombre="send" class="h-4 w-4" />
        Publicar alerta
      </button>
      <p
        data-form-estado
        class="font-sans text-sm text-ink-muted"
        role="status"
        tabindex="-1"
      >
      </p>
    </form>
  </main>
</Layout>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const CLAVE_TOKEN = 'epi-aetheris:alertas-token';
  const form = document.querySelector<HTMLFormElement>('[data-form-alerta]');
  const inputToken = document.querySelector<HTMLInputElement>(
    '[data-alerta-token]',
  );
  const recordar = document.querySelector<HTMLInputElement>(
    '[data-alerta-recordar-token]',
  );
  const cerrar = document.querySelector<HTMLButtonElement>(
    '[data-alerta-cerrar-sesion]',
  );
  const estado = document.querySelector<HTMLElement>('[data-form-estado]');

  try {
    const guardado = window.localStorage.getItem(CLAVE_TOKEN);
    if (guardado && inputToken) {
      inputToken.value = guardado;
      if (recordar) recordar.checked = true;
    }
  } catch {
    // Sin almacenamiento el formulario sigue usable.
  }

  cerrar?.addEventListener('click', () => {
    try {
      window.localStorage.removeItem(CLAVE_TOKEN);
    } catch {
      /* ignore */
    }
    if (inputToken) inputToken.value = '';
    if (recordar) recordar.checked = false;
    if (estado) estado.textContent = 'Token olvidado en este navegador.';
  });

  class ErrorPublicacion extends Error {
    constructor(
      readonly status: number,
      readonly payload: unknown,
    ) {
      super(`HTTP ${status}`);
    }
  }

  // Nombre visible de un campo, tomado de su etiqueta en el formulario.
  function etiquetaCampo(nombre: string): string {
    const campo = form?.elements.namedItem(nombre);
    const titulo =
      campo instanceof Element
        ? campo.closest('label')?.querySelector('.font-semibold')
        : null;
    const texto = titulo?.firstChild?.textContent?.trim() ?? '';
    return texto.replace(/\s*\((opcional|obligatoria)\)$/, '') || nombre;
  }

  // FastAPI devuelve los errores de validación como detail[].loc = ['body', campo].
  function camposRechazados(payload: unknown): string[] {
    if (!payload || typeof payload !== 'object') return [];
    const detalle = (payload as { detail?: unknown }).detail;
    if (!Array.isArray(detalle)) return [];
    const nombres = detalle
      .map((item) =>
        item && typeof item === 'object' && Array.isArray(item.loc)
          ? item.loc[item.loc.length - 1]
          : null,
      )
      .filter((nombre): nombre is string => typeof nombre === 'string');
    return [...new Set(nombres)].map(etiquetaCampo);
  }

  function mensajeErrorPublicacion(error: unknown): string {
    const prefijo = 'No se pudo publicar la alerta.';
    if (!(error instanceof ErrorPublicacion)) {
      return `${prefijo} No hay conexión con el servidor. Inténtalo de nuevo en unos minutos.`;
    }
    if (error.status === 401 || error.status === 403) {
      return `${prefijo} El token no es válido o ha caducado. Revísalo e inténtalo de nuevo.`;
    }
    if (error.status === 400 || error.status === 422) {
      const campos = camposRechazados(error.payload);
      return campos.length > 0
        ? `${prefijo} Revisa estos campos: ${campos.join(', ')}.`
        : `${prefijo} Revisa los datos del formulario.`;
    }
    if (error.status === 429) {
      return `${prefijo} Se enviaron demasiadas alertas seguidas. Espera un minuto e inténtalo de nuevo.`;
    }
    return `${prefijo} El servidor no puede guardarla ahora. Inténtalo de nuevo en unos minutos.`;
  }

  form?.addEventListener('submit', (evento) => {
    evento.preventDefault();
    if (!form || !inputToken) return;
    const datos = new FormData(form);
    const token = inputToken.value.trim();
    const opcional = (clave: string): string | null => {
      const valor = String(datos.get(clave) ?? '').trim();
      return valor === '' ? null : valor;
    };
    const cuerpo = {
      tipo: String(datos.get('tipo') ?? ''),
      nivel: String(datos.get('nivel') ?? ''),
      titulo: String(datos.get('titulo') ?? '').trim(),
      contexto: String(datos.get('contexto') ?? '').trim(),
      indicaciones: String(datos.get('indicaciones') ?? '').trim(),
      fuente: String(datos.get('fuente') ?? '').trim(),
      autor: String(datos.get('autor') ?? '').trim(),
      vigente_desde: String(datos.get('vigente_desde') ?? ''),
      vigente_hasta: opcional('vigente_hasta'),
      etiqueta: opcional('etiqueta'),
      departamentos: datos.getAll('departamentos').map(String),
      definicion_caso: opcional('definicion_caso'),
      signos_alarma: opcional('signos_alarma'),
      criterios_referencia: opcional('criterios_referencia'),
      que_notificar: opcional('que_notificar'),
      contacto_vigilancia: opcional('contacto_vigilancia'),
    };

    if (recordar?.checked) {
      try {
        window.localStorage.setItem(CLAVE_TOKEN, token);
      } catch {
        /* ignore */
      }
    } else {
      try {
        window.localStorage.removeItem(CLAVE_TOKEN);
      } catch {
        /* ignore */
      }
    }

    if (estado) {
      estado.setAttribute('role', 'status');
      estado.textContent = 'Enviando…';
    }
    fetch(`${API_BASE}/api/alertas`, {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${token}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(cuerpo),
    })
      .then(async (respuesta) => {
        const payload: unknown = await respuesta.json().catch(() => null);
        if (!respuesta.ok) {
          throw new ErrorPublicacion(respuesta.status, payload);
        }
        const id =
          payload &&
          typeof payload === 'object' &&
          'id' in payload &&
          typeof (payload as { id: unknown }).id === 'number'
            ? (payload as { id: number }).id
            : null;
        if (estado) {
          estado.textContent = id
            ? `Alerta creada (id ${id}).`
            : 'Alerta creada.';
        }
        if (id) {
          window.location.assign(`/alertas#alerta-${id}`);
        }
      })
      .catch((error: unknown) => {
        // El detalle técnico va a la consola; en pantalla, qué pasó y qué hacer.
        console.error('No se pudo publicar la alerta', error);
        if (estado) {
          estado.setAttribute('role', 'alert');
          estado.textContent = mensajeErrorPublicacion(error);
          estado.focus();
        }
      });
  });
</script>
