---
import Layout from '../../layouts/Layout.astro';
import {
  AVISO_HONESTIDAD_ALERTAS,
  ETIQUETAS_NIVEL,
  NIVELES_ALERTA,
  SIGNIFICADO_NIVEL,
} from '../../lib/vista-alertas';

const tipoPedido = Astro.url.searchParams.get('tipo');
const filtroDengue = tipoPedido === 'dengue';
const filtroRespiratorio = tipoPedido === 'respiratorio';
---

<Layout title="EPI-Aetheris — Alertas de campo">
  <main class="mx-auto max-w-[1600px] px-4 py-8 sm:px-8 sm:py-10 lg:px-12">
    <header class="mb-8 max-w-3xl">
      <p
        class="font-sans text-xs font-semibold uppercase tracking-wider text-accent"
      >
        Alertas de campo · redacción humana · datos históricos
      </p>
      <h1
        class="mt-1 font-display text-2xl font-semibold tracking-tight text-ink sm:text-[1.75rem]"
      >
        Alertas de campo
      </h1>
      <aside
        data-aviso-honestidad
        class="mt-4 rounded-2xl border border-border bg-surface p-4 font-sans text-sm leading-relaxed text-ink"
      >
        <p>
          Herramienta académica en desarrollo (INSAMT, Equipo 4). Las alertas y
          sus indicaciones las redacta manualmente el equipo de vigilancia del
          proyecto a partir de datos públicos históricos (MINSAL, OpenDengue,
          Open-Meteo).{' '}
          <strong
            >No sustituyen los lineamientos oficiales del MINSAL ni el criterio
            clínico.</strong
          >{' '}
          No son tiempo real. La coexistencia temporal de eventos no demuestra causalidad.
        </p>
      </aside>
      <p class="sr-only">{AVISO_HONESTIDAD_ALERTAS}</p>
      <section
        data-niveles-leyenda
        class="mt-4 rounded-2xl border border-border bg-surface p-4 font-sans text-sm leading-relaxed text-ink"
      >
        <h2 class="font-sans text-sm font-semibold text-ink">Niveles</h2>
        <dl class="mt-2 space-y-2">
          {
            NIVELES_ALERTA.map((clave) => (
              <div data-nivel-leyenda={clave}>
                <dt class="font-semibold">{ETIQUETAS_NIVEL[clave]}</dt>
                <dd class="text-ink-muted">{SIGNIFICADO_NIVEL[clave]}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </header>

    <nav
      class="mb-6 flex flex-wrap gap-2 font-sans text-sm"
      aria-label="Filtrar alertas por tipo"
    >
      <a
        href="/alertas"
        data-filtro-tipo="todas"
        aria-current={tipoPedido ? undefined : 'page'}
        class:list={[
          'rounded-full border px-3 py-1.5',
          tipoPedido
            ? 'border-border bg-surface'
            : 'border-accent bg-accent text-accent-ink',
        ]}>Todas</a
      >
      <a
        href="/alertas?tipo=dengue"
        data-filtro-tipo="dengue"
        aria-current={filtroDengue ? 'page' : undefined}
        class:list={[
          'rounded-full border px-3 py-1.5',
          filtroDengue
            ? 'border-accent bg-accent text-accent-ink'
            : 'border-border bg-surface',
        ]}>Dengue</a
      >
      <a
        href="/alertas?tipo=respiratorio"
        data-filtro-tipo="respiratorio"
        aria-current={filtroRespiratorio ? 'page' : undefined}
        class:list={[
          'rounded-full border px-3 py-1.5',
          filtroRespiratorio
            ? 'border-accent bg-accent text-accent-ink'
            : 'border-border bg-surface',
        ]}>Respiratorio</a
      >
      <a
        href="/alertas/archivo"
        class="rounded-full border border-border bg-surface px-3 py-1.5"
        >Archivo de alertas emitidas</a
      >
    </nav>

    <div
      class="mb-4 flex flex-wrap items-center justify-between gap-3 print:hidden"
    >
      <p
        data-sello-frescura
        class="font-sans text-xs text-ink-muted"
        role="status"
      >
      </p>
      <button
        type="button"
        data-imprimir
        class="rounded-full border border-border bg-surface px-4 py-1.5 font-sans text-sm font-medium text-ink transition-colors hover:border-accent/40"
      >
        Imprimir cartel
      </button>
    </div>

    <div data-alertas>
      <p
        data-alertas-carga
        class="font-sans text-sm text-ink-muted"
        role="status"
      >
        Cargando alertas…
      </p>
      <p
        data-alertas-error
        hidden
        class="rounded-lg border border-secondary bg-secondary/25 p-3 font-sans text-sm text-ink"
        role="status"
      >
        No se pudieron cargar las alertas.
      </p>
      <p
        data-alertas-vacio
        hidden
        class="rounded-2xl border border-border bg-surface p-5 font-sans text-sm leading-relaxed text-ink"
        role="status"
      >
        No hay alertas activas. Última revisión del equipo:
      </p>
      <div data-alertas-lista class="flex flex-col gap-4"></div>
    </div>
  </main>
</Layout>

<script>
  import {
    aplicarVistaAlertas,
    calcularNuevas,
    guardarAlertasVistas,
    leerAlertasVistas,
    type PayloadAlertas,
    type PintarAlertas,
  } from '../../lib/vista-alertas';

  const API_BASE = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000';
  const root = document.querySelector<HTMLElement>('[data-alertas]');

  document
    .querySelector<HTMLButtonElement>('[data-imprimir]')
    ?.addEventListener('click', () => window.print());

  // En papel no hay dónde hacer clic: los bloques clínicos se abren antes de
  // imprimir y se vuelven a plegar después. CSS no puede abrir un <details>.
  window.addEventListener('beforeprint', () => {
    document
      .querySelectorAll<HTMLDetailsElement>('[data-alerta-clinico]')
      .forEach((d) => {
        if (!d.open) d.dataset.plegadoAntesDeImprimir = '1';
        d.open = true;
      });
  });
  window.addEventListener('afterprint', () => {
    document
      .querySelectorAll<HTMLDetailsElement>('[data-alerta-clinico]')
      .forEach((d) => {
        if (d.dataset.plegadoAntesDeImprimir === '1') {
          d.open = false;
          delete d.dataset.plegadoAntesDeImprimir;
        }
      });
  });

  // Sello de frescura: sin él, una alerta servida desde el cache del service
  // worker (posiblemente ya apagada por el equipo) se ve idéntica a una
  // recién traída de la red. Eso tiene consecuencia clínica, no estética.
  const sello = document.querySelector<HTMLElement>('[data-sello-frescura]');
  function marcarFrescura(desdeCache: boolean): void {
    if (!sello) return;
    const ahora = new Date().toLocaleString('es-SV', {
      dateStyle: 'short',
      timeStyle: 'short',
    });
    sello.textContent = desdeCache
      ? `Sin conexión: mostrando lo último guardado en este dispositivo. Consultado el ${ahora}.`
      : `Datos cargados el ${ahora}.`;
    sello.setAttribute('data-desde-cache', desdeCache ? '1' : '0');
  }

  if (root) {
    const pintar: PintarAlertas = (payload) => {
      const vistas = leerAlertasVistas();
      const nuevas = calcularNuevas(payload.alertas, vistas);
      aplicarVistaAlertas(root, payload, nuevas);
      // Union, no reemplazo: payload.alertas viene filtrado por `tipo`. Con
      // reemplazo, entrar por /alertas?tipo=dengue borraría del historial las
      // respiratorias ya vistas y al volver a /alertas saldrían como "Nueva".
      guardarAlertasVistas([...vistas, ...payload.alertas.map((a) => a.id)]);
      // Ancla #alerta-<id> de un enlace compartido: las tarjetas se pintan
      // después de la carga, así que el salto nativo del navegador ya pasó.
      const ancla = window.location.hash.slice(1);
      if (ancla) document.getElementById(ancla)?.scrollIntoView();
    };
    (root as HTMLElement & { pintarAlertas?: PintarAlertas }).pintarAlertas =
      pintar;

    const tipoPedido = new URLSearchParams(window.location.search).get('tipo');
    const tipo =
      tipoPedido === 'dengue' || tipoPedido === 'respiratorio'
        ? tipoPedido
        : undefined;

    const activo = 'border-accent bg-accent text-accent-ink';
    const inactivo = 'border-border bg-surface';
    document
      .querySelectorAll<HTMLAnchorElement>('[data-filtro-tipo]')
      .forEach((el) => {
        const valor = el.getAttribute('data-filtro-tipo');
        const esActivo =
          (tipo === undefined && valor === 'todas') || valor === tipo;
        el.setAttribute('aria-current', esActivo ? 'page' : 'false');
        if (!esActivo) el.removeAttribute('aria-current');
        el.className = `rounded-full border px-3 py-1.5 ${esActivo ? activo : inactivo}`;
      });
    const url = tipo
      ? `${API_BASE}/api/alertas?tipo=${encodeURIComponent(tipo)}`
      : `${API_BASE}/api/alertas`;

    fetch(url)
      .then(async (respuesta) => {
        if (!respuesta.ok) {
          throw new Error(String(respuesta.status));
        }
        const datos: unknown = await respuesta.json();
        // El service worker marca lo servido desde su cache con `_desde_cache`
        // en el cuerpo (ver web/public/sw.js). Va en el cuerpo y no en una
        // cabecera porque la API es de otro origen y el navegador filtra por
        // CORS las cabeceras propias. El backend nunca emite este campo.
        marcarFrescura(
          typeof datos === 'object' &&
            datos !== null &&
            (datos as { _desde_cache?: boolean })._desde_cache === true,
        );
        if (
          !datos ||
          typeof datos !== 'object' ||
          !Array.isArray((datos as PayloadAlertas).alertas)
        ) {
          throw new Error('contrato');
        }
        pintar(datos as PayloadAlertas);
      })
      .catch(() => {
        const carga = root.querySelector<HTMLElement>('[data-alertas-carga]');
        const error = root.querySelector<HTMLElement>('[data-alertas-error]');
        if (carga) carga.hidden = true;
        if (error) error.hidden = false;
        if (sello) sello.textContent = '';
        root.setAttribute('data-cargado', '1');
        root.setAttribute('data-estado', 'error');
      });
  }
</script>

<style>
  /* Cartel imprimible: la hoja debe quedar legible pegada en sala de espera,
     sin navegación, filtros ni botones. Los bloques clínicos los abre el
     listener de beforeprint (CSS no puede abrir un details). */
  @media print {
    :global(header[class*='sticky']),
    :global(footer),
    nav[aria-label='Filtrar alertas por tipo'] {
      display: none !important;
    }
    :global([data-alerta]) {
      page-break-inside: avoid;
      border: 1px solid #999;
    }
  }
</style>
